{
  "lsp": {
    "buck2-lsp": {
      "binary": {
        "path": "bin/tine",
        "arguments": ["buck", "--isolation-dir", "lsp", "lsp"]
      }
    },
    "ruff": {
      "binary": {
        "path": "tools/ruff",
        "arguments": ["server"]
      }
    },
    "ty": {
      "binary": {
        "path": "tools/ty",
        "arguments": ["server"]
      },
      "settings": {
        "configurationFile": "${TINE_TY_CONFIG}"
      }
    }
  },
  "languages": {
    "Starlark": {
      "language_servers": ["buck2-lsp"]
    },
    "Python": {
      "language_servers": ["ty", "ruff"]
    }
  }
}
