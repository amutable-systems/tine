# The sandbox machinery (format-neutral): the chroot primitive every build action
# goes through. The format drivers that *run* inside an engine root bind it as
# their runtime. Lives in the cell so every consumer shares one sandbox. The
# per-distribution target graph is declared in the catalog cell (catalog//:, default
# tine/catalog), not here, so overriding `[cells] catalog` replaces the declaration too.

# Vendored mkosi-sandbox, kept in its own mkosi/ package so its provenance is
# obvious (mkosi/sandbox.py is theirs; sandbox.py is ours).
python_bootstrap_library(
    name = "mkosi",
    srcs = ["mkosi/__init__.py", "mkosi/sandbox.py"],
    visibility = ["PUBLIC"],
)

# Our launcher logic (build_argv, the clean base env, run()/cli()) over mkosi,
# imported by the per-format build driver. The sandbox binary below uses the same
# file as its main, so it depends only on :mkosi (not this library) to avoid a
# run-tree name collision between main and a dep source.
python_bootstrap_library(
    name = "sandbox_lib",
    srcs = ["sandbox.py"],
    deps = [":mkosi"],
    visibility = ["PUBLIC"],
)

# Generic chroot launcher used by the engine_root + assemble actions (runs
# sandbox.cli() via its __main__ guard).
python_bootstrap_binary(
    name = "sandbox",
    main = "sandbox.py",
    deps = [":mkosi"],
    visibility = ["PUBLIC"],
)

# The format-independent lock-refresh orchestrator. Runs on the host (stdlib only)
# and nests buck2 to drive each distribution's resolver in its own engine, then
# amalgamates the fragments. Run via `just refresh-catalog`.
python_bootstrap_binary(
    name = "buckify",
    main = "buckify.py",
    visibility = ["PUBLIC"],
)
