"""The axis an image's distribution is selected on."""

load("@prelude//:rules.bzl", "constraint_setting", "constraint_value")
load("//box:defs.bzl", "box")
load(":defs.bzl", "FAMILIES", "distribution")

constraint_setting(
    name = "distribution",
    visibility = ["PUBLIC"],
)

# Distributions of one family name their packages alike, so a package list selects on the family.
constraint_setting(
    name = "family",
    visibility = ["PUBLIC"],
)

[
    constraint_value(
        name = family,
        constraint_setting = ":family",
        visibility = ["PUBLIC"],
    )
    for family in FAMILIES
]

# No platform ever carries this value, so requiring it is how a target says it cannot be built.
# It exists to be named in an error: an image asks for it wherever no distribution has been chosen,
# and buck then reports that by name rather than by whichever distribution it checked first.
constraint_setting(name = "choice")

constraint_value(
    name = "no-distribution-chosen",
    constraint_setting = ":choice",
    visibility = ["PUBLIC"],
)

# The test runs once per release of the catalog. Buck picks a release's key over its family's key, and
# `DEFAULT` applies to a release whose family has no key. The expected value comes from a plain
# select() on the three releases. Only one of its keys matches in any configuration, so the expected
# value doesn't depend on which key wins.
box.sh_test(
    name = "select-test",
    box = "//tools:dev.box",
    script = '[[ "$1" == "$2" ]]',
    args = [
        distribution.select({
            "DEFAULT": "default",
            "debian": "family",
            "fedora": "family",
            "fedora.rawhide": "release",
        }),
        select({
            "catalog//:arch.rolling.distribution": "default",
            "catalog//:debian.testing.distribution": "family",
            "catalog//:fedora.rawhide.distribution": "release",
        }),
    ],
    **distribution.distributed("select-test"),
)
