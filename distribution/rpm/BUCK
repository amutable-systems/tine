load("//defs/rules:distribution.bzl", "driver", "package_format")

# The rpm-format drivers (sources beside this file: extract/install/createrepo/
# plan/build/buckify.py). They run under the pinned host python3 (extract) or
# inside an engine root provisioned by the consumer (the rest). Bare `//` here
# resolves to the tine cell (the cell of this BUCK), so the cell self-references
# without qualification.

# The bootstrap ur-tool: payload-extracts the seed rpms to stand up the first
# chroot. stdlib only, run by host python3 — not a chroot tool, so not per-engine.
python_bootstrap_binary(
    name = "extract",
    main = "extract.py",
    visibility = ["PUBLIC"],
)

# The chroot-run drivers, each a DriverInfo a consumer binds to an engine (at the fixed
# assembly epoch, so assembly output is reproducible). build pulls in the sandbox
# launcher for its nested rpmbuild chroot.
driver(name = "install", main = "install.py")
driver(name = "createrepo", main = "createrepo.py")
driver(name = "plan", main = "plan.py")
driver(name = "build", main = "build.py", deps = ["//distribution:sandbox_lib"])

# The rpm package format plugin: the build drivers, selected generically as
# `@tine//distribution/rpm:package_format` by the orchestration layer (per a
# distribution's `package_format`). The distribution + repo bind them to run in an engine root.
package_format(
    name = "package_format",
    extract = ":extract",
    install = ":install",
    createrepo = ":createrepo",
    plan = ":plan",
    build = ":build",
    visibility = ["PUBLIC"],
)

# The lock generator's source, exported so a consumer can bind it to *their* engine
# root as a `chroot_python_binary` (network = True: it fetches repodata). It's
# consumer-data-driven (needs the consumer's engine root), so the runnable is
# declared on the consumer side; the cell only owns the source.
export_file(
    name = "buckify.py",
    visibility = ["PUBLIC"],
)
