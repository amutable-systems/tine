"""The rpm package-format plugin: the per-format drivers + their `package_format` bundle."""

load("//defs/rules:package_format.bzl", "package_format")

# The rpm-format drivers (sources beside this file: extract/install/createrepo/
# plan/build/buckify.py). They run under the pinned host python3 (extract) or
# inside an engine root provisioned by the consumer (the rest). Bare `//` here
# resolves to the tine cell (the cell of this BUCK), so the cell self-references
# without qualification.

# The bootstrap ur-tool: payload-extracts the seed rpms to stand up the first
# chroot. stdlib only, run by host python3 — not a chroot tool, so not per-engine.
python_bootstrap_binary(
    name = "extract",
    main = "extract.py",
    visibility = ["PUBLIC"],
)

python_bootstrap_binary(name = "install", main = "install.py", deps = ["//distribution:rootfs_lib"])
python_bootstrap_binary(name = "createrepo", main = "createrepo.py")
python_bootstrap_binary(name = "plan", main = "plan.py")
python_bootstrap_binary(name = "build", main = "build.py", deps = ["//distribution:sandbox_lib"])

# The rpm package format plugin: the build drivers, selected generically as
# `@tine//distribution/rpm:package_format` by the orchestration layer (per a
# distribution's `package_format`). The distribution + repo bind them to run in an engine root.
package_format(
    name = "package_format",
    extract = ":extract",
    install = ":install",
    createrepo = ":createrepo",
    plan = ":plan",
    build = ":build",
    visibility = ["PUBLIC"],
)

# The lock generator, public so a consumer can bind it to *their* engine root (a
# command_alias over the engine's RunInfo). It's consumer-data-driven (needs the
# consumer's engine root), so the runnable is declared on the consumer side; the cell
# only owns the driver.
python_bootstrap_binary(
    name = "buckify",
    main = "buckify.py",
    visibility = ["PUBLIC"],
)
