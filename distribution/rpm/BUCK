"""The rpm package-format plugin: the per-format drivers + their `package_format` bundle."""

load("//defs/rules:package_format.bzl", "package_format")

# Host tools bootstrap the engine; remaining drivers run inside it.

# Stdlib-only RPM framing and payload decompression.
python_bootstrap_library(name = "rpmfile_lib", srcs = ["rpmfile.py"])

# Bootstrap extractor; capture escapes names Buck cannot store.
python_bootstrap_binary(
    name = "extract",
    main = "extract.py",
    deps = ["//distribution:cpio_lib", "//distribution:rootfs_lib", ":rpmfile_lib"],
    visibility = ["PUBLIC"],
)

# Repository-owned raw-RPM to cpio transform.
python_bootstrap_binary(
    name = "decompress",
    main = "decompress.py",
    deps = [":rpmfile_lib"],
    visibility = ["PUBLIC"],
)

# Stdlib-only driver helpers.
python_bootstrap_library(name = "util", srcs = ["util.py"])

python_bootstrap_binary(name = "install", main = "install.py", deps = ["//distribution:rootfs_lib"])
python_bootstrap_binary(name = "createrepo", main = "createrepo.py")

# Planner also creates solver caches and refreshes engine locks.
python_bootstrap_binary(name = "plan", main = "plan.py", deps = ["//distribution:rootfs_lib"])
python_bootstrap_binary(name = "build", main = "build.py", deps = [":util", "//distribution:rootfs_lib"])

# Host-side repository snapshot generator.
python_bootstrap_binary(
    name = "snapshot",
    main = "snapshot.py",
    visibility = ["PUBLIC"],
)

# Generic package-format bundle for the RPM drivers.
package_format(
    name = "package_format",
    extract = ":extract",
    snapshot = ":snapshot",
    install = ":install",
    create_repository = ":createrepo",
    plan = ":plan",
    build = ":build",
    visibility = ["PUBLIC"],
)
