"""Check that every target a cell declares loads, configures, and analyzes.

A build only reaches the targets it was asked for, so a rule that fails during analysis ships
unnoticed until something finally names it. Analyzing the whole graph catches that without
producing a single artifact, which is what makes it cheap enough to run beside the linters rather
than as a second build.

Incompatible targets are skipped rather than failed: a target that requires a distribution nobody
chose is not buildable here by design, and the per-distribution aliases beside it are analyzed
instead, which reaches the same rules through the transition that configures them.

This stops at analysis, so it does not cover what a dynamic action's implementation does with the
values it reads back. Only building reaches those.
"""

def _impl(ctx: bxl.Context) -> None:
    pattern = ctx.cli_args.pattern
    targets = ctx.uquery().eval(pattern)
    ctx.output.print("{}: {} targets load".format(pattern, len(targets)))

    configured = ctx.configured_targets(targets)
    skipped = len(targets) - len(configured)
    ctx.output.print("{} configure, {} skipped as incompatible".format(len(configured), skipped))

    ctx.analysis(configured)
    ctx.output.print("{} analyze".format(len(configured)))

analyze = bxl_main(
    impl = _impl,
    cli_args = {
        "pattern": cli_args.string(default = "tine//..."),
    },
)
