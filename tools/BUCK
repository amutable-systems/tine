"""Pinned tool binaries + the dev commands (buck-fetched http_tools; DotSlash bootstrap)."""

load(":defs.bzl", "http_tool")

# buck stays a DotSlash descriptor in this directory (invoked by bare name via
# PATH): it must work before buck can build anything. Everything else is pinned
# below and downloaded + sha256-verified by buck itself on first use: python3
# backs the python_bootstrap toolchain; buildifier/ruff/ty feed the check and fmt
# commands at the bottom (`buck run tine//tools:<check|fmt|refresh-catalog|
# verify-catalog>`), which get the tool paths via `$(location …)` and run them
# against the working tree (ruff/ty walk the cell root; buildifier takes the
# graph-derived starlark set from `uquery allbuildfiles`); the catalog commands
# alias buckify directly.

# Bootstrap interpreter for the build-time Python tools (rpm_extract, sandbox,
# build_rpm), from astral-sh/python-build-standalone (relocatable CPython — no
# host Python needed). The bootstrap requires >= 3.14 for stdlib compression.zstd
# (Fedora rpm payloads are zstd); this build also carries lzma/zlib/sqlite3 used
# by rpm_extract and the parkdb replication.
http_tool(
    name = "python3",
    path = "bin/python3",
    platforms = {
        "aarch64": {
            "sha256": "93af46aac9d7c210b4842ab2813a2ac6e0af60d2550b3ca5f761f2e0f5e18b64",
            "strip_prefix": "python",
            "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20260623/cpython-3.14.6+20260623-aarch64-unknown-linux-gnu-install_only.tar.gz",
        },
        "x86_64": {
            "sha256": "3d943d8b4360823959012d7e9f4c755256ac1e9c04b609c24894a1b480736e36",
            "strip_prefix": "python",
            "url": "https://github.com/astral-sh/python-build-standalone/releases/download/20260623/cpython-3.14.6+20260623-x86_64-unknown-linux-gnu-install_only.tar.gz",
        },
    },
    visibility = ["PUBLIC"],
)

# Starlark/BUCK formatter + linter. The release artifacts are raw static Go
# binaries (no archive, so no `path`).
http_tool(
    name = "buildifier",
    platforms = {
        "aarch64": {
            "sha256": "947bf6700d708026b2057b09bea09abbc3cafc15d9ecea35bb3885c4b09ccd04",
            "url": "https://github.com/bazelbuild/buildtools/releases/download/v8.5.1/buildifier-linux-arm64",
        },
        "x86_64": {
            "sha256": "887377fc64d23a850f4d18a077b5db05b19913f4b99b270d193f3c7334b5a9a7",
            "url": "https://github.com/bazelbuild/buildtools/releases/download/v8.5.1/buildifier-linux-amd64",
        },
    },
)

