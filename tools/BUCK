# SBOM generator (static release binary; not packaged in Fedora). Scans an image tree for the
# rpmdb, ELF-bundled modules, etc. Used by the image_sbom rule against an assembled image.
http_tool(
    name = "syft",
    path = "syft",
    platforms = {
        "aarch64": {
            "sha256": "6865a3d97c4e28b4b38571c17a2bf512da4494ef1d37613c3122fce0d67e63b0",
            "url": "https://github.com/anchore/syft/releases/download/v1.48.0/syft_1.48.0_linux_arm64.tar.gz",
        },
        "x86_64": {
            "sha256": "6cef9a7f37220d9067eaf9cfaaa2fce986e9f320a8d42cbc36658c99af78ea04",
            "url": "https://github.com/anchore/syft/releases/download/v1.48.0/syft_1.48.0_linux_amd64.tar.gz",
        },
    },
    visibility = ["PUBLIC"],
)

# Runtime driver for the source-tree commands below.
python_bootstrap_binary(
    name = "dev",
    main = "dev.py",
)

python_bootstrap_binary(
    name = "catalog",
    main = "catalog.py",
)

python_bootstrap_binary(
    name = "bump-driver",
    main = "bump.py",
    deps = ["//:util"],
)

command_alias(
    name = "bump",
    args = ["--data", "$(source buck.json)"],
    exe = ":bump-driver",
)

# Source lints; ty resolves imports against the engine root.
# FIXME: type check python in every engine? Some python dependencies will only be
# available in certain engines.
command_alias(
    name = "lint",
    args = [
        "lint",
        "--buck",
        "$(source buck)",
        "--buildifier",
        "$(location :buildifier)",
        "--ruff",
        "$(location :ruff)",
        "--ty",
        "$(location :ty)",
        "--engine",
        "$(location tine//catalog:fedora.rawhide.engine)",
    ],
    exe = ":dev",
)

# check = lint + the unit tests: the resource dependency builds (runs) tine//tests:unit-test.
command_alias(
    name = "check",
    exe = ":lint",
    resources = ["tine//tests:unit-test"],
)

# The rpm importer (see docs/packages.md): its verbs need the pinned rpm toolchain plus the
# host's git identity, network, and cwd, so it runs through the dev box's relaxed entry.
command_alias(
    name = "importer",
    args = ["$(source importer)"],
    exe = "tine//box:dev",
)

# The importer sources for the unit-test tree (tine//tests:unit-test).
export_file(
    name = "importer-src",
    src = "importer",
    visibility = ["tine//tests:unit-test"],
)

# BuildRequires cycle analysis of a branch (pass its label, e.g. //packages/fedora:rawhide's dir).
command_alias(
    name = "scc",
    args = [
        "scc",
        "--buck",
        "$(source buck)",
    ],
    exe = ":dev",
)

command_alias(
    name = "fmt",
    args = [
        "fmt",
        "--buck",
        "$(source buck)",
        "--buildifier",
        "$(location :buildifier)",
        "--ruff",
        "$(location :ruff)",
    ],
    exe = ":dev",
)

command_alias(
    name = "ty-engine",
    args = [
        "ty",
        "--engine",
        "$(location tine//catalog:fedora.rawhide.engine)",
        "--ty",
        "$(location :ty)",
    ],
    exe = ":dev",
)

# The catalog tool resolves the default catalog package and project root itself.
command_alias(
    name = "refresh-catalog",
    args = [
        "--buck",
        "$(source buck)",
    ],
    exe = ":catalog",
)

command_alias(
    name = "verify-catalog",
    args = [
        "--verify",
        "--buck",
        "$(source buck)",
    ],
    exe = ":catalog",
)
