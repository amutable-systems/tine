# Python type checker (static musl builds).
http_tool(
    name = "ty",
    path = "ty",
    platforms = {
        "aarch64": {
            "sha256": "a66df5fe96dd54c7232fd46d51adb2f6f6f3f1b62e3421c9b0f9e0d6eebb9d1a",
            "strip_prefix": "ty-aarch64-unknown-linux-musl",
            "url": "https://github.com/astral-sh/ty/releases/download/0.0.52/ty-aarch64-unknown-linux-musl.tar.gz",
        },
        "x86_64": {
            "sha256": "2cce40f34e3996fd638406fce25f39f7dbb0098319a2300605cdf9035b39be76",
            "strip_prefix": "ty-x86_64-unknown-linux-musl",
            "url": "https://github.com/astral-sh/ty/releases/download/0.0.52/ty-x86_64-unknown-linux-musl.tar.gz",
