"""Pinned tool binaries and development commands fetched by Buck."""

load(":defs.bzl", "http_tool")
load(":tools.json", _pins = "value")

# The shell bootstrap fetches Buck; Buck then fetches and verifies the remaining tools. Their pinned
# releases live in ./tools.json and are refreshed by `bump` (see docs/images.md).

# Relocatable bootstrap Python; 3.14 provides stdlib zstd for RPM payloads.
# PUBLIC, not just `toolchains//:python_bootstrap`: a consuming project owns its own toolchains cell
# (Buck2 forbids nested cells inside an external cell), so the consumer is a different label.
http_tool(
    name = "python3",
    args = ["-B"],
    path = "bin/python3",
    spec = _pins["python3"],
    visibility = ["PUBLIC"],
)

# Starlark formatter, published as a bare zstd-compressed binary alongside Buck itself; keep its pin
# in step with buck2's so both come from the same release.
http_tool(
    name = "starlark-fmt",
    compressed = True,
    spec = _pins["starlark-fmt"],
)

# Decompressor for the above; the pinned CPython is new enough to have zstd in its standard library.
python_bootstrap_binary(
    name = "unzstd",
    main = "unzstd.py",
)

# Python formatter + linter (static musl builds).
http_tool(
    name = "ruff",
    path = "ruff",
    spec = _pins["ruff"],
)

# Python type checker (static musl builds).
http_tool(
    name = "ty",
    path = "ty",
    spec = _pins["ty"],
)

# SBOM generator (static release binary; not packaged in Fedora). Scans an assembled image tree for the
# package database, ELF-bundled modules, and other package metadata.
http_tool(
    name = "syft",
    path = "syft",
    spec = _pins["syft"],
    visibility = ["PUBLIC"],
)

# Runtime driver for the source-tree commands below.
python_bootstrap_binary(
    name = "dev",
    main = "dev.py",
)

python_bootstrap_binary(
    name = "catalog",
    main = "catalog.py",
    deps = ["//:util"],
)

python_bootstrap_binary(
    name = "bump-driver",
    main = "bump.py",
    deps = ["//:util"],
)

# Git-derived image version provider; runs on the host against the caller's repository and
# prints the version to inject as `-c tine.image-version=...`.
python_bootstrap_binary(
    name = "version",
    main = "version.py",
    visibility = ["PUBLIC"],
)

# The version tool source for the unit-test tree (tine//tests:unit-test).
export_file(
    name = "version-src",
    src = "version.py",
    visibility = ["tine//tests:unit-test"],
)

command_alias(
    name = "bump",
    args = ["--data", "$(source tools.json)"],
    exe = ":bump-driver",
)

# Source lints; ty resolves imports against the engine root.
# FIXME: type check python in every engine? Some python dependencies will only be
# available in certain engines.
command_alias(
    name = "lint",
    args = [
        "lint",
        "--buck",
        "$(source buck)",
        "--starlark-fmt",
        "$(location :starlark-fmt)",
        "--starlark-fmt-config",
        "$(source starlark-fmt.json)",
        "--ruff",
        "$(location :ruff)",
        "--ty",
        "$(location :ty)",
        "--engine",
        "$(location tine//catalog:fedora.rawhide.engine)",
    ],
    exe = ":dev",
)

# check = lint + the unit tests: the resource dependency builds (runs) tine//tests:unit-test.
command_alias(
    name = "check",
    exe = ":lint",
    resources = ["tine//tests:unit-test"],
)

# The rpm importer (see docs/importer.md): its verbs need the pinned rpm toolchain plus the
# host's git identity, network, and cwd, so it runs through the dev box's relaxed entry.
command_alias(
    name = "importer",
    args = ["$(source importer)"],
    exe = "tine//box:dev",
)

# The importer sources for the unit-test tree (tine//tests:unit-test).
export_file(
    name = "importer-src",
    src = "importer",
    visibility = ["tine//tests:unit-test"],
)

# BuildRequires cycle analysis of a branch (pass its label, e.g. //packages/fedora:rawhide's dir).
command_alias(
    name = "scc",
    args = [
        "scc",
        "--buck",
        "$(source buck)",
    ],
    exe = ":dev",
)

command_alias(
    name = "fmt",
    args = [
        "fmt",
        "--buck",
        "$(source buck)",
        "--starlark-fmt",
        "$(location :starlark-fmt)",
        "--starlark-fmt-config",
        "$(source starlark-fmt.json)",
        "--ruff",
        "$(location :ruff)",
    ],
    exe = ":dev",
)

command_alias(
    name = "ty-engine",
    args = [
        "ty",
        "--engine",
        "$(location tine//catalog:fedora.rawhide.engine)",
        "--ty",
        "$(location :ty)",
    ],
    exe = ":dev",
)

# The catalog tool resolves the default catalog package and project root itself.
command_alias(
    name = "refresh-catalog",
    args = [
        "--buck",
        "$(source buck)",
    ],
    exe = ":catalog",
)

command_alias(
    name = "verify-catalog",
    args = [
        "--verify",
        "--buck",
        "$(source buck)",
    ],
    exe = ":catalog",
)
