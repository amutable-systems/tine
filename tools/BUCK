"""Pinned tool binaries and development commands fetched by Buck."""

load("//box:build.bzl", "box")
load("//box:test.bzl", "box_python_test")
load(":defs.bzl", "http_tool")
load(":tools.json", _pins = "value")

_RELEASE = "tine//catalog:fedora.rawhide.release"
_RESOLVER_BOX = "tine//catalog:fedora.rawhide.box"

# The shell bootstrap fetches Buck; Buck then fetches and verifies the remaining tools. Their pinned
# releases live in ./tools.json and are refreshed by `bump` (see docs/images.md).

# Relocatable bootstrap Python; 3.14 provides stdlib zstd for RPM payloads.
# PUBLIC, not just `toolchains//:python_bootstrap`: a consuming project owns its own toolchains cell
# (Buck2 forbids nested cells inside an external cell), so the consumer is a different label.
http_tool(
    name = "python3",
    args = ["-B"],
    path = "bin/python3",
    spec = _pins["python3"],
    visibility = ["PUBLIC"],
)

# Starlark formatter, published as a bare zstd-compressed binary alongside Buck itself; keep its pin
# in step with buck2's so both come from the same release.
http_tool(
    name = "starlark-fmt",
    compressed = True,
    spec = _pins["starlark-fmt"],
)

# Decompressor for the above; the pinned CPython is new enough to have zstd in its standard library.
python_bootstrap_binary(
    name = "unzstd",
    main = "unzstd.py",
)

# Python formatter + linter (static musl builds).
http_tool(
    name = "ruff",
    path = "ruff",
    spec = _pins["ruff"],
)

# Python type checker (static musl builds).
http_tool(
    name = "ty",
    path = "ty",
    spec = _pins["ty"],
)

# SBOM generator (static release binary; not packaged in Fedora). Scans an assembled image tree for the
# package database, ELF-bundled modules, and other package metadata.
http_tool(
    name = "syft",
    path = "syft",
    spec = _pins["syft"],
    visibility = ["PUBLIC"],
)

# Cargo wrapper that embeds the crate graph in every binary it builds, so SBOM scanners can report
# what a from-source Rust binary contains. Fedora does not package it, and we
# can't build it from source yet. https://crates.io/crates/cargo-auditable
http_tool(
    name = "cargo-auditable",
    path = "cargo-auditable",
    spec = _pins["cargo-auditable"],
    visibility = ["PUBLIC"],
)

# tine's dev environment for importer and its unit tests. Used by every `box_python_test` suite
# (hermetic), `tine//tools:importer` (relaxed), and anyone entering it as a box.
# Derived from the main box (lockless transaction, resolved during the build), so dev tooling
# changes never invalidate the build graph that depends on the main box.
box(
    name = "dev.box",
    packages = [
        "coreutils",
        # for "importer srpm"
        "dist-git-client",
        "gawk",
        "git-core",
        "python3",
        "rpm-build",
        "sed",
    ],
    release = _RELEASE,
    resolver_box = _RESOLVER_BOX,
    visibility = ["PUBLIC"],
)

# Runtime driver for the source-tree commands below.
python_bootstrap_binary(
    name = "dev",
    main = "dev.py",
)

python_bootstrap_binary(
    name = "catalog",
    main = "catalog.py",
    deps = ["//:util"],
)

python_bootstrap_binary(
    name = "bump-driver",
    main = "bump.py",
    deps = ["//:util"],
)

# Git-derived image version provider; runs on the host against the caller's repository and
# prints the version to inject as `-c tine.image-version=...`.
python_bootstrap_binary(
    name = "version",
    main = "version.py",
    visibility = ["PUBLIC"],
)

box_python_test(
    name = "version-test",
    box = ":dev.box",
    srcs = [
        "version.py",
        "version_test.py",
    ],
)

command_alias(
    name = "bump",
    args = ["--data", "$(source tools.json)"],
    exe = ":bump-driver",
)

# ty resolves imports against the box root.
# FIXME: type check python in every box? Some python dependencies will only be
# available in certain boxes.
_SOURCE_ARGS = [
    "--buck",
    "$(source buck)",
    "--starlark-fmt",
    "$(location :starlark-fmt)",
    "--starlark-fmt-config",
    "$(source starlark-fmt.json)",
    "--ruff",
    "$(location :ruff)",
    "--ty",
    "$(location :ty)",
    "--box",
    "$(location tine//catalog:fedora.rawhide.box)",
]

command_alias(
    name = "lint",
    args = ["lint"] + _SOURCE_ARGS,
    exe = ":dev",
)

# check = lint + `buck test tine//...`. The suites are test targets, not build artifacts, so they
# cannot come in as `resources`; the driver nests the test run instead.
command_alias(
    name = "check",
    args = ["check"] + _SOURCE_ARGS,
    exe = ":dev",
)

# The rpm importer (see docs/importer.md): its verbs need the pinned rpm toolchain plus the
# host's git identity, network, and cwd, so it runs through the dev box's relaxed entry.
command_alias(
    name = "importer",
    args = ["$(source importer)"],
    exe = ":dev.box",
)

# PKCS#11 signing tokens for testing (ci.sh's secureboot-pkcs11 step): a software TPM, the
# production tpm2-pkcs11 module on top, and the p11-kit server exposing its tokens to build
# sandboxes over a socket. See tools/signing-server.
box(
    name = "swtpm-signing.box",
    packages = [
        "bash",
        "coreutils",
        # the resource manager swtpm lacks, and the private bus it needs; see tools/signing-server
        "dbus-daemon",
        "openssl",
        "p11-kit-server",
        "pkcs11-provider",
        "swtpm",
        # ukify, to read a UKI section back out in the ci.sh step
        "systemd-ukify",
        "tpm2-abrmd",
        "tpm2-pkcs11",
        "tpm2-pkcs11-tools",
        # tpm2_ptool drives these binaries without a package dependency on them
        "tpm2-tools",
    ],
    release = _RELEASE,
    resolver_box = _RESOLVER_BOX,
    visibility = ["PUBLIC"],
)

command_alias(
    name = "signing-server",
    args = ["$(source signing-server)"],
    exe = ":swtpm-signing.box",
)

box_python_test(
    name = "importer-test",
    box = ":dev.box",
    srcs = [
        "importer",
        "importer_test.py",
    ],
)

# BuildRequires cycle analysis of a branch (pass its label, e.g. //packages/fedora:rawhide's dir).
command_alias(
    name = "scc",
    args = [
        "scc",
        "--buck",
        "$(source buck)",
    ],
    exe = ":dev",
)

command_alias(
    name = "fmt",
    args = [
        "fmt",
        "--buck",
        "$(source buck)",
        "--starlark-fmt",
        "$(location :starlark-fmt)",
        "--starlark-fmt-config",
        "$(source starlark-fmt.json)",
        "--ruff",
        "$(location :ruff)",
    ],
    exe = ":dev",
)

command_alias(
    name = "ty-box",
    args = [
        "ty",
        "--box",
        "$(location tine//catalog:fedora.rawhide.box)",
        "--ty",
        "$(location :ty)",
    ],
    exe = ":dev",
)

# The catalog tool resolves the default catalog package and project root itself.
command_alias(
    name = "refresh-catalog",
    args = [
        "--buck",
        "$(source buck)",
    ],
    exe = ":catalog",
)

command_alias(
    name = "verify-catalog",
    args = [
        "--verify",
        "--buck",
        "$(source buck)",
    ],
    exe = ":catalog",
)
