# The driver for the commands that need runtime input prep (see dev.py's docstring).
# Each command below is `buck run`-able: buck first builds the pinned tools it
# references, then dev.py drives them against the source tree (cwd-independent).
python_bootstrap_binary(
    name = "dev",
    main = "dev.py",
)

# check = every source check: fmt's surface in check mode, plus ty and buck's starlark
# lint/typecheck subcommands. Buck builds the tools and ty's engine root (the pinned
# environment the drivers actually run in) up front via `$(location …)`; dev.py then
# runs them against the working tree (`uquery allbuildfiles` supplies the starlark
# file set).
# FIXME: type check python in every engine? Some python dependencies will only be
# available in certain engines.
command_alias(
    name = "check",
    args = [
        "check",
        "--buck",
        "$(source buck)",
        "--buildifier",
        "$(location :buildifier)",
        "--ruff",
        "$(location :ruff)",
        "--ty",
        "$(location :ty)",
        "--engine",
        "$(location catalog//:fedora44.engine)",
    ],
    exe = ":dev",
)

command_alias(
    name = "fmt",
    args = [
        "fmt",
        "--buck",
        "$(source buck)",
        "--buildifier",
        "$(location :buildifier)",
        "--ruff",
        "$(location :ruff)",
    ],
    exe = ":dev",
)

# The catalog commands need no driver: buckify resolves its own defaults (the active
# catalog cell, the project root), so the aliases point straight at it.
command_alias(
    name = "refresh-catalog",
    args = [
        "--buck",
        "$(source buck)",
    ],
    exe = "//distribution:buckify",
)

command_alias(
    name = "verify-catalog",
    args = [
        "--verify",
        "--buck",
        "$(source buck)",
    ],
    exe = "//distribution:buckify",
)
