#!/bin/sh
set -eu

# Pinned daandemeyer/buck2 release carrying tine's pending Buck fixes.
release=2026-07-06-22.30.19
base_url=https://github.com/daandemeyer/buck2/releases/download/$release

case "$(uname -s)-$(uname -m)" in
    Linux-aarch64 | Linux-arm64)
        artifact=buck2-aarch64-unknown-linux-musl.zst
        sha256=ea6a71c6505310eafd4d7825ea4c5dfd2f09d9549a6e813cac3900214c961b8c
        ;;
    Linux-riscv64)
        artifact=buck2-riscv64gc-unknown-linux-gnu.zst
        sha256=9a25a054b665cd981948bfc9196fc47cbaf39998d01a51656bd5d0cb808bcf4d
        ;;
    Linux-x86_64 | Linux-amd64)
        artifact=buck2-x86_64-unknown-linux-musl.zst
        sha256=dd5423ba3086b44da85a16473c1658017b9f428172c151039c98fbcdc66a0453
        ;;
    *)
        printf 'buck bootstrap: unsupported platform: %s\n' "$(uname -s)-$(uname -m)" >&2
        exit 1
        ;;
esac

cache_home=${XDG_CACHE_HOME:-${HOME:?HOME must be set when XDG_CACHE_HOME is not set}/.cache}
cache_dir=$cache_home/tine/buck2/$sha256
buck=$cache_dir/buck2

if [ ! -x "$buck" ]; then
    for tool in curl sha256sum zstd; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            printf 'buck bootstrap: required tool not found: %s\n' "$tool" >&2
            exit 1
        fi
    done

    mkdir -p "$cache_dir"
    archive=$(mktemp "$cache_dir/.buck2.zst.XXXXXX")
    binary=$(mktemp "$cache_dir/.buck2.XXXXXX")

    cleanup() {
        rm -f "$archive" "$binary"
    }
    trap cleanup EXIT HUP INT TERM

    printf 'Downloading Buck2 %s for %s...\n' "$release" "$(uname -m)" >&2
    curl \
        --fail \
        --location \
        --output "$archive" \
        --proto '=https' \
        --retry 3 \
        --show-error \
        --silent \
        --tlsv1.2 \
        "$base_url/$artifact"

    actual=$(sha256sum "$archive")
    actual=${actual%% *}
    if [ "$actual" != "$sha256" ]; then
        printf 'buck bootstrap: SHA-256 mismatch for %s\n' "$artifact" >&2
        exit 1
    fi

    zstd --decompress --force --quiet "$archive" -o "$binary"
    chmod 755 "$binary"
    mv -f "$binary" "$buck"

    trap - EXIT HUP INT TERM
    rm -f "$archive"
fi

exec "$buck" "$@"
