#!/bin/sh
set -eu

fail() {
    printf 'buck bootstrap: %s\n' "$1" >&2
    exit 1
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
data=$script_dir/buck.json

if ! command -v jq >/dev/null 2>&1; then
    fail "required tool not found: jq"
fi

case "$(uname -s)-$(uname -m)" in
    Linux-aarch64 | Linux-arm64)
        platform=Linux-aarch64
        ;;
    Linux-riscv64)
        platform=Linux-riscv64
        ;;
    Linux-x86_64 | Linux-amd64)
        platform=Linux-x86_64
        ;;
    *)
        fail "unsupported platform: $(uname -s)-$(uname -m)"
        ;;
esac

repository=$(jq -er '.repository | strings | select(length > 0)' "$data")
release=$(jq -er '.release | strings | select(length > 0)' "$data")
artifact=$(
    jq -er --arg platform "$platform" \
        '.platforms[$platform].artifact | strings | select(length > 0)' "$data"
)
sha256=$(
    jq -er --arg platform "$platform" \
        '.platforms[$platform].sha256 | strings | select(length > 0)' "$data"
)

case "$sha256" in
    *[!0-9a-f]* | '') fail "invalid SHA-256 for $platform in $data" ;;
esac
if [ "${#sha256}" -ne 64 ]; then
    fail "invalid SHA-256 for $platform in $data"
fi

base_url=https://github.com/$repository/releases/download/$release
cache_home=${XDG_CACHE_HOME:-${HOME:?HOME must be set when XDG_CACHE_HOME is not set}/.cache}
cache_dir=$cache_home/tine/buck2/$sha256
buck=$cache_dir/buck2

if [ ! -x "$buck" ]; then
    for tool in curl sha256sum zstd; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            printf 'buck bootstrap: required tool not found: %s\n' "$tool" >&2
            exit 1
        fi
    done

    mkdir -p "$cache_dir"
    archive=$(mktemp "$cache_dir/.buck2.zst.XXXXXX")
    binary=$(mktemp "$cache_dir/.buck2.XXXXXX")

    cleanup() {
        rm -f "$archive" "$binary"
    }
    trap cleanup EXIT HUP INT TERM

    printf 'Downloading Buck2 %s for %s...\n' "$release" "$(uname -m)" >&2
    curl \
        --fail \
        --location \
        --output "$archive" \
        --proto '=https' \
        --retry 3 \
        --show-error \
        --silent \
        --tlsv1.2 \
        "$base_url/$artifact"

    actual=$(sha256sum "$archive")
    actual=${actual%% *}
    if [ "$actual" != "$sha256" ]; then
        printf 'buck bootstrap: SHA-256 mismatch for %s\n' "$artifact" >&2
        exit 1
    fi

    zstd --decompress --force --quiet "$archive" -o "$binary"
    chmod 755 "$binary"
    mv -f "$binary" "$buck"

    trap - EXIT HUP INT TERM
    rm -f "$archive"
fi

exec "$buck" "$@"
