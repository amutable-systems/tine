# Standalone root cell. Consuming projects supply their own; see README.md.

[cells]
# Named `tine`, not `root`, so same-cell labels match those in a consuming project. This must be the
# cell's real name rather than an alias because labels retain the name of the cell they resolve to.
tine = .
prelude = prelude
none = none

[cell_aliases]
config = prelude
# Keep the toolchain attached to the tine cell when a project points that cell at this checkout.
toolchains = tine
# Satisfy the bundled prelude's internal platform alias.
fbsource = none

[external_cells]
prelude = bundled

[parser]
target_platform_detector_spec = target:tine//...->prelude//platforms:default

[build]
execution_platforms = prelude//platforms:default

[project]
# VCS state, dependency and build trees, image outputs, and caches tools keep must not invalidate
# Buck's file watcher. Only names reserved for generated state are safe to ignore: `build`, `dist`,
# and `out` are ordinary package names, and ignoring one would hide its targets rather than only its churn.
ignore = .git, .jj, **/.git, **/.jj, **/.hg, **/.svn, .buck, **/.buck, \
    **/buck-out, **/target, **/node_modules, **/__pycache__, **/.venv, **/venv, \
    **/.cache, **/.direnv, **/.gradle, **/.tox, **/.nox, \
    **/.mypy_cache, **/.pytest_cache, **/.ruff_cache, \
    **/.next, **/.parcel-cache, **/.turbo, **/.idea, **/.vscode, \
    **/mkosi.cache, **/mkosi.pkgcache, **/mkosi.builddir, **/mkosi.output, \
    **/mkosi.tools, **/mkosi.tools.build.cache, **/mkosi.tools.manifest, **/.mkosi-private

[buck2]
materializations = deferred
sqlite_materializer_state = true
defer_write_actions = true
