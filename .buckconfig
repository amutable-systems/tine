# Standalone root cell. Consuming projects supply their own; see README.md.

[cells]
# Named `tine`, not `root`, so same-cell labels read `tine//...` exactly as in a consuming project.
# An alias would not do: as an external cell, `tine` must resolve to itself.
tine = .
prelude = prelude
none = none

[cell_aliases]
config = prelude
# The toolchain the tine cell declares. An alias rather than a nested cell, so that a consuming project
# can pull tine in as an external cell.
toolchains = tine
# Satisfy the bundled prelude's internal platform alias.
fbsource = none

[external_cells]
prelude = bundled

[parser]
target_platform_detector_spec = target:tine//...->prelude//platforms:default

[build]
execution_platforms = prelude//platforms:default

[project]
# VCS state, dependency and build trees, and the caches tools keep must not invalidate Buck's file
# watcher. Only names that are always generated: `build`, `dist` and `out` are ordinary package names,
# and ignoring one would hide the targets in it rather than only its churn.
ignore = .git, .jj, **/.git, **/.jj, **/.hg, **/.svn, \
    **/buck-out, **/target, **/node_modules, **/__pycache__, **/.venv, **/venv, \
    **/.cache, **/.direnv, **/.gradle, **/.tox, **/.nox, \
    **/.mypy_cache, **/.pytest_cache, **/.ruff_cache, \
    **/.next, **/.parcel-cache, **/.turbo, **/.idea, **/.vscode

[buck2]
materializations = deferred
sqlite_materializer_state = true
defer_write_actions = true
