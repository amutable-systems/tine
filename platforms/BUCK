load("@prelude//:rules.bzl", "constraint_setting", "constraint_value")
load("@prelude//platforms:defs.bzl", "host_configuration")
load(":architecture.bzl", "ARCHITECTURES")
load(":defs.bzl", "execution_platform", "target_platform")

# `tine init` points a project that builds against this cell here too, for both its execution and
# its target platform, so every such project caches without configuring anything.
execution_platform(
    name = "default",
    cpu_configuration = host_configuration.cpu,
    os_configuration = host_configuration.os,
    visibility = ["PUBLIC"],
)

# A configuration carries this value exactly when the distribution chosen for it is served on the
# configured architecture; the transition in distribution/defs.bzl adds it, and no platform has it. A
# target declares that it exists on some architectures only by requiring this constraint in
# `target_compatible_with`. `//...` then skips it on other architectures, and building it there reports
# `architecture-served unsatisfied`. See `architecture.compatibility()` in platforms/architecture.bzl for
# a component, `distribution.compatibility()` for an image, and `distribution.alias()` for the aliases
# that choose a distribution for one.
constraint_setting(name = "served")

constraint_value(
    name = "architecture-served",
    constraint_setting = ":served",
    visibility = ["PUBLIC"],
)

# A target platform per supported architecture; select with `--target-platforms`
[
    target_platform(
        name = name,
        configurations = [spellings.config, "config//os:linux"],
        visibility = ["PUBLIC"],
    )
    for name, spellings in ARCHITECTURES.items()
]
