"""Logical image mutation and boot assembly drivers."""

load("//box:test.bzl", "box_python_test")
load(":image.bzl", "image_tools")

# The one bundle every image rule resolves its drivers through.
image_tools(
    name = "tools",
    archive = "//image_format:archive",
    artifacts = ":artifacts",
    boot = ":boot",
    convert = "//image_format:convert",
    disk = "//image_format:disk",
    layer = ":layer",
    python = "//tools:python3",
    sbom = ":sbom",
    syft = "//tools:syft",
    sysext = "//image_format:sysext",
    uki = ":uki",
    visibility = ["PUBLIC"],
)

python_bootstrap_binary(
    name = "layer",
    main = "layer.py",
    deps = [
        ":finalize",
        "//:specs",
        "//:util",
        "//package:installer",
        "//rootfs:rootfs",
    ],
    visibility = ["PUBLIC"],
)

python_bootstrap_binary(
    name = "uki",
    main = "uki.py",
    deps = [
        ":finalize",
        ":kmod",
        "//:specs",
        "//archive:cpio",
    ],
    visibility = ["PUBLIC"],
)

python_bootstrap_library(
    name = "kmod",
    srcs = ["kmod.py"],
)

# A project's own template in, the file an image installs out.
python_bootstrap_binary(
    name = "substitute",
    main = "substitute.py",
    deps = ["//:specs"],
    visibility = ["PUBLIC"],
)

