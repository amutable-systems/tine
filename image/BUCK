# A driver that packages a tree lists it from inside its own action, where the tree is final.
tine_python_library(
    name = "manifest-lib",
    srcs = ["manifest.py"],
    deps = [
        ":finalize",
        "//:specs",
        "//:util",
    ],
    visibility = ["//image_format:"],
)

tine_python_library(
    name = "finalize",
    srcs = ["finalize.py"],
    deps = ["//:util", "//rootfs:rootfs"],
    visibility = ["PUBLIC"],
)

tine_python_library(
    name = "artifacts-lib",
    srcs = ["artifacts.py"],
    boxes = _MANAGER_BOXES,
    deps = [
        ":finalize",
        "//:specs",
        "//:util",
    ],
)

tine_python_binary(
    name = "artifacts",
    main = "artifacts.py",
    boxes = _MANAGER_BOXES,
    deps = [
        ":finalize",
        "//:specs",
        "//:util",
    ],
    visibility = ["PUBLIC"],
)

tine_python_binary(
    name = "boot",
    main = "boot.py",
    deps = [
        ":artifacts-lib",
        ":finalize",
        ":kmod",
        ":version",
        "//:specs",
        "//:util",
    ],
    visibility = ["PUBLIC"],
)

# Nothing satisfies this value, so a target requiring it cannot be built. A key whose section has no
# token requires it, which keeps it out of `//...` and makes an image that signs with it fail naming
# this target. `prelude//:none` would do the same without naming a reason.
constraint_setting(name = "signing-configuration")

constraint_value(
    name = "no-signing-token-configured",
    constraint_setting = ":signing-configuration",
    visibility = ["PUBLIC"],
)
