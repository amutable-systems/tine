"""Logical image mutation and boot assembly drivers."""

load("@prelude//:rules.bzl", "constraint_setting", "constraint_value")
load("//box:test.bzl", "box_python_test")
load("//catalog:architectures.bzl", "ARCH_ARCHITECTURES", "FEDORA_ARCHITECTURES")
load("//platforms:architecture.bzl", "architecture")
load("//python:defs.bzl", "tine_python_binary", "tine_python_library")
load(":image.bzl", "image_tools")

# The artifacts driver runs in whichever manager's box an image resolves through, so it is checked
# against each, on the hosts that have it.
_MANAGER_BOXES = ["tine//catalog:fedora.rawhide.box"] + architecture.select(
    {arch: ["tine//catalog:arch.rolling.box"] if arch in ARCH_ARCHITECTURES else [] for arch in FEDORA_ARCHITECTURES}
)

# The one bundle every image rule resolves its drivers through.
image_tools(
    name = "tools",
    archive = "//image_format:archive",
    artifacts = ":artifacts",
    boot = ":boot",
    convert = "//image_format:convert",
    disk = "//image_format:disk",
    layer = ":layer",
    manifest = ":manifest",
    python = "//tools:python3",
    sbom = ":sbom",
    syft = "//tools:syft",
    sysext = "//image_format:sysext",
    uki = ":uki",
    visibility = ["PUBLIC"],
)

tine_python_binary(
    name = "layer",
    main = "layer.py",
    deps = [
        ":finalize",
        "//:specs",
        "//:util",
        "//package:installer",
        "//rootfs:rootfs",
    ],
    visibility = ["PUBLIC"],
)

tine_python_binary(
    name = "uki",
    main = "uki.py",
    deps = [
        ":finalize",
        ":kmod",
        "//:specs",
        "//:util",
        "//archive:cpio",
    ],
    visibility = ["PUBLIC"],
)

tine_python_library(
    name = "kmod",
    srcs = ["kmod.py"],
    deps = ["//:util"],
)

tine_python_library(
    name = "version",
    srcs = ["version.py"],
)

# A project's own template in, the file an image installs out.
tine_python_binary(
    name = "substitute",
    main = "substitute.py",
    deps = ["//:specs", "//:util"],
    visibility = ["PUBLIC"],
)

