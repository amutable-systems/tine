"""The alpm (pacman) native package system and its driver bundle."""

load("//box:test.bzl", "box_python_test")
load("//package:system.bzl", "package_system")
load("//python:defs.bzl", "tine_python_binary", "tine_python_library")

# Host tools bootstrap the box; remaining drivers run inside it.

# alpm's formats, read and written without the library, plus the library that resolves against
# them. The host-side drivers below use only the first half; see alpm.py.
tine_python_library(name = "alpm", srcs = ["alpm.py"], deps = ["//:util"])

tine_python_binary(
    name = "extract",
    main = "extract.py",
    deps = [":alpm", "//package:extractor"],
)

tine_python_binary(
    name = "install",
    main = "install.py",
    deps = [":alpm", "//:util", "//package:installer"],
)

# The capture driver implements the terminal-image contract, so it takes that library.
tine_python_binary(
    name = "pkgdb",
    main = "pkgdb.py",
    deps = [
        ":alpm",
        "//:specs",
        "//:util",
        "//archive:tar",
        "//image:finalize",
    ],
)
tine_python_binary(name = "index", main = "index.py", deps = [":alpm", "//:specs", "//:util"])
tine_python_binary(
    name = "plan",
    main = "plan.py",
    deps = [
        ":alpm",
        "//:specs",
        "//:util",
        "//package:href",
        "//package:transaction",
        "//rootfs:rootfs",
    ],
)

tine_python_binary(
    name = "snapshot",
    main = "snapshot.py",
    deps = [":alpm", "//:util", "//package:href", "//package:snapshotter"],
)

tine_python_library(name = "gnupg", srcs = ["gnupg.py"])

tine_python_binary(
    name = "keyring",
    main = "keyring.py",
    deps = [":gnupg", "//:specs", "//:util"],
)

tine_python_binary(
    name = "verify",
    main = "verify.py",
    deps = [":alpm", ":gnupg", "//:specs", "//:util"],
)

# `build` stays unset: Arch has no makepkg rule here yet.
package_system(
    name = "package_system",
    # alpm keeps a directory of per-package entries, so a capture of it is an archive.
    database_format = "tar.zst",
    # Keep in sync with alpm.py's DBPATH, which Starlark cannot read.
    database_paths = ["var/lib/pacman"],
    # pacman reads the pinned databases directly, so there is nothing to convert in advance.
    solver_cache = False,
    extract = ":extract",
    index = ":index",
    install = ":install",
    keyring = ":keyring",
    verify = ":verify",
    # Arch has served zstd for years, so that is what a selected package is named with; an older
    # compressor still in a pinned repository is only recognized (alpm.is_package), never named.
    package_suffix = ".pkg.tar.zst",
    pkgdb = ":pkgdb",
    plan = ":plan",
    snapshot = ":snapshot",
    visibility = ["PUBLIC"],
)

# The planner resolves through libalpm, so its test runs in the box that carries it.
box_python_test(
    name = "plan-test",
    box = "tine//catalog:arch.rolling.box",
    srcs = ["alpm.py", "plan.py", "plan_test.py"],
    deps = ["//:specs", "//:util", "//package:href", "//package:transaction", "//rootfs:rootfs"],
)

# The dev box rather than the alpm one: the verifier's tests build a distribution's keys, which
# takes gpg, and nothing here needs alpm's library.
box_python_test(
    name = "test",
    box = "//tools:dev.box",
    deps = ["//:specs", "//:util"],
    srcs = [
        "alpm.py",
        "alpm_test.py",
        "gnupg.py",
        "keyring.py",
        "verify.py",
        "verify_test.py",
    ],
)
