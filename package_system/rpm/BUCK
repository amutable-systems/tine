"""The RPM native package system and its driver bundle."""

load("//package:system.bzl", "package_system")

# Host tools bootstrap the engine; remaining drivers run inside it.

python_bootstrap_library(name = "rpmfile", srcs = ["rpmfile.py"])

python_bootstrap_binary(
    name = "extract",
    main = "extract.py",
    deps = ["//archive:cpio", "//rootfs:rootfs", ":rpmfile"],
)

python_bootstrap_binary(
    name = "decompress",
    main = "decompress.py",
    deps = [":rpmfile"],
    visibility = ["PUBLIC"],
)

python_bootstrap_binary(name = "install", main = "install.py", deps = ["//rootfs:rootfs"])
python_bootstrap_binary(name = "createrepo", main = "createrepo.py")
python_bootstrap_binary(name = "plan", main = "plan.py", deps = ["//:util", "//rootfs:rootfs"])
python_bootstrap_binary(name = "build", main = "build.py", deps = ["//:util", "//rootfs:rootfs"])

python_bootstrap_binary(
    name = "snapshot",
    deps = ["//:util"],
    main = "snapshot.py",
)

package_system(
    name = "package_system",
    extract = ":extract",
    snapshot = ":snapshot",
    install = ":install",
    createrepo = ":createrepo",
    plan = ":plan",
    build = ":build",
    visibility = ["PUBLIC"],
)
