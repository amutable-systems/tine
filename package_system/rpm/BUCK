"""The RPM native package system and its driver bundle."""

load("//package:system.bzl", "package_system")

# Host tools bootstrap the engine; remaining drivers run inside it.

python_bootstrap_library(name = "rpmfile", srcs = ["rpmfile.py"])

python_bootstrap_binary(
    name = "extract",
    main = "extract.py",
    deps = [":rpmfile", "//:specs", "//archive:cpio", "//rootfs:rootfs"],
)

python_bootstrap_binary(
    name = "decompress",
    main = "decompress.py",
    deps = [":rpmfile"],
    visibility = ["PUBLIC"],
)

python_bootstrap_binary(name = "install", main = "install.py", deps = ["//:specs", "//rootfs:rootfs"])

# The capture driver implements the terminal-image contract, so it takes that library.
python_bootstrap_binary(name = "pkgdb", main = "pkgdb.py", deps = ["//:specs", "//image:finalize"])
python_bootstrap_binary(name = "createrepo", main = "createrepo.py", deps = ["//:specs"])
python_bootstrap_binary(name = "plan", main = "plan.py", deps = ["//:specs", "//:util", "//rootfs:rootfs"])
python_bootstrap_binary(name = "build", main = "build.py", deps = ["//:specs", "//:util", "//rootfs:rootfs"])

python_bootstrap_binary(
    name = "snapshot",
    deps = ["//:specs", "//:util"],
    main = "snapshot.py",
)

package_system(
    name = "package_system",
    extract = ":extract",
    snapshot = ":snapshot",
    install = ":install",
    pkgdb = ":pkgdb",
    index = ":createrepo",
    package_suffix = ".rpm",
    plan = ":plan",
    build = ":build",
    # Keep in sync with install.py's DBPATH, which Starlark cannot read.
    database_paths = ["usr/lib/sysimage/rpm"],
    visibility = ["PUBLIC"],
)
