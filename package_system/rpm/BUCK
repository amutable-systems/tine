"""The RPM native package system and its driver bundle."""

load("//package:system.bzl", "package_system")
load("//python:defs.bzl", "tine_python_binary", "tine_python_library")

# Host tools bootstrap the box; remaining drivers run inside it. The drivers that reach for libdnf5
# or createrepo_c are type-checked against the box that supplies them.
_BOX = "tine//catalog:fedora.rawhide.box"

tine_python_library(name = "rpmfile", srcs = ["rpmfile.py"], deps = ["//:util"])

tine_python_binary(
    name = "extract",
    main = "extract.py",
    deps = [":rpmfile", "//archive:cpio", "//package:extractor"],
)

tine_python_binary(name = "install", main = "install.py", boxes = [_BOX], deps = ["//:util", "//package:installer"])

# The capture driver implements the terminal-image contract, so it takes that library.
tine_python_binary(name = "pkgdb", main = "pkgdb.py", deps = ["//:specs", "//:util", "//image:finalize"])
tine_python_binary(
    name = "createrepo",
    main = "createrepo.py",
    boxes = [_BOX],
    deps = ["//:specs", "//:util"],
)
tine_python_binary(
    name = "plan",
    main = "plan.py",
    boxes = [_BOX],
    deps = ["//:specs", "//:util", "//package:transaction", "//rootfs:rootfs"],
)
tine_python_binary(name = "build", main = "build.py", deps = ["//:specs", "//:util", "//rootfs:rootfs"])

tine_python_binary(
    name = "snapshot",
    deps = ["//:util", "//package:href", "//package:snapshotter"],
    main = "snapshot.py",
)

package_system(
    name = "package_system",
    extract = ":extract",
    snapshot = ":snapshot",
    install = ":install",
    pkgdb = ":pkgdb",
    index = ":createrepo",
    package_suffix = ".rpm",
    plan = ":plan",
    build = ":build",
    # rpm keeps one sqlite database, so a capture of it is that file.
    database_format = "sqlite",
    # Keep in sync with install.py's DBPATH, which Starlark cannot read.
    database_paths = ["usr/lib/sysimage/rpm"],
    visibility = ["PUBLIC"],
)
