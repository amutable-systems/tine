"""The RPM native package system and its driver bundle."""

load("//box:test.bzl", "box_python_test")
load("//package:system.bzl", "package_system")
load("//python:defs.bzl", "tine_python_binary", "tine_python_library")

# The drivers that import libdnf5, createrepo_c or rpm are type-checked against the dev box.
_BOX = "tine//tools:dev.box"

tine_python_library(name = "rpmfile", srcs = ["rpmfile.py"], deps = ["//:util"])

tine_python_binary(
    name = "extract",
    main = "extract.py",
    deps = [":rpmfile", "//archive:cpio", "//package:extractor"],
)

tine_python_library(name = "macros", srcs = ["macros.py"], boxes = [_BOX])

tine_python_binary(name = "install", main = "install.py", boxes = [_BOX], deps = [":macros", "//:util", "//package:installer"])

# The capture driver implements the terminal-image contract, so it takes that library.
tine_python_binary(name = "pkgdb", main = "pkgdb.py", deps = ["//:specs", "//:util", "//image:finalize"])

tine_python_binary(
    name = "createrepo",
    main = "createrepo.py",
    boxes = [_BOX],
    deps = ["//:specs", "//:util"],
)

tine_python_binary(
    name = "plan",
    main = "plan.py",
    boxes = [_BOX],
    deps = [":macros", "//:specs", "//:util", "//package:transaction", "//rootfs:rootfs"],
)

tine_python_binary(name = "build", main = "build.py", deps = ["//:specs", "//:util", "//rootfs:rootfs"])

box_python_test(
    name = "build-test",
    box = _BOX,
    srcs = ["build.py", "build_test.py"],
    deps = ["//:specs", "//:util", "//rootfs:rootfs"],
)

# The driver runs in the box with network access. It reads a source checkout's packaging pin and writes the
# pinned dist-git tree.
tine_python_binary(name = "packaging", main = "packaging.py", deps = ["//:specs", "//:util"], visibility = ["PUBLIC"])

box_python_test(
    name = "packaging-test",
    box = _BOX,
    srcs = ["packaging.py", "packaging_test.py"],
    deps = ["//:specs", "//:util"],
)

tine_python_binary(
    name = "snapshot",
    deps = ["//:util", "//package:href", "//package:snapshotter"],
    main = "snapshot.py",
)

tine_python_library(name = "rpmkeys", srcs = ["rpmkeys.py"])

tine_python_binary(
    name = "keyring",
    main = "keyring.py",
    boxes = [_BOX],
    deps = [":rpmkeys", "//:specs", "//:util"],
)

tine_python_binary(
    name = "verify",
    main = "verify.py",
    boxes = [_BOX],
    deps = [":rpmkeys", "//:specs", "//:util"],
)

box_python_test(
    name = "plan-test",
    box = _BOX,
    srcs = ["createrepo.py", "plan.py", "plan_test.py"],
    deps = [":macros", "//:specs", "//:util", "//package:transaction", "//rootfs:rootfs"],
)

box_python_test(
    name = "test",
    box = _BOX,
    srcs = ["keyring.py", "rpmkeys.py", "verify.py", "verify_test.py"],
    deps = ["//:specs", "//:util"],
)

package_system(
    name = "package_system",
    arch_schema = "rpm",
    extract = ":extract",
    snapshot = ":snapshot",
    install = ":install",
    pkgdb = ":pkgdb",
    index = ":createrepo",
    package_suffix = ".rpm",
    plan = ":plan",
    build = ":build",
    keyring = ":keyring",
    verify = ":verify",
    # rpm keeps one sqlite database, so a capture of it is that file.
    database_format = "sqlite",
    # Keep in sync with install.py's DBPATH, which Starlark cannot read.
    database_paths = ["usr/lib/sysimage/rpm"],
    visibility = ["PUBLIC"],
)
