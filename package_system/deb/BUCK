# The capture driver implements the terminal-image contract, so it takes that library.
tine_python_binary(
    name = "pkgdb",
    main = "pkgdb.py",
    deps = [":debfile", "//:specs", "//:util", "//archive:tar", "//image:finalize"],
)

# `build` stays unset: Debian has no dpkg-buildpackage rule here yet.
package_system(
    name = "package_system",
    arch_schema = "deb",
    database_format = "tar.zst",
    # Keep in sync with debfile.py's ADMINDIR, which Starlark cannot read.
    database_paths = ["var/lib/dpkg"],
    # APT builds its own cache during `update`, so there is nothing to convert in advance.
    solver_cache = False,
    extract = ":extract",
    index = ":index",
    install = ":install",
    keyring = ":keyring",
    # The Release vouches for the index and the index for each package.
    metadata_vouches = True,
    package_suffix = ".deb",
    pkgdb = ":pkgdb",
    plan = ":plan",
    snapshot = ":snapshot",
    verify = ":verify",
    visibility = ["PUBLIC"],
)

# The dev box rather than a Debian one: the tests make an archive's keys and sign with gpg, and
