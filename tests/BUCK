"""The unit-test suite, a build action running hermetically in the dev box engine."""

load(":defs.bzl", "engine_unittest")

# The tests locate the tool under test relative to their own file, so the tree mirrors the
# cell layout. `buck build tine//tests:unit-test` runs the suite; the action caches, so it
# only reruns when the tests, the tool, or the engine change.
engine_unittest(
    name = "unit-test",
    engine = "//box:dev.engine",
    srcs = {"tests/" + f: f for f in glob(["__init__.py", "test_*.py"])}
    | {
        "tools/importer": "//tools:importer-src",
        "tools/version.py": "//tools:version-src",
    },
    visibility = ["tine//tools:check"],
)

# Generic image_vm boot smoke driver: boots any VM runner under a pty, waits for the autologin
# shell, asserts the system settled, then powers off. Reused by the example smoke targets.
python_bootstrap_binary(
    name = "boot-smoke",
    main = "boot-smoke.py",
    visibility = ["PUBLIC"],
)
