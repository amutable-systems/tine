"""Cross-image test drivers. Unit tests live beside the code they exercise (`tine//<pkg>:test`)."""

load("//python:defs.bzl", "tine_python_binary")

# Generic image_vm boot smoke driver: boots any VM runner under a pty, waits for the autologin
# shell, asserts the system settled, then powers off. Reused by the example smoke targets.
tine_python_binary(
    name = "boot-smoke",
    main = "boot-smoke.py",
    visibility = ["PUBLIC"],
)

# The shared build cache end to end: a cold build through `tine buck` publishes the Go example to a
# SeaweedFS bucket, and a cleaned checkout with a fresh shim gets it back. Minutes rather than
# seconds and needs a network for the Go modules, so it is a ci.sh group rather than a suite.
tine_python_binary(
    name = "cache-roundtrip-driver",
    main = "cache_roundtrip.py",
    deps = [
        "//:util",
        "//bin:cache_shim",
        "//remote_cache:seaweed",
    ],
)

command_alias(
    name = "cache-roundtrip",
    args = ["--weed", "$(location_exec //tools:seaweedfs)"],
    exe = ":cache-roundtrip-driver",
)

# Assert an artifact mentions what it should. Shared because "these things must appear in that
# file" is the same test whether the file is an SBOM or a module manifest.
export_file(
    name = "contains.sh",
    src = "contains.sh",
    visibility = ["PUBLIC"],
)

# Assert a listing stays inside what the artifact it describes actually carries. Shared because a
# DDI, a partition and a disk each answer that question the same way.
export_file(
    name = "manifest-scope.sh",
    src = "manifest-scope.sh",
    visibility = ["PUBLIC"],
)
