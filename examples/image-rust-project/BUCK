"""An image carrying a Rust program built from source.

In a product this package lives in the OS.git that vendors tine, beside a checkout of each project
it builds. `hello/` plays that checkout.
"""

load("@tine//cargo:rules.bzl", "cargo_package")
load("@tine//engine:build.bzl", "engine")
load("@tine//image:defs.bzl", "copy", "install_packages", "rootfs_archive")
load("@tine//package:manager.bzl", "package_manager")

# The build environment for our Rust projects; it never reaches an image.
engine(
    name = "rust.engine",
    packages = [
        "cargo",
        "gcc",
        # tine's in-engine drivers run on the engine's own interpreter.
        "python3",
        "rust",
    ],
    release = "tine//catalog:fedora.rawhide.release",
    resolver_engine = "tine//catalog:fedora.rawhide.engine",
)

# A checked-out project needs no build file of its own: the sources default to the directory named
# after the target, and the Cargo.lock in them both pins the crates and marks the workspace root.
cargo_package(
    name = "hello",
    binaries = ["hello-cli"],
    engine = ":rust.engine",
)

# A project with no dependencies at all, which therefore commits no Cargo.lock.
cargo_package(
    name = "nodeps",
    binaries = ["nodeps"],
    engine = ":rust.engine",
)

package_manager(
    name = "image.package-manager",
    base = "tine//catalog:fedora.rawhide.package-manager",
)

# `:demo[sbom][cyclonedx]` reports the crates the binary was built from, next to the image's packages.
rootfs_archive(
    name = "demo",
    package_manager = ":image.package-manager",
    ops = [
        # Rust links against glibc.
        install_packages(["glibc"]),
        copy(":hello[hello-cli]", "/usr/bin/hello-cli"),
        copy(":nodeps[nodeps]", "/usr/bin/nodeps"),
    ],
    format = "tar",
)
