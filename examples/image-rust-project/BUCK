"""An image carrying a Rust program built from source.

In a product this package lives in the OS.git that vendors tine, beside a checkout of each project
it builds. `hello/` plays that checkout.
"""

load("@tine//cargo:rules.bzl", "cargo_package")
load("@tine//engine:build.bzl", "engine")
load("@tine//image:defs.bzl", "copy", "install", "rootfs_archive")
load("@tine//package:manager.bzl", "package_manager")

# The build environment for our Rust projects; it never reaches an image.
engine(
    name = "rust.engine",
    packages = [
        "cargo",
        "gcc",
        # tine's in-engine drivers run on the engine's own interpreter.
        "python3",
        "rust",
    ],
    release = "tine//catalog:fedora.rawhide.release",
    resolver_engine = "tine//catalog:fedora.rawhide.engine",
)

# Stand in for the fetch a product would declare here, without needing the network a test cannot have:
#
#     git_fetch(
#         name = "hello.checkout",
#         repo = "https://github.com/example/hello",
#         rev = "1c9e0f4b0f7d2a5e8b3c6d1a4f7b2e5c8d0a3f6b",
#     )
#
# Either way cargo_package() receives one opaque directory artifact, whose Cargo.lock no analysis can
# see, so this keeps the post-fetch workspace-discovery path covered.
filegroup(
    name = "hello.checkout",
    srcs = {src.removeprefix("hello/"): src for src in glob(["hello/**"])},
    copy = True,
)

# A fetched project needs no build file of its own. Its Cargo.lock both pins the crates and marks the
# workspace root, even though neither it nor Cargo.toml is visible until the checkout action runs.
cargo_package(
    name = "hello",
    binaries = ["hello-cli"],
    engine = ":rust.engine",
    srcs = [":hello.checkout"],
)

# A project with no dependencies at all, which therefore commits no Cargo.lock.
cargo_package(
    name = "nodeps",
    binaries = ["nodeps"],
    engine = ":rust.engine",
)

package_manager(
    name = "image.package-manager",
    base = "tine//catalog:fedora.rawhide.package-manager",
)

# `:demo[sbom][cyclonedx]` reports the crates the binary was built from, next to the image's packages.
rootfs_archive(
    name = "demo",
    package_manager = ":image.package-manager",
    ops = [
        # Rust links against glibc.
        install(["glibc"]),
        copy(":hello[hello-cli]", "/usr/bin/hello-cli"),
        copy(":nodeps[nodeps]", "/usr/bin/nodeps"),
    ],
    format = "tar",
)
