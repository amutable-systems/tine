"""An image carrying a Rust program built from source.

In a product this package lives in the OS.git that vendors tine, beside a checkout of each project
it builds. `hello/` plays that checkout.
"""

load("@tine//box:defs.bzl", "box")
load("@tine//cargo:defs.bzl", "cargo")
load("@tine//distribution:defs.bzl", "distribution")
load("@tine//git:defs.bzl", "git")
load("@tine//image:defs.bzl", "image")

# A checked-out project needs no build file of its own: the sources default to the directory named
# after the target. Its Cargo.lock both pins the crates and marks the workspace root, even though
# neither it nor Cargo.toml is visible until the source tree has been built.
cargo.package(
    name = "hello",
    binaries = ["hello-cli"],
)

# A project with no dependencies. Its Cargo.lock lists only the project itself.
cargo.package(
    name = "nodeps",
    binaries = ["nodeps"],
)

# Products use git.fetch() for projects they build but do not vendor. The local checkout must override
# this fetch, so its revision is deliberately a placeholder.
git.fetch(
    name = "nodeps.git",
    repo = "https://github.com/example/nodeps",
    rev = "1111111111111111111111111111111111111111",
)

cargo.package(
    name = "renamed",
    binaries = ["nodeps"],
    src = ":nodeps.git",
)

cargo.package(
    name = "incremental",
    binaries = ["nodeps"],
    # Exercise persistent output even when the checkout is not mounted in dev mode.
    dev = True,
    src = "nodeps",
)

box.sh_test(
    name = "packages-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'for binary in "$@"; do [[ "$("$binary")" == "nothing to resolve" ]]; done',
    args = [
        "$(location :nodeps)",
        "$(location :renamed[nodeps])",
        "$(location :incremental)",
    ],
)

# How these binaries install, declared beside the projects rather than repeated by every image that
# installs them. Any image operation may be attached, not only copies.
image.install(
    name = "demo.install",
    # The target declares what it needs, so no image installing it has to know. Rust links
    # against glibc.
    packages = ["glibc"],
    ops = [
        image.ops.copy(":hello[hello-cli]", "/usr/bin/hello-cli"),
        image.ops.copy(":nodeps[nodeps]", "/usr/bin/nodeps"),
        image.ops.mkdir("/usr/share/hello"),
    ],
)

# `:demo[sbom][cyclonedx]` reports the crates the binary was built from, next to the image's packages.
image.archive(
    name = "demo",
    package_manager = distribution.package_manager(),
    ops = [image.ops.install_from(":demo.install")],
    format = "tar",
)

# The crate graph cargo-auditable recorded in each binary must reach the image's SBOM: our own
# packages, a crates.io dependency, and one from git.
box.sh_test(
    name = "sbom-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "@tine//tests:contains.sh",
    args = [
        "$(location :demo[sbom][cyclonedx])",
        "pkg:cargo/hello@0.1.0",
        "pkg:cargo/nodeps@0.1.0",
        "pkg:cargo/serde_json@",
        "pkg:cargo/anyhow@",
    ],
)
