"""RPM package-build examples and their end-to-end assertions."""

load("@tine//box:defs.bzl", "box")
load("@tine//git:defs.bzl", "git")
load("@tine//image:defs.bzl", "image")
load("@tine//package:defs.bzl", "package")
load("@tine//package_system/rpm:defs.bzl", "rpm")

_DISTRO = "catalog//:fedora.rawhide.distribution"

_BUILDROOT = "catalog//:fedora.rawhide.buildroot"

# The checks query the packages with rpm. The root box of the buildroot's release contains rpm, and the dev
# box contains it only when it builds from a Fedora release.
_CHECK_BOX = "catalog//:fedora.rawhide.box"

git.checkout(name = "hello.source")

# The archive path runs %prep and emits both binary and source RPMs. It exists separately from the
# source-tree fixture to check release and dev compression through real RPM headers.
rpm.package(
    name = "hello-archive",
    package = "hello",
    spec = "hello/hello.spec",
    buildroot = _BUILDROOT,
    release = "1",
    source_date_epoch = 1754006400,
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-archive-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'python3 "$@"',
    args = ["$(source hello_archive_check.py)", "$(location :hello-archive)"],
)

# The explicit override keeps this source-tree fixture in dev mode without depending on the
# user's root config.
rpm.package(
    name = "hello-dev",
    package = "hello",
    buildroot = _BUILDROOT,
    build_requires = ["gcc"],
    dev = True,
    in_place_spec = "rpm/hello.spec",
    release = "1",
    source_date_epoch = 1754006400,
    source_tree = ":hello.source",
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-dev-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'python3 "$@"',
    args = [
        "$(source hello_dev_check.py)",
        "$(location :hello-dev)",
        "$(location :hello-dev[build])",
    ],
)

# The same checkout built for release from an in-tree dist-git rather than in dev mode.
# Like the archive build, and unlike the two dev builds, it reaches the shared cache.
rpm.package(
    name = "hello-tree",
    package = "hello",
    buildroot = _BUILDROOT,
    build_requires = ["gcc"],
    in_place_spec = "rpm/hello.spec",
    release = "1",
    source_date_epoch = 1754006400,
    source_tree = ":hello.source",
    subpackages = ["hello"],
)

box.sh_test(
    name = "hello-tree-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'python3 "$@"',
    args = [
        "$(source hello_tree_check.py)",
        "$(location :hello-tree)",
    ],
)

# hello-pinned builds the same checkout with the spec and sources of the dist-git commit that
# rpm/packaging.json pins for fedora. The pin names a bundle in the project, so the fetch needs no network.
# The pinned spec doesn't produce hello-imported-only. The build reports the missing subpackage and doesn't
# fail.
rpm.package(
    name = "hello-pinned",
    package = "hello",
    buildroot = _BUILDROOT,
    build_requires = ["gcc"],
    in_place_packaging = "rpm/packaging.json",
    in_place_packaging_distro = "fedora",
    release = "1",
    source_date_epoch = 1754006400,
    source_tree = ":hello.source",
    subpackages = ["hello", "hello-imported-only"],
)

box.sh_test(
    name = "hello-pinned-test",
    distro = _DISTRO,
    labels = ["image"],
    box = _CHECK_BOX,
    script = 'python3 "$@"',
    args = [
        "$(source hello_pinned_check.py)",
        "$(location :hello-pinned)",
        "$(location :hello-pinned[hello])",
    ],
)

# A derived package manager adds the locally built hello to the release's repositories. Fedora's
# repositories contain a newer hello. The solver picks the local hello only if the derived package manager
# gives the local repository its priority.
package.local_repository(
    name = "hello.repository",
    packages = [":hello-archive"],
)

package.manager(
    name = "hello.package-manager",
    base = "catalog//:fedora.rawhide.package-manager",
    additional_repositories = [":hello.repository"],
)

image.layer(
    name = "hello-image.layer",
    distro = _DISTRO,
    package_manager = ":hello.package-manager",
    packages = ["hello"],
)

image.archive(
    name = "hello-image",
    distro = _DISTRO,
    format = "tar",
    parent = ":hello-image.layer",
)

box.sh_test(
    name = "hello-image-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'tar -tf "$1" | grep -E "^(\\./)?usr/share/tine-package/archive$" > /dev/null',
    args = ["$(location :hello-image)"],
    distro = _DISTRO,
)
