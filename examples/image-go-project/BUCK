"""An image carrying a Go program built from source.

In a product this package lives in the OS.git that vendors tine, beside a checkout of each project
it builds. `hello/` plays that checkout.
"""

load("@tine//box:defs.bzl", "box")
load("@tine//distribution:defs.bzl", "distribution")
load("@tine//git:defs.bzl", "git")
load("@tine//go:defs.bzl", "go")
load("@tine//http:defs.bzl", "http")
load("@tine//image:defs.bzl", "image")
load("//:tine.lock.json", _pins = "value")

# The build environment for our Go projects; it never reaches an image.
box.new(
    name = "go.box",
    packages = [
        # TLS trust for the module fetch from proxy.golang.org.
        "ca-certificates",
        "golang",
    ],
    release = "catalog//:fedora.rawhide.release",
)

# A checked-out project needs no build file of its own: the sources default to the directory named
# after the target, and the go.mod in them marks the module root.
go.package(
    name = "hello",
    box = ":go.box",
    packages = {"hello-cli": "./cmd/hello-cli"},
    test_packages = ["./..."],
)

go.test(
    name = "hello-test",
    labels = ["image"],
    package = ":hello",
)

# A project with no dependencies at all, which therefore commits no go.sum and fetches nothing.
# Without `packages`, the module's only main package is built under the target's name.
go.package(
    name = "nodeps",
    box = ":go.box",
    test_packages = ["./..."],
)

go.test(
    name = "nodeps-test",
    labels = ["image"],
    package = ":nodeps",
)

# The local checkout must override this fetch, so its revision is deliberately a placeholder.
git.fetch(
    name = "nodeps.git",
    repo = "https://github.com/example/nodeps",
    rev = "1111111111111111111111111111111111111111",
)

go.package(
    name = "renamed",
    box = ":go.box",
    src = ":nodeps.git",
)

go.package(
    name = "multiple",
    box = ":go.box",
    # Force the persistent-cache path for this test; real projects select dev mode with tine mount.
    dev = True,
    packages = {
        "first": ".",
        "second": "example.com/nodeps",
    },
    src = "nodeps",
)

go.package(
    name = "pie",
    box = ":go.box",
    build_mode = "pie",
    src = "nodeps",
)

# The ELF header stores the file type as a 16-bit value at offset 16. A PIE binary has type 3 (ET_DYN).
# A binary linked at a fixed address has type 2 (ET_EXEC). The dev box contains no readelf, so the test reads
# the value with od.
box.sh_test(
    name = "pie-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = '[[ $(od -An -tu2 -j16 -N2 "$1") -eq 3 ]]',
    args = ["$(location :pie[pie])"],
)

# This checkout has a go.mod at its root and the server module in server/. The server's go.mod
# replaces the module in api/ with that directory. The root module does not require the server.
# Without `module_root`, the build selects the root module, which contains no Go package.
go.package(
    name = "siblings",
    box = ":go.box",
    module_root = "server",
)

box.sh_test(
    name = "module-root-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = '[[ "$("$1")" == "server using sibling api: "* ]]',
    args = ["$(exe :siblings)"],
)

box.sh_test(
    name = "packages-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'for binary in "$@"; do [[ "$("$binary")" == "no dependencies here" ]]; done',
    # $(exe) goes through RunInfo: a single binary is run as the target, any binary as its sub-target.
    args = [
        "$(exe :nodeps)",
        "$(exe :renamed)",
        "$(exe :multiple[first])",
        "$(exe :multiple[second])",
    ],
)

# go.package runs the toolchain's go inside the box, so Buck downloads the release for the box's
# architecture.
http.tool(
    name = "go",
    directory = True,
    path = "bin/go",
    spec = _pins["go"],
)

# The box contains no golang package, so the build fails unless go.package runs the toolchain's go.
box.new(
    name = "go-toolchain.box",
    packages = ["ca-certificates"],
    release = "catalog//:fedora.rawhide.release",
)

go.package(
    name = "toolchain",
    box = ":go-toolchain.box",
    packages = {"hello-cli": "./cmd/hello-cli"},
    src = "hello",
    toolchain = ":go",
)

# `$(exe :go)` has to bring the whole unpacked release, because go finds its standard library through the
# directory around bin/go.
box.sh_test(
    name = "go-run-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = '[[ "$("$1" version)" == "go version {} "* && -d "$("$1" env GOROOT)/src/runtime" ]]'.format(_pins["go"]["release"]),
    args = ["$(exe :go)"],
)

# go writes the version of the toolchain that built a binary into the binary.
box.sh_test(
    name = "toolchain-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "@tine//tests:contains.sh",
    args = [
        "$(location :toolchain[hello-cli])",
        _pins["go"]["release"],
    ],
)

go.package(
    name = "go-version",
    box = ":go-toolchain.box",
    packages = {"hello-cli": "./cmd/hello-cli"},
    src = "hello",
    toolchain = "catalog//:go.releases",
)

# hello/.go-version names 1.26.8, and the catalog declares a newer Go 1.26 release. The test runs
# `go version` from `:go`, a Go 1.27 release, to read the release that built the binary. That release is
# a Go 1.26 release newer than 1.26.8 only if the build read the minor version from hello/.go-version and
# used the release that the catalog declares for it.
box.sh_test(
    name = "go-version-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'release=": go1[.]26[.]([0-9]+)$"; [[ "$("$1" version "$2")" =~ $release ]] && (( BASH_REMATCH[1] > 8 ))',
    args = [
        "$(exe :go)",
        "$(location :go-version[hello-cli])",
    ],
)

# The go.mod replaces a module with a directory in the checkout, so the fetch reads the go.mod in
# that directory too.
go.package(
    name = "local-replace",
    box = ":go.box",
)

box.sh_test(
    name = "local-replace-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = '[[ "$("$1")" == "local replacement: "* ]]',
    args = ["$(exe :local-replace)"],
)

# `:demo[sbom][cyclonedx]` lists the Go modules each binary was built from, next to the image's
# packages.
image.archive(
    name = "demo",
    package_manager = distribution.package_manager(),
    # No runtime packages needed: neither project imports anything that pulls in cgo, so both
    # binaries are static. The filesystem skeleton still comes from its package, giving the
    # copies below their place to land.
    packages = ["filesystem"],
    ops = [
        image.ops.copy(":hello[hello-cli]", "/usr/bin/hello-cli"),
        image.ops.copy(":nodeps[nodeps]", "/usr/bin/nodeps"),
    ],
    format = "tar",
)

# The modules go embeds in the binary must reach the image's SBOM. Our own are unversioned:
# -buildvcs=false leaves a main module's version at (devel).
box.sh_test(
    name = "sbom-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "@tine//tests:contains.sh",
    args = [
        "$(location :demo[sbom][cyclonedx])",
        "pkg:golang/example.com/hello",
        "pkg:golang/example.com/nodeps",
        "pkg:golang/rsc.io/quote@",
        "pkg:golang/golang.org/x/text@",
    ],
    **distribution.distributed("sbom-test"),
)
