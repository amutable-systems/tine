"""Bootable image signed for Secure Boot.

Without configuration, the signing keys are generated at build time and live only in buck-out, so
nothing secret is committed. With `signing.*` configuration, the same image signs through PKCS#11
tokens instead; see docs/signing-pkcs11.md. Real OS images should follow this shape: one definition
serves both, and only the certificate copies below differ, since a token's certificate is a URI
rather than an artifact.

The signed demo-ext system extension shows verity signing for a sysext DDI (always with a
generated key, see below), with the image enforcing the signature through its sysext.conf image
policy.
"""

load(
    "@tine//image:defs.bzl",
    "DEFAULT_SIGNED_USR_VERITY_PARTITIONS",
    "bootable_disk_image",
    "config_signing_key",
    "copy",
    "generate_signing_key",
    "image_artifacts",
    "image_vm",
    "initrd_image",
    "mkdir",
    "sysext_image",
)
load("@tine//package:manager.bzl", "package_manager")
load("@tine//tests:defs.bzl", "vm_smoke")

package_manager(
    name = "image.package-manager",
    base = "tine//catalog:fedora.rawhide.package-manager",
)

_EXTERNAL = read_config("signing", "token") != None

# A token with `-c signing.{token,pin-file,socket}`, a generated development key pair without them.
config_signing_key(name = "signing")

# A second key, so that a compromised expected-PCR policy key cannot also sign boot binaries. Its own
# token, hence its own configuration key: `-c signing.pcr-token`.
config_signing_key(
    name = "pcr-signing",
    token_key = "pcr-token",
)

# Declaring the initrd instead of letting the disk image declare one is what makes it configurable:
# its packages, its operations, and how the cpio the UKI carries is compressed.
initrd_image(
    name = "image.initrd",
    package_manager = ":image.package-manager",
    compression = "none",
)

bootable_disk_image(
    name = "image",
    package_manager = ":image.package-manager",
    initrd = ":image.initrd",
    definitions = DEFAULT_SIGNED_USR_VERITY_PARTITIONS,
    packages = [
        "kernel-core",
        "systemd",
        "systemd-udev",
        "systemd-boot-unsigned",
        "fedora-release",
        "bash",
        "coreutils",
        "util-linux",
        "dbus-broker",
    ],
    ops = (
        [
            # The smoke test compares this against the public key the stub hands the booted system, to
            # tell which key sealed the expected-PCR policy. Sealed under verity, so it cannot be
            # swapped. Generated keys only: a token's certificate is a URI, not an artifact to copy.
            copy(":signing[cert]", "/usr/share/tine-example/secure-boot.crt"),
            copy(":pcr-signing[cert]", "/usr/share/tine-example/expected-pcr.crt"),
        ]
        if not _EXTERNAL
        else []
    )
    + [
        # demo-ext's signature verifies against this certificate; the sysext.conf policy next to
        # it makes that verification a requirement rather than opportunistic.
        copy(":demo-ext-signing[cert]", "/usr/lib/verity.d/demo-ext.crt"),
        copy("sysext.conf", "/usr/lib/systemd/sysext.conf"),
        # Plain data for the boot smoke's negative proof: a DDI the policy must refuse.
        copy(":demo-ext-unsigned", "/usr/share/tine-example/demo-ext-unsigned.raw"),
    ],
    # This key signs the UKIs and systemd-boot, puts auto-enrollment files onto the ESP, and signs
    # the verity root hash. For a key that caches across workspaces, see pem_signing_key() under
    # "Secure Boot signing" in images.md.
    # `compression = "zstd"` on the partition only picks the algorithm; these are what actually make
    # the erofs small, and they are the same options image_sysext builds a DDI with. --invariant keeps
    # the ESP byte-stable, which mkfs.fat is not by default.
    mkfs_options = {
        "erofs": [
            "-zzstd,level=3",
            "-C524288",
            "-Efragments,ztailpacking,dedupe",
        ],
        "vfat": ["--invariant"],
    },
    secure_boot_key = ":signing",
    # A signed /usr is read-only and carries no package manager, so the database in it would only be
    # weight under verity. `:image[pkgdb]` still captures it from the image itself.
    strip_pkgdb = True,
    verity_key = ":signing",
    sign_expected_pcr_key = ":pcr-signing",
)

# System-extension DDI extending :image, signed so the strict policy in sysext.conf accepts the
# merge. Its own generated key rather than :signing: the consuming image must carry the
# certificate as a file, and with `signing.token` configured :signing's certificate is a URI.
sysext_image(
    name = "demo-ext",
    base = ":image",
    packages = ["zsh"],
    install_docs = False,
    verity_key = ":demo-ext-signing",
)

generate_signing_key(name = "demo-ext-signing")

# Everything a release of this example publishes, gathered under the names it publishes them
# under: the disk and its qcow2 encoding, the UKI, the kernel and initrd a direct kernel boot
# needs, the signed extension, and the /usr partitions an update transfers. Each name comes from
# the target that built the artifact, so nothing here decides what anything is called.
image_artifacts(
    name = "release",
    targets = [
        ":demo-ext",
        ":image",
        ":image[qcow2]",
    ],
)

# What the policy protects against: the same extension shape without a signature. Standalone
# (extension-release ID=_any) rather than based on :image, which carries this DDI as smoke test
# data and may not depend on it circularly. Refusal happens at dissection, before content
# matters; the marker is for the smoke test's permissive counter-check.
sysext_image(
    name = "demo-ext-unsigned",
    package_manager = ":image.package-manager",
    ops = [mkdir("/usr/share/tine-unsigned")],
    install_docs = False,
)

image_vm(
    name = "vm",
    autologin = "root",
    credentials = {
        "firstboot.locale": "C.UTF-8",
        "firstboot.timezone": "UTC",
    },
    engine = "tine//catalog:fedora.rawhide.engine",
    image = ":image",
    # select setup-mode firmware, so sd-boot enrolls the keys from the ESP on first
    # boot; VM then enforces Secure Boot.
    secure_boot = True,
    sysexts = [":demo-ext"],
)

# Boot smoke test: enrolls keys on first boot, settles under Secure Boot with a vTPM, then powers
# off. Reuses the shared tine driver; `buck test` runs it, `buck run` boots it by hand.
vm_smoke(
    name = "vm-smoke",
    vm = ":vm",
    checks = [
        "bootctl | grep -F 'Secure Boot: enabled (user)'",
        "bootctl | grep -F 'Measured UKI: yes'",
        "bootctl | grep -F 'Measured OS: yes'",
        # The booted /usr must carry the signed bootloader: bootctl update (and thus
        # systemd-boot-update.service after an OS update) reinstalls from there, and an unsigned
        # binary would fail Secure Boot verification on the next reboot.
        "test -e /usr/lib/systemd/boot/efi/systemd-bootx64.efi.signed",
        # `strip_pkgdb` leaves the package database out of the partitions, so nothing under the
        # signed /usr carries one; the path is the rpm package system's `database_paths`.
        "test ! -e /usr/lib/sysimage/rpm",
        # The disk carries the signature over the verity root hash, which is what lets anything
        # receiving this image as an update verify it before trusting it.
        "test -e /dev/disk/by-designator/usr-verity-sig",
        # The stub hands the booted system the public key the expected-PCR policy is sealed with.
        "test -s /run/systemd/tpm2-pcr-public-key.pem",
        # The extension merged with sysext.conf's strict "signed" image policy. Proves
        # its signature verified against the certificate in /usr/lib/verity.d.
        "systemd-sysext status --no-pager | grep -F demo-ext",
        "test -x /usr/bin/zsh",
        # The same policy refuses an extension without a signature: refresh fails, and must
        # change nothing -- the unsigned extension appears neither in the list nor in the
        # merged file system, and the previous merge stays in place (the dissection failure
        # precedes the unmerge).
        "mkdir -p /run/extensions && cp /usr/share/tine-example/demo-ext-unsigned.raw /run/extensions/",
        "! systemd-sysext refresh",
        "! systemd-sysext status --no-pager | grep -F demo-ext-unsigned",
        "test ! -d /usr/share/tine-unsigned && test -x /usr/bin/zsh",
        # ...and only with a relaxed policy the same DDI merges fine.
        "systemd-sysext refresh '--image-policy=root=verity+signed+unprotected+absent:usr=verity+signed+unprotected+absent:=ignore'",
        "systemd-sysext status --no-pager | grep -F demo-ext-unsigned && test -d /usr/share/tine-unsigned",
        # Undo the relaxed merge: without the unsigned DDI the strict refresh succeeds again,
        # demo-ext stays, and the unsigned marker vanishes.
        "rm /run/extensions/demo-ext-unsigned.raw && systemd-sysext refresh && test -x /usr/bin/zsh && test ! -d /usr/share/tine-unsigned",
    ]
    + (
        [
            # It must be the expected-PCR key, and not the Secure Boot one, compared through the
            # certificates copied into /usr, which external builds do not carry. Derive each in the
            # guest and insist it is non-empty, so that a comparison against nothing cannot pass.
            '/usr/lib/systemd/systemd-keyutil extract-public --certificate /usr/share/tine-example/expected-pcr.crt >/tmp/pcr.pem && test -s /tmp/pcr.pem && test "$(cat /tmp/pcr.pem)" = "$(cat /run/systemd/tpm2-pcr-public-key.pem)"',
            '/usr/lib/systemd/systemd-keyutil extract-public --certificate /usr/share/tine-example/secure-boot.crt >/tmp/sb.pem && test -s /tmp/sb.pem && test "$(cat /tmp/sb.pem)" \'!=\' "$(cat /run/systemd/tpm2-pcr-public-key.pem)"',
        ]
        if not _EXTERNAL
        else []
    ),
)
