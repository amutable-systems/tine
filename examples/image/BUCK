"""Image construction smoke targets.

Every image here is declared once and built for each distribution the PACKAGE file declares. What
varies is the package manager, chosen by a `select()` on the distribution constraint, and the
package sets that manager resolves; the operations themselves are the same either way. No
distribution is the default, so what a build names is one of the per-distribution aliases each
image rule declares for itself.
"""

load("@tine//box:defs.bzl", "box")
load("@tine//distribution:defs.bzl", "distribution")
load("@tine//image:defs.bzl", "image")
load("@tine//package:defs.bzl", "package")
load("@tine//python:defs.bzl", "tine_python_binary")
load("@tine//tests:defs.bzl", "tests")
load(":expected.json", _expected = "value")

# Everything a distribution decides is described in the PACKAGE file, which is the one place a
# distribution is added; nothing below names one.
DISTRIBUTIONS = distribution.for_package()

# Consumer-owned solve context; project repositories can be added here. Which release it derives
# from is the one thing a distribution decides for an image, so it is the only select below.
package.manager(
    name = "image.package-manager",
    base = select({d["distribution"]: d["package_manager"] for d in DISTRIBUTIONS.values()}),
)

# A build artifact a command names through $(location), chrooted or not.
export_file(
    name = "marker.txt",
    src = "marker.txt",
)

export_file(
    name = "configure.sh",
    src = "configure.sh",
)

export_file(
    name = "configure.py",
    src = "configure.py",
)

export_file(
    name = "manifest_check.py",
    src = "manifest_check.py",
)

# Minimal install + ordered-ops demo. `:demo` is both the tar result and a logical image.
image.rootfs_archive(
    name = "demo",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        image.run(["/usr/bin/mkdir", "-p", "/buildroot/etc/tine"]),
        image.run(["/usr/bin/cp", "$(location :marker.txt)", "/buildroot/etc/tine/from-location"]),
        # image.copy() takes a source directly, so it needs no $(location) around the label.
        image.copy(":marker.txt", "/etc/tine/from-copy"),
        # A chrooted command runs with the image's own binaries. Buck's macro parser claims
        # `$(...)`, so the shell substitution is escaped.
        image.run(["/usr/bin/bash", "-c", "echo built-by-\\$(echo tine) > /etc/tine/marker"], chroot = True),
        # A repository-owned script, run inside the image. The project is mounted there, so
        # `$(location)` names the script and its data exactly as it would outside.
        image.run(
            [
                "/usr/bin/bash",
                "$(location :configure.sh)",
                "$(location :marker.txt)",
                "from-script-argument",
            ],
            chroot = True,
        ),
        # The same, in python, which this image does not install: the interpreter is Buck's own.
        image.python(["$(location :configure.py)", "$(location :marker.txt)", "from-python-argument"], chroot = True),
        # Unchrooted, the same interpreter sees the image at /buildroot, like any box command.
        image.python(["-c", "from pathlib import Path; Path('/buildroot/etc/tine/from-python-box').write_text('x\\n')"]),
        # Ensure we don't leak the /tine sandbox mount into image builds
        image.run(["/usr/bin/test", "!", "-d", "/tine"], chroot = True),
    ],
    format = "tar",
)

# Base-only image exercising a single-component delta stack.
image.rootfs_archive(
    name = "base",
    package_manager = ":image.package-manager",
    packages = ["bash"],
    format = "tar",
)

# Chained images: the child adds one file and whiteouts another.
image.layer(
    name = "chained-base",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        image.write_file("/etc/tine/from-base-kept", "base"),
        image.write_file("/etc/tine/from-base-gone", "base"),
    ],
)

image.layer(
    name = "chained-child.layer",
    parent = ":chained-base",
    ops = [
        image.write_file("/etc/tine/from-child", "child"),
        image.remove("/etc/tine/from-base-gone"),
    ],
)

image.archive(
    name = "chained",
    image = ":chained-child.layer",
    format = "tar",
)

# Package installation and mutations sharing one physical delta.
image.layer(
    name = "layered-install-base",
    package_manager = ":image.package-manager",
    packages = ["bash"],
    ops = [
        image.run(["/usr/bin/bash", "-c", "echo base > /etc/from-base-install"], chroot = True),
    ],
)

image.layer(
    name = "layered-install.layer",
    parent = ":layered-install-base",
    packages = ["coreutils"],
    ops = [
        image.run(["/usr/bin/bash", "-c", "ls /usr/bin/ls > /etc/from-child-install"], chroot = True),
    ],
)

image.archive(
    name = "layered-install",
    image = ":layered-install.layer",
    format = "tar",
)

# Round-trip an escaped name and an escaped whiteout through stored deltas.
image.layer(
    name = "escaped-base",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        image.mkdir("/etc/tine"),
        image.run(
            [
                "/usr/bin/bash",
                "-c",
                "echo kept > '/etc/tine/esc\\x2dkept'; echo gone > '/etc/tine/esc\\x2dgone'",
            ],
            chroot = True,
        ),
    ],
)

image.layer(
    name = "escaped-child.layer",
    parent = ":escaped-base",
    ops = [image.remove("/etc/tine/esc\\x2dgone")],
)

image.archive(
    name = "escaped",
    image = ":escaped-child.layer",
    format = "tar",
)

# Bootable GPT image; `buck run :boot-demo-vm` starts it with the box's vmspawn stack.
# Supply-chain and format subtargets such as `:boot-demo[sbom]` and `:boot-demo[qcow2]` build on demand.
# The version stamps os-release, partition labels, and the UKI and disk file names. A product names
# one here, or asks for a git-derived one with `version = "auto:1.4.2"`, which needs a build through
# `bin/tine` (see "Image versioning" in images.md); this demo has nothing to version.
image.bootable_disk(
    name = "boot-demo",
    package_manager = ":image.package-manager",
    definitions = image.DEFAULT_USR_VERITY_PARTITIONS,
    version = "unversioned",
    # The release names what a bootable system of its own family needs, so this stays symbolic.
    # The composition generates the databases those packages only describe, hwdb's among them.
    package_sets = ["bootable"],
    packages = ["less"],
    profiles = [
        image.uki_profile(
            id = "debug",
            title = "Boot with debug logs enabled",
            cmdline = ["debug", "systemd.log_level=debug", "systemd.journald.forward_to_console=1"],
        ),
    ],
    # Arbitrary declared artifacts can be shipped through the ESP.
    esp_files = {"/boot/metadata/demo.spdx.json": ":demo[sbom][spdx]"},
    # A shipped appliance has no terminal to read a man page on.
    install_docs = False,
    # Ship the disk with free space past its partitions, so an installed system can claim it without
    # resizing the medium first. The space is sparse and this image boots from tmpfs, so nothing here
    # consumes it; a real appliance creates a root partition in it on first boot.
    output_size = "2G",
)

image.vm(
    name = "boot-demo-vm",
    autologin = "root",
    # A run-only kernel command line argument: the UKI carries a fixed one, so this can only arrive
    # through the channel vmspawn picks for its trailing arguments. The smoke asserts it landed.
    cmdline_extra = ["tine.smoke=1"],
    credentials = {
        "firstboot.locale": "C.UTF-8",
        "firstboot.timezone": "UTC",
    },
    # The runner's box is independent of the image's, so every distribution boots under the
    # same harness and the VM stack is built once rather than per release.
    box = "tine//catalog:fedora.rawhide.box",
    image = ":boot-demo",
    sysexts = [":demo-ext"],
)

# Boot smoke test: drives :boot-demo-vm's console over a pty (via the shared tine driver),
# asserts the system settles, then powers off. `buck test` runs it, `buck run` boots it by hand.
tests.vm_smoke(
    name = "boot-demo-vm-smoke",
    vm = ":boot-demo-vm",
    checks = [
        # The distribution that booted is the one that was asked for. A select reaches here through
        # the alias the macro declares, which configures this target too. This reads the file the
        # build produced rather than the `/etc` symlink to it: a `/usr`-only disk boots with a
        # volatile root, and whether anything recreates that symlink is a property of the
        # distribution's own systemd rather than of the image.
        select({d["distribution"]: "grep -q '^ID={}$' /usr/lib/os-release".format(d["os_release_id"]) for d in DISTRIBUTIONS.values()}),
        "bootctl | grep -F 'Secure Boot: disabled (setup)'",
        # The build compiled the hardware database into /usr, which is read-only here, so a guest
        # that has it got it from the build rather than from a boot-time regeneration.
        "test -s /usr/lib/udev/hwdb.bin",
        # The runner's cmdline_extra reached the kernel the UKI booted.
        "grep -q tine.smoke=1 /proc/cmdline",
        # The guest sees the disk at its output_size, and the partitions it boots from still
        # occupy only the front of it.
        "test $(blockdev --getsize64 /dev/vda) -eq 2147483648",
    ],
)

# System-extension DDI extending :boot-demo: only the delta above the base lands in the
# image, and its extension-release pins the base's ID/VERSION_ID. `boot-demo-vm` exposes
# it under /var/lib/extensions.
image.sysext_image(
    name = "demo-ext",
    base = ":boot-demo",
    packages = ["zsh"],
    install_docs = False,
)

# Replacing a populated directory exercises the opaque-dir marker.
image.layer(
    name = "opaque-base",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        image.run(["/usr/bin/bash", "-c", "mkdir -p /etc/tine/sub; echo old > /etc/tine/sub/old"], chroot = True),
    ],
)

image.layer(
    name = "opaque-child.layer",
    parent = ":opaque-base",
    ops = [
        image.remove("/etc/tine/sub"),
        image.run(["/usr/bin/bash", "-c", "mkdir -p /etc/tine/sub; echo new > /etc/tine/sub/fresh"], chroot = True),
    ],
)

image.archive(
    name = "opaque",
    image = ":opaque-child.layer",
    format = "tar",
)

# The UKI's module selection still carries what the demo image boots through. The smoke proves the
# same thing by booting; this pins it against the real kernel without a VM, so a change to the
# default list that drops one fails here with the module named. Only modules Fedora builds as
# modules: it links dm-mod, ext4, virtio_blk, virtio_pci, ahci and sd_mod into the kernel.
box.sh_test(
    name = "uki-modules-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "@tine//tests:contains.sh",
    args = ["$(location :boot-demo.fedora[uki][modules])"]
    + ['"path": ".*/{}\\.ko'.format(module) for module in ["erofs", "dm-verity", "loop", "overlay", "nvme", "vfat", "virtio_scsi", "virtio_net", "virtiofs"]],
)

# The file manifest is what tells a consumer which paths an image ships, so its framing and its
# view of a real tree are part of the contract rather than an implementation detail. The checker
# is a python file of its own rather than a script the test inlines, so the linters see it.
box.sh_test(
    name = "manifest-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'python3 "$@"',
    args = [
        "$(location :manifest_check.py)",
        "$(location :demo.fedora[manifest])",
    ],
)

box.sh_test(
    name = "boot-artifacts-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "boot-artifacts.sh",
    args = [
        "$(location :boot-demo.fedora[boot][kernel])",
        "$(location :boot-demo.fedora[boot][uki])",
        "$(location :boot-demo.fedora[boot][initrd])",
        "$(location :boot-demo.fedora[initrd])",
    ],
)

# Both distributions, because each package system captures its database in its own format.
box.sh_test(
    name = "pkgdb-format-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "pkgdb-format.sh",
    args = [
        "$(location :demo.fedora[pkgdb])",
        "$(location :demo.arch[pkgdb])",
    ],
)

# A DDI's file name is what a systemd-sysupdate transfer matches, so it is part of the contract
# rather than an implementation detail. The example sets no version, so this pins the rule's
# default alongside the shape.
box.sh_test(
    name = "sysext-name-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'test "$(basename "$1")" = "$2"',
    args = ["$(location :demo-ext.fedora)", "demo-ext_0_x86-64.sysext.raw"],
)

# Compare the current builds to the checksums in ./expected.json to validate reproducibility: between
# local developer machine and GitHub runner, at different times. The image does not have any external
# input (such as a git-derived version) and hence should only change with zsh (on catalog updates) or
# build rule updates. When one of those moved it legitimately, record the new checksums with
# `buck run tine//examples/image:refresh-expected` and commit them with the change that moved them.
box.sh_test(
    name = "reproducibility-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'printf "%s\\n" "$@" | sha256sum --check --strict --quiet',
    # Sorted, so the command line stays put when an entry is added and Buck reuses its cached run.
    args = ["{}  $(location :{})".format(_expected[name]["sha256"], name) for name in sorted(_expected)],
)

tine_python_binary(
    name = "refresh-expected",
    main = "expected.py",
    deps = ["@tine//:util"],
)
