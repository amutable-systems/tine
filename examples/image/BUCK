"""Image construction smoke targets.

Every image here is declared once and built for each distribution the PACKAGE file declares. What
varies is the package manager, chosen by a `select()` on the distribution constraint, and the
package sets that manager resolves; the operations themselves are the same either way. No
distribution is the default, so what a build names is one of the per-distribution aliases each
image rule declares for itself.
"""

load("@tine//distribution:defs.bzl", "distribution_alias", "distribution_compatibility", "distributions_for_package")
load(
    "@tine//image:defs.bzl",
    "DEFAULT_USR_VERITY_PARTITIONS",
    "bootable_disk_image",
    "copy",
    "image",
    "image_archive",
    "image_vm",
    "mkdir",
    "python",
    "remove",
    "rootfs_archive",
    "run",
    "sysext_image",
    "uki_profile",
)
load("@tine//package:manager.bzl", "package_manager")

# Everything a distribution decides is described in the PACKAGE file, which is the one place a
# distribution is added; nothing below names one.
DISTRIBUTIONS = distributions_for_package()

# Consumer-owned solve context; project repositories can be added here. Which release it derives
# from is the one thing a distribution decides for an image, so it is the only select below.
package_manager(
    name = "image.package-manager",
    base = select({d["distribution"]: d["package_manager"] for d in DISTRIBUTIONS.values()}),
)

# A build artifact a command names through $(location), chrooted or not.
export_file(
    name = "marker.txt",
    src = "marker.txt",
)

export_file(
    name = "configure.sh",
    src = "configure.sh",
)

export_file(
    name = "configure.py",
    src = "configure.py",
)

# Minimal install + ordered-ops demo. `:demo` is both the tar result and a logical image.
rootfs_archive(
    name = "demo",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        run(["/usr/bin/mkdir", "-p", "/buildroot/etc/tine"]),
        run(["/usr/bin/cp", "$(location :marker.txt)", "/buildroot/etc/tine/from-location"]),
        # copy() takes a source directly, so it needs no $(location) around the label.
        copy(":marker.txt", "/etc/tine/from-copy"),
        # A chrooted command runs with the image's own binaries. Buck's macro parser claims
        # `$(...)`, so the shell substitution is escaped.
        run(["/usr/bin/bash", "-c", "echo built-by-\\$(echo tine) > /etc/tine/marker"], chroot = True),
        # A repository-owned script, run inside the image. The project is mounted there, so
        # `$(location)` names the script and its data exactly as it would outside.
        run(
            [
                "/usr/bin/bash",
                "$(location :configure.sh)",
                "$(location :marker.txt)",
                "from-script-argument",
            ],
            chroot = True,
        ),
        # The same, in python, which this image does not install: the interpreter is Buck's own.
        python(["$(location :configure.py)", "$(location :marker.txt)", "from-python-argument"], chroot = True),
        # Unchrooted, the same interpreter sees the image at /buildroot, like any engine command.
        python(["-c", "from pathlib import Path; Path('/buildroot/etc/tine/from-python-engine').write_text('x\\n')"]),
    ],
    format = "tar",
)

# Base-only image exercising a single-component delta stack.
rootfs_archive(
    name = "base",
    package_manager = ":image.package-manager",
    packages = ["bash"],
    format = "tar",
)

# Chained images: the child adds one file and whiteouts another.
image(
    name = "chained-base",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        mkdir("/etc/tine"),
        run(
            [
                "/usr/bin/bash",
                "-c",
                "echo base > /etc/tine/from-base-kept; echo base > /etc/tine/from-base-gone",
            ],
            chroot = True,
        ),
    ],
)

image(
    name = "chained-child.layer",
    parent = ":chained-base",
    ops = [
        run(["/usr/bin/bash", "-c", "echo child > /etc/tine/from-child"], chroot = True),
        remove("/etc/tine/from-base-gone"),
    ],
)

image_archive(
    name = "chained",
    image = ":chained-child.layer",
    format = "tar",
)

# Package installation and mutations sharing one physical delta.
image(
    name = "layered-install-base",
    package_manager = ":image.package-manager",
    packages = ["bash"],
    ops = [
        run(["/usr/bin/bash", "-c", "echo base > /etc/from-base-install"], chroot = True),
    ],
)

image(
    name = "layered-install.layer",
    parent = ":layered-install-base",
    packages = ["coreutils"],
    ops = [
        run(["/usr/bin/bash", "-c", "ls /usr/bin/ls > /etc/from-child-install"], chroot = True),
    ],
)

image_archive(
    name = "layered-install",
    image = ":layered-install.layer",
    format = "tar",
)

# Round-trip an escaped name and an escaped whiteout through stored deltas.
image(
    name = "escaped-base",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        mkdir("/etc/tine"),
        run(
            [
                "/usr/bin/bash",
                "-c",
                "echo kept > '/etc/tine/esc\\x2dkept'; echo gone > '/etc/tine/esc\\x2dgone'",
            ],
            chroot = True,
        ),
    ],
)

image(
    name = "escaped-child.layer",
    parent = ":escaped-base",
    ops = [remove("/etc/tine/esc\\x2dgone")],
)

image_archive(
    name = "escaped",
    image = ":escaped-child.layer",
    format = "tar",
)

# Bootable GPT image; `buck run :boot-demo-vm` starts it with the engine's vmspawn stack.
# Supply-chain and format subtargets such as `:boot-demo[sbom]` and `:boot-demo[qcow2]` build on demand.
# The version stamps os-release, partition labels, and the UKI and disk file names; inject a real
# one with `-c demo.image-version=...` (see "Image versioning" in images.md).
bootable_disk_image(
    name = "boot-demo",
    package_manager = ":image.package-manager",
    definitions = DEFAULT_USR_VERITY_PARTITIONS,
    version = read_config("demo", "image-version", "unversioned"),
    # The release names what a bootable system of its own family needs, so this stays symbolic.
    # The composition generates the databases those packages only describe, hwdb's among them.
    package_sets = ["bootable"],
    packages = ["less"],
    profiles = [
        uki_profile(
            id = "debug",
            title = "Boot with debug logs enabled",
            cmdline = ["debug", "systemd.log_level=debug", "systemd.journald.forward_to_console=1"],
        ),
    ],
    # Arbitrary declared artifacts can be shipped through the ESP.
    esp_files = {"/boot/metadata/demo.spdx.json": ":demo[sbom][spdx]"},
    # A shipped appliance has no terminal to read a man page on.
    install_docs = False,
    # Ship the disk with free space past its partitions, so an installed system can claim it without
    # resizing the medium first. The space is sparse and this image boots from tmpfs, so nothing here
    # consumes it; a real appliance creates a root partition in it on first boot.
    output_size = "2G",
)

image_vm(
    name = "boot-demo-vm",
    autologin = "root",
    # A run-only kernel command line argument: the UKI carries a fixed one, so this can only arrive
    # through the channel vmspawn picks for its trailing arguments. The smoke asserts it landed.
    cmdline_extra = ["tine.smoke=1"],
    credentials = {
        "firstboot.locale": "C.UTF-8",
        "firstboot.timezone": "UTC",
    },
    # The runner's engine is independent of the image's, so every distribution boots under the
    # same harness and the VM stack is built once rather than per release.
    engine = "tine//catalog:fedora.rawhide.engine",
    image = ":boot-demo",
    sysexts = [":demo-ext"],
)

# Boot smoke test: drives :boot-demo-vm's console over a pty (via the shared tine driver),
# asserts the system settles, then powers off. `buck run :boot-demo-vm-smoke` runs it locally and in CI.
command_alias(
    name = "boot-demo-vm-smoke",
    # A prelude rule, so unlike the image rules it has no tine macro to inherit the package's
    # distributions through and has to ask for them.
    target_compatible_with = distribution_compatibility(),
    # exe_target, not exe: the runner is data for the driver, not a host tool, so keep it in the
    # target configuration and reuse the image `buck build :boot-demo` already produced (exe would
    # pull it into the exec configuration and rebuild it).
    args = [
        # The distribution that booted is the one that was asked for. A select reaches here through
        # the alias below, which configures this target too.
        "--check",
        select({d["distribution"]: "grep -q '^ID={}$' /etc/os-release".format(d["os_release_id"]) for d in DISTRIBUTIONS.values()}),
        "--check",
        "bootctl | grep -F 'Secure Boot: disabled (setup)'",
        # The build compiled the hardware database into /usr, which is read-only here, so a guest
        # that has it got it from the build rather than from a boot-time regeneration.
        "--check",
        "test -s /usr/lib/udev/hwdb.bin",
        # The runner's cmdline_extra reached the kernel the UKI booted.
        "--check",
        "grep -q tine.smoke=1 /proc/cmdline",
        # The guest sees the disk at its output_size, and the partitions it boots from still
        # occupy only the front of it.
        "--check",
        # Buck's macro parser claims $(...), so the shell substitution is escaped.
        "test \\$(blockdev --getsize64 /dev/vda) -eq 2147483648",
        "$(exe_target :boot-demo-vm)",
    ],
    exe = "tine//tests:boot-smoke",
)

# The image rules name themselves per distribution. This one is a prelude rule, so it says so here.
[
    distribution_alias(
        name = "boot-demo-vm-smoke." + suffix,
        actual = ":boot-demo-vm-smoke",
        distribution = DISTRIBUTIONS[suffix]["distribution"],
    )
    for suffix in sorted(DISTRIBUTIONS)
]

# System-extension DDI extending :boot-demo: only the delta above the base lands in the
# image, and its extension-release pins the base's ID/VERSION_ID. `boot-demo-vm` exposes
# it under /var/lib/extensions.
sysext_image(
    name = "demo-ext",
    base = ":boot-demo",
    packages = ["zsh"],
    install_docs = False,
)

# Replacing a populated directory exercises the opaque-dir marker.
image(
    name = "opaque-base",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        run(["/usr/bin/bash", "-c", "mkdir -p /etc/tine/sub; echo old > /etc/tine/sub/old"], chroot = True),
    ],
)

image(
    name = "opaque-child.layer",
    parent = ":opaque-base",
    ops = [
        remove("/etc/tine/sub"),
        run(["/usr/bin/bash", "-c", "mkdir -p /etc/tine/sub; echo new > /etc/tine/sub/fresh"], chroot = True),
    ],
)

image_archive(
    name = "opaque",
    image = ":opaque-child.layer",
    format = "tar",
)
