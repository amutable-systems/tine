"""Image construction smoke targets."""

load("@tine//image:boot.bzl", "uki_profile")
load("@tine//image:compose.bzl", "bootable_disk_image", "rootfs_archive", "sysext_image")
load("@tine//image:layer.bzl", "image", "image_layer", "install", "mkdir", "remove", "run")
load("@tine//image:vm.bzl", "image_vm")
load("@tine//image_format:archive.bzl", "image_archive")
load("@tine//image_format:disk.bzl", "DEFAULT_USR_VERITY_PARTITIONS")
load("@tine//image_format:sbom.bzl", "image_sbom")
load("@tine//package:manager.bzl", "package_manager")

# Consumer-owned solve context; project repositories can be added here.
package_manager(
    name = "image.package-manager",
    base = "tine//catalog:fedora.rawhide.package-manager",
)

# Minimal install + ordered-ops demo. `:demo` is the tar; `:demo.layer` is the logical image.
# `rpmdb = True` also captures the trimmed rpm database on a normal build (`:demo[rpmdb]`).
rootfs_archive(
    name = "demo",
    package_manager = ":image.package-manager",
    ops = [
        run(["/usr/bin/mkdir", "-p", "/buildroot/etc/tine"], chroot = False),
        install(["bash", "coreutils"]),
        run(["/usr/bin/bash", "-c", "echo built-by-tine > /etc/tine/marker"]),
    ],
    format = "tar",
    rpmdb = True,
)

# Base-only image exercising a single-component delta stack.
rootfs_archive(
    name = "base",
    package_manager = ":image.package-manager",
    ops = [install(["bash"])],
    format = "tar",
)

# Chained layers: the child adds one file and whiteouts another.
image(
    name = "chained.image",
    package_manager = ":image.package-manager",
)

image_layer(
    name = "chained-base",
    parent = ":chained.image",
    ops = [
        install(["bash", "coreutils"]),
        mkdir("/etc/tine"),
        run(["/usr/bin/bash", "-c", "echo base > /etc/tine/from-base-kept; echo base > /etc/tine/from-base-gone"]),
    ],
)

image_layer(
    name = "chained-child.layer",
    parent = ":chained-base",
    ops = [
        run(["/usr/bin/bash", "-c", "echo child > /etc/tine/from-child"]),
        remove("/etc/tine/from-base-gone"),
    ],
)

image_archive(
    name = "chained",
    image = ":chained-child.layer",
    format = "tar",
)

# Package installation and mutations sharing one physical delta.
image(
    name = "layered-install.image",
    package_manager = ":image.package-manager",
)

image_layer(
    name = "layered-install-base",
    parent = ":layered-install.image",
    ops = [
        install(["bash"]),
        run(["/usr/bin/bash", "-c", "echo base > /etc/from-base-install"]),
    ],
)

image_layer(
    name = "layered-install.layer",
    parent = ":layered-install-base",
    ops = [
        install(["coreutils"]),
        run(["/usr/bin/bash", "-c", "ls /usr/bin/ls > /etc/from-child-install"]),
    ],
)

image_archive(
    name = "layered-install",
    image = ":layered-install.layer",
    format = "tar",
)

# Round-trip an escaped name and an escaped whiteout through stored deltas.
image(
    name = "escaped.image",
    package_manager = ":image.package-manager",
)

image_layer(
    name = "escaped-base",
    parent = ":escaped.image",
    ops = [
        install(["bash", "coreutils"]),
        mkdir("/etc/tine"),
        run(["/usr/bin/bash", "-c", "echo kept > '/etc/tine/esc\\x2dkept'; echo gone > '/etc/tine/esc\\x2dgone'"]),
    ],
)

image_layer(
    name = "escaped-child.layer",
    parent = ":escaped-base",
    ops = [remove("/etc/tine/esc\\x2dgone")],
)

image_archive(
    name = "escaped",
    image = ":escaped-child.layer",
    format = "tar",
)

# Bootable GPT image; `buck run :boot-demo-vm` starts it with the engine's vmspawn stack.
# `rpmdb`/`sbom` expose the supply-chain facets: `:boot-demo[rpmdb]` and `:boot-demo[sbom]`. The raw
# disk re-encodes on demand as `:boot-demo[qcow2]` and `:boot-demo[raw.zst]`.
bootable_disk_image(
    name = "boot-demo",
    package_manager = ":image.package-manager",
    definitions = DEFAULT_USR_VERITY_PARTITIONS,
    ops = [
        install([
            "kernel-core",
            "systemd",
            "systemd-udev",
            "systemd-boot-unsigned",
            "fedora-release",
            "bash",
            "coreutils",
            "util-linux",
            "dbus-broker",
        ]),
    ],
    profiles = [
        uki_profile(
            id = "debug",
            title = "Boot with debug logs enabled",
            cmdline = ["debug", "systemd.log_level=debug", "systemd.journald.forward_to_console=1"],
        ),
    ],
    # Example for manually handled sysext DDI shipped via the ESP, in a systemd `.v/` versioned directory
    # (systemd.v(7)) for handling with systemd-sysupdate
    esp_files = {"/boot/extensions/demo-ext.raw.v/demo-ext_0_x86-64.raw": ":demo-ext"},
    # A shipped appliance has no terminal to read a man page on.
    install_docs = False,
    rpmdb = True,
    sbom = True,
)

image_vm(
    name = "boot-demo-vm",
    autologin = "root",
    credentials = {
        "firstboot.locale": "C.UTF-8",
        "firstboot.timezone": "UTC",
    },
    image = ":boot-demo",
    sysexts = [":demo-ext"],
)

# Boot smoke test: drives :boot-demo-vm's console over a pty (via the shared tine driver),
# asserts the system settles, then powers off. `buck run :boot-demo-vm-smoke` runs it locally and in CI.
command_alias(
    name = "boot-demo-vm-smoke",
    # exe_target, not exe: the runner is data for the driver, not a host tool, so keep it in the
    # target configuration and reuse the image `buck build :boot-demo` already produced (exe would
    # pull it into the exec configuration and rebuild it).
    args = ["$(exe_target :boot-demo-vm)"],
    exe = "tine//tests:boot-smoke",
)

# System-extension DDI extending :boot-demo: only the delta above the base lands in the
# image, and its extension-release pins the base's ID/VERSION_ID. `boot-demo-vm` exposes
# it under /var/lib/extensions.
sysext_image(
    name = "demo-ext",
    base = ":boot-demo.layer",
    ops = [install(["zsh"])],
    install_docs = False,
    rpmdb = True,
)

# Replacing a populated directory exercises the opaque-dir marker.
image(
    name = "opaque.image",
    package_manager = ":image.package-manager",
)

image_layer(
    name = "opaque-base",
    parent = ":opaque.image",
    ops = [
        install(["bash", "coreutils"]),
        run(["/usr/bin/bash", "-c", "mkdir -p /etc/tine/sub; echo old > /etc/tine/sub/old"]),
    ],
)

image_layer(
    name = "opaque-child.layer",
    parent = ":opaque-base",
    ops = [
        remove("/etc/tine/sub"),
        run(["/usr/bin/bash", "-c", "mkdir -p /etc/tine/sub; echo new > /etc/tine/sub/fresh"]),
    ],
)

image_archive(
    name = "opaque",
    image = ":opaque-child.layer",
    format = "tar",
)

# Standalone SBOM generation: the `image_sbom` rule used directly on a layer, as opposed to the
# `sbom = True` ride-along on `:boot-demo`. Runs against the quick `:demo.layer` as a cheap smoke
# test. Emits both SPDX and CycloneDX; `:demo-sbom` builds both.
image_sbom(
    name = "demo-sbom",
    image = ":demo.layer",
    # SBOM source version; also seeds the stable document id used for reproducible normalization.
    # Defaults to "0".
    version = "1.2.3",
)
