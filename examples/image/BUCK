"""Image construction smoke targets.

Every image here is declared once and built for each distribution the PACKAGE file declares. What
varies is the package manager, chosen by a `select()` on the distribution constraint, and the
package sets that manager resolves; the operations themselves are the same either way. No
distribution is the default, so what a build names is one of the per-distribution aliases each
image rule declares for itself.
"""

load("@tine//box:defs.bzl", "box")
load("@tine//distribution:defs.bzl", "distribution")
load("@tine//image:defs.bzl", "image")
load("@tine//package:defs.bzl", "package")
load("@tine//platforms:architecture.bzl", "ARCHITECTURES", "architecture")
load("@tine//python:defs.bzl", "box_python_binary")
load("@tine//tests:defs.bzl", "tests")
load(":expected.json", _expected = "value")

# Everything a distribution decides is described in the PACKAGE file, which is the one place a
# distribution is added; nothing below names one.
DISTRIBUTIONS = distribution.for_package()

# Consumer-owned solve context; project repositories can be added here. Which release it derives
# from is the one thing a distribution decides for an image, so it is the only select below.
package.manager(
    name = "image.package-manager",
    base = distribution.select({name: d["package_manager"] for name, d in DISTRIBUTIONS.items()}),
)

# A build artifact a command names through $(location), chrooted or not.
export_file(
    name = "marker.txt",
    src = "marker.txt",
)

export_file(
    name = "configure.sh",
    src = "configure.sh",
)

export_file(
    name = "configure.py",
    src = "configure.py",
)

export_file(
    name = "manifest_check.py",
    src = "manifest_check.py",
)

export_file(
    name = "reproducibility_check.py",
    src = "reproducibility_check.py",
)

# Minimal install + ordered-ops demo. `:demo` is both the tar result and a logical image.
image.archive(
    name = "demo",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"]
    # Some extra coverage for distribution.select().
    + distribution.select({
        "arch": ["archlinux-keyring"],
        "fedora": ["fedora-gpg-keys"],
    }),
    ops = [
        image.ops.run(["/usr/bin/mkdir", "-p", "/buildroot/etc/tine"]),
        image.ops.run(["/usr/bin/cp", "$(location :marker.txt)", "/buildroot/etc/tine/from-location"]),
        # image.ops.copy() takes a source directly, so it needs no $(location) around the label.
        image.ops.copy(":marker.txt", "/etc/tine/from-copy"),
        # A chrooted command runs with the image's own binaries. Buck's macro parser claims
        # `$(...)`, so the shell substitution is escaped.
        image.ops.run(["/usr/bin/bash", "-c", "echo built-by-\\$(echo tine) > /etc/tine/marker"], chroot = True),
        # A repository-owned script, run inside the image. The project is mounted there, so
        # `$(location)` names the script and its data exactly as it would outside.
        image.ops.run(
            [
                "/usr/bin/bash",
                "$(location :configure.sh)",
                "$(location :marker.txt)",
                "from-script-argument",
            ],
            chroot = True,
        ),
        # The same, in python, which this image does not install: the interpreter is Buck's own.
        image.ops.python(["$(location :configure.py)", "$(location :marker.txt)", "from-python-argument"], chroot = True),
        # Unchrooted, the same interpreter sees the image at /buildroot, like any box command.
        image.ops.python(["-c", "from pathlib import Path; Path('/buildroot/etc/tine/from-python-box').write_text('x\\n')"]),
        # Ensure we don't leak the /tine sandbox mount into image builds
        image.ops.run(["/usr/bin/test", "!", "-d", "/tine"], chroot = True),
    ],
    format = "tar",
)

# Base-only image exercising a single-component delta stack.
image.archive(
    name = "base",
    package_manager = ":image.package-manager",
    packages = ["bash"],
    format = "tar",
)

# Chained images: the child adds one file and whiteouts another.
image.layer(
    name = "chained-base",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        image.ops.write_file("/etc/tine/from-base-kept", "base"),
        image.ops.write_file("/etc/tine/from-base-gone", "base"),
    ],
)

image.layer(
    name = "chained-child.layer",
    parent = ":chained-base",
    ops = [
        image.ops.write_file("/etc/tine/from-child", "child"),
        image.ops.remove("/etc/tine/from-base-gone"),
    ],
)

image.archive(
    name = "chained",
    parent = ":chained-child.layer",
    format = "tar",
)

# Package installation and mutations sharing one physical delta.
image.layer(
    name = "layered-install-base",
    package_manager = ":image.package-manager",
    packages = ["bash"],
    ops = [
        image.ops.run(["/usr/bin/bash", "-c", "echo base > /etc/from-base-install"], chroot = True),
    ],
)

image.layer(
    name = "layered-install.layer",
    parent = ":layered-install-base",
    packages = ["coreutils"],
    ops = [
        image.ops.run(["/usr/bin/bash", "-c", "ls /usr/bin/ls > /etc/from-child-install"], chroot = True),
    ],
)

image.archive(
    name = "layered-install",
    parent = ":layered-install.layer",
    format = "tar",
)

# Round-trip an escaped name and an escaped whiteout through stored deltas.
image.layer(
    name = "escaped-base",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        image.ops.mkdir("/etc/tine"),
        image.ops.run(
            [
                "/usr/bin/bash",
                "-c",
                "echo kept > '/etc/tine/esc\\x2dkept'; echo gone > '/etc/tine/esc\\x2dgone'",
            ],
            chroot = True,
        ),
    ],
)

image.layer(
    name = "escaped-child.layer",
    parent = ":escaped-base",
    ops = [image.ops.remove("/etc/tine/esc\\x2dgone")],
)

image.archive(
    name = "escaped",
    parent = ":escaped-child.layer",
    format = "tar",
)

# Bootable GPT image; `buck run :boot-demo-vm` starts it with the box's vmspawn stack.
# Supply-chain and format subtargets such as `:boot-demo[sbom]` and `:boot-demo[qcow2]` build on demand.
# The version stamps os-release, partition labels, and the UKI and disk file names. A product names
# one here, or asks for a git-derived one with `version = "auto:1.4.2"`, which needs a build through
# `bin/tine` (see "Image versioning" in images.md); this demo has nothing to version.
image.bootable_disk(
    name = "boot-demo",
    package_manager = ":image.package-manager",
    definitions = image.DEFAULT_USR_VERITY_PARTITIONS,
    version = "unversioned",
    # The release names what a bootable system of its own family needs, so this stays symbolic.
    # The composition generates the databases those packages only describe, hwdb's among them.
    package_sets = ["bootable"],
    packages = ["grep", "less"]
    # Microcode is a package like any other; the UKI driver packs whatever vendor blobs the image
    # ends up shipping. Only x86 has any, and only x86 mirrors carry the packages.
    + architecture.select({
        "arm64": [],
        "x86_64": distribution.select({
            "arch": ["amd-ucode", "intel-ucode"],
            "fedora": ["amd-ucode-firmware", "microcode_ctl"],
        }),
    }),
    profiles = [
        image.uki_profile(
            id = "debug",
            title = "Boot with debug logs enabled",
            cmdline = ["debug", "systemd.log_level=debug", "systemd.journald.forward_to_console=1"],
        ),
    ],
    # Arbitrary declared artifacts can be shipped through the ESP.
    esp_files = {"/boot/metadata/demo.spdx.json": ":demo[sbom][spdx]"},
    # An absolute path names a BMP the image itself ships, here the one Arch's systemd package
    # installs; the other distributions ship no BMP and embed none.
    splash = distribution.select({"arch": "/usr/share/systemd/bootctl/splash-arch.bmp"}, default = None),
    # A shipped appliance has no terminal to read a man page on.
    install_docs = False,
    # Ship the qcow2 with free space past its partitions, so a VM booting it can claim it without
    # resizing the disk first. This image boots from tmpfs, so nothing here consumes it; a real
    # appliance creates a root partition in it on first boot.
    virtual_size = "2G",
)

image.vm(
    name = "boot-demo-vm",
    autologin = "root",
    # A run-only kernel command line argument: the UKI carries a fixed one, so this can only arrive
    # through the channel vmspawn picks for its trailing arguments. The smoke asserts it landed.
    cmdline_extra = ["tine.smoke=1"],
    credentials = {
        "firstboot.locale": "C.UTF-8",
        "firstboot.timezone": "UTC",
    },
    # The runner's box is independent of the image's, so every distribution boots under the
    # same harness and the VM stack is built once rather than per release.
    box = "tine//catalog:fedora.rawhide.box",
    image = ":boot-demo",
    sysexts = [":demo-ext"],
)

# Boot smoke test: drives :boot-demo-vm's console over a pty (via the shared tine driver),
# asserts the system settles, then powers off. `buck test` runs it, `buck run` boots it by hand.
tests.vm_smoke(
    name = "boot-demo-vm-smoke",
    vm = ":boot-demo-vm",
    checks = [
        # The distribution that booted is the one that was asked for. A select reaches here through
        # the alias the macro declares, which configures this target too. This reads the file the
        # build produced rather than the `/etc` symlink to it: a `/usr`-only disk boots with a
        # volatile root, and whether anything recreates that symlink is a property of the
        # distribution's own systemd rather than of the image.
        distribution.select({name: "grep -q '^ID={}$' /usr/lib/os-release".format(d["os_release_id"]) for name, d in DISTRIBUTIONS.items()}),
        "bootctl | grep -F 'Secure Boot: disabled (setup)'",
        # The build compiled the hardware database into /usr, which is read-only here, so a guest
        # that has it got it from the build rather than from a boot-time regeneration.
        "test -s /usr/lib/udev/hwdb.bin",
        # The runner's cmdline_extra reached the kernel the UKI booted.
        "grep -q tine.smoke=1 /proc/cmdline",
        # The initrd carries networkd for IMDS, which is inert on a non-cloud VM.
        '[ -z "$(journalctl -b -q _RUNTIME_SCOPE=initrd _SYSTEMD_UNIT=systemd-networkd.service)" ]',
    ],
)

# The qcow2 describes a disk of the image's virtual_size, while the raw stays as small as its partitions.
box.sh_test(
    name = "virtual-size-test",
    labels = ["image"],
    box = "@tine//catalog:fedora.rawhide.box",
    script = """
test "$(qemu-img info --output=json "$1" | python3 -c 'import json, sys; print(json.load(sys.stdin)["virtual-size"])')" = 2147483648
test "$(stat -c %s "$2")" -lt $((900 << 20))
""",
    args = ["$(location :boot-demo.fedora[qcow2])", "$(location :boot-demo.fedora)"],
)

# System-extension DDI extending :boot-demo: only the delta above the base lands in the
# image, and its extension-release pins the base's ID/VERSION_ID. `boot-demo-vm` exposes
# it under /var/lib/extensions.
image.sysext(
    name = "demo-ext",
    base = ":boot-demo",
    packages = ["zsh"],
    install_docs = False,
    # install a file from source tree; covers reproducibility check under varying umasks
    ops = [image.ops.copy("from-source.txt", "/usr/lib/tine/from-source")],
)

# demo-confext contains only /etc. Its extension-release file pins the ID and VERSION_ID of
# boot-demo, as the one of demo-ext does.
image.confext(
    name = "demo-confext",
    base = ":boot-demo",
    ops = [image.ops.write_file("/etc/tine/from-confext", "confext\n")],
)

# portablectl attaches only the units whose names start with the image name, so the service is
# called demo-portable.service.
image.portable(
    name = "demo-portable",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    install_docs = False,
    ops = [image.ops.copy("demo-portable.service", "/usr/lib/systemd/system/demo-portable.service")],
)

# demo-portable.service fails unless it finds the files that demo-portable-ext adds to /usr and
# /etc. systemd merges only /usr, /opt and /etc of an extension, so the extension DDI does not
# contain the file that demo-portable-ext writes to /var. A portable service that needs a directory
# under /var must find it in the portable image.
image.extension(
    name = "demo-portable-ext",
    base = ":demo-portable",
    classes = ["sysext", "confext"],
    scope = ["portable"],
    ops = [
        image.ops.write_file("/usr/lib/tine/from-portable-ext", "usr\n"),
        image.ops.write_file("/etc/tine/from-portable-ext", "etc\n"),
        image.ops.write_file("/var/lib/tine/from-portable-ext", "var\n"),
    ],
)

# A file tree that differs per distribution is one copy whose source is a select, rather than a
# target per distribution and an alias choosing between them. A distribution the select names no
# tree for gets `None`, which copies nothing; only arch ships one so every other exercises that.
image.layer(
    name = "tree.layer",
    parent = ":base",
    ops = [
        image.ops.copy("tree/os", "/"),
        image.ops.copy(distribution.select({"arch": "tree/os.arch"}, default = None), "/"),
    ],
)

image.archive(
    name = "tree",
    parent = ":tree.layer",
    format = "tar",
)

# Once per distribution the PACKAGE file declares, so the test sees the select choose the arch tree
# and none for the rest, whichever those are.
box.sh_test(
    name = "tree-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "tree-test.sh",
    args = ["$(location :tree)"] + distribution.select({name: [name if name == "arch" else "none"] for name in DISTRIBUTIONS}),
    **distribution.distributed("tree-test"),
)

# Replacing a populated directory exercises the opaque-dir marker.
image.layer(
    name = "opaque-base",
    package_manager = ":image.package-manager",
    packages = ["bash", "coreutils"],
    ops = [
        image.ops.run(["/usr/bin/bash", "-c", "mkdir -p /etc/tine/sub; echo old > /etc/tine/sub/old"], chroot = True),
    ],
)

image.layer(
    name = "opaque-child.layer",
    parent = ":opaque-base",
    ops = [
        image.ops.remove("/etc/tine/sub"),
        image.ops.run(["/usr/bin/bash", "-c", "mkdir -p /etc/tine/sub; echo new > /etc/tine/sub/fresh"], chroot = True),
    ],
)

image.archive(
    name = "opaque",
    parent = ":opaque-child.layer",
    format = "tar",
)

# The UKI's module selection still carries what the demo image boots through. The smoke proves the
# same thing by booting; this pins it against the real kernel without a VM, so a change to the
# default list that drops one fails here with the module named. Only modules Fedora builds as
# modules: it links dm-mod, ext4, virtio_blk, virtio_pci, ahci and sd_mod into the kernel.
box.sh_test(
    name = "uki-modules-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "@tine//tests:contains.sh",
    args = ["$(location :boot-demo.fedora[uki][modules])"]
    + [
        '"path": ".*/{}\\.ko'.format(module)
        for module in ["erofs", "dm-verity", "ena", "loop", "overlay", "nvme", "vfat", "virtio_scsi", "virtio_net", "virtiofs"]
    ],
)

# The file manifest is what tells a consumer which paths an image ships, so its framing and its
# view of a real tree are part of the contract rather than an implementation detail. The checker
# is a python file of its own rather than a script the test inlines, so the linters see it.
box.sh_test(
    name = "manifest-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'python3 "$@"',
    args = [
        "$(location :manifest_check.py)",
        "$(location :demo.fedora[manifest])",
    ],
)

box.sh_test(
    name = "boot-artifacts-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "boot-artifacts.sh",
    args = [
        "$(location :boot-demo.fedora[boot][kernel])",
        "$(location :boot-demo.fedora[boot][uki])",
        "$(location :boot-demo.fedora[boot][initrd])",
        "$(location :boot-demo.fedora[initrd])",
    ]
    + architecture.select({name: [name] for name in ARCHITECTURES}),
)

# The splash the image ships reached the UKI. The image tools' box carries ukify, which lists a
# UKI's sections one per `.name:` line.
box.sh_test(
    name = "uki-splash-test",
    labels = ["image"],
    box = "@tine//catalog:fedora.rawhide.box",
    script = 'test "$(ukify inspect "$1" | grep -cx ".splash:")" = "$2"',
    args = ["$(location :boot-demo[boot][uki])"] + distribution.select({"arch": ["1"]}, default = ["0"]),
    **distribution.distributed("uki-splash-test"),
)

# The microcode the image installs reached the UKI, which only an x86 kernel takes that way. The
# image tools' box carries the ukify the checker reads sections with.
box.sh_test(
    name = "uki-microcode-test",
    labels = ["image"],
    box = "@tine//catalog:fedora.rawhide.box",
    test = "uki-microcode.sh",
    args = ["$(location :boot-demo.fedora[boot][uki])"] + architecture.select({name: [name] for name in ARCHITECTURES}),
)

# Once per distribution, because each package system captures its database in its own format.
box.sh_test(
    name = "pkgdb-format-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "pkgdb-format.sh",
    args = ["$(location :demo[pkgdb])"] + distribution.select({"arch": ["tar.zst", "alpm"], "debian": ["tar.zst", "dpkg"], "fedora": ["sqlite", "rpm"]}),
    **distribution.distributed("pkgdb-format-test"),
)

# A DDI's file name is what a systemd-sysupdate transfer matches, so it is part of the contract
# rather than an implementation detail. The example sets no version, so this pins the rule's
# default alongside the shape; the architecture is spelled the way systemd's `%a` does.
box.sh_test(
    name = "sysext-name-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'test "$(basename "$1")" = "$2" && test "$(basename "$3")" = "$4"',
    args = ["$(location :demo-ext.fedora)"]
    + architecture.select({name: ["demo-ext_0_{}.sysext.raw".format(spellings.systemd)] for name, spellings in ARCHITECTURES.items()})
    + ["$(location :demo-confext.fedora)"]
    + architecture.select({name: ["demo-confext_0_{}.confext.raw".format(spellings.systemd)] for name, spellings in ARCHITECTURES.items()}),
)

# portablectl takes the image name from the DDI's file name, up to the first "_", and matches the
# units it attaches against that name.
box.sh_test(
    name = "portable-name-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'test "$(basename "$1")" = "$2" && test "$(basename "$3")" = "$4"',
    args = ["$(location :demo-portable.fedora)"]
    + architecture.select({name: ["demo-portable_0_{}.raw".format(spellings.systemd)] for name, spellings in ARCHITECTURES.items()})
    + ["$(location :demo-portable-ext.fedora)"]
    + architecture.select({name: ["demo-portable-ext_0_{}.raw".format(spellings.systemd)] for name, spellings in ARCHITECTURES.items()}),
)

# The portable image contains its os-release and no extension-release files. The extension contains
# extension-release files, no os-release, and none of the files of demo-portable.
box.sh_test(
    name = "portable-manifest-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    test = "portable-manifest.sh",
    args = [
        "$(location :demo-portable.fedora[disk-manifest])",
        "$(location :demo-portable-ext.fedora[disk-manifest])",
    ],
)

# [NAME, DIGEST, PATH] for each target expected.json tracks, per architecture. Sorted, so the command line
# of reproducibility-test stays put when an entry is added and Buck reuses its cached run.
_reproducibility_targets = {
    arch: [(name, digests[name]["sha256"], "$(location :{})".format(name)) for name in sorted(digests)] for arch, digests in _expected.items()
}

# Compare the current builds to the checksums in ./expected.json to validate reproducibility: between
# local developer machine and GitHub runner, at different times. Neither image has an external input
# such as a git-derived version, so a digest only moves when the catalog pins a package the image
# carries or a build rule changes what it writes. When one of those moved it legitimately, take over
# the digests a failure writes with `buck run tine//examples/image:refresh-expected` and commit them
# with the change that moved them.
box.sh_test(
    name = "reproducibility-test",
    labels = ["image"],
    box = "@tine//tools:dev.box",
    script = 'python3 "$@"',
    # the architecture, where a failure writes its actual digests, then the targets
    args = ["$(location :reproducibility_check.py)"]
    + architecture.select({
        arch: [arch, "{}/actual.{}.json".format(package_name(), arch)] + [item for target in targets for item in target]
        for arch, targets in _reproducibility_targets.items()
    }),
)

box_python_binary(
    name = "refresh-expected",
    box = "@tine//tools:dev.box",
    main = "expected.py",
    deps = ["@tine//:util"],
)
