"""The distributions the images in this package are built for.

The one place a distribution is named. What each is called here names its targets (`:demo.arch`)
and is what a build has to choose between: naming no distribution is not a build, so `//...` skips
these images and building one by its bare name says so rather than picking one. Each entry's release
selects the package manager the images solve with.
"""

load("@tine//distribution:defs.bzl", "distribution")

distribution.set_for_package({
    "arch": {
        "release": "arch.rolling",
        "os_release_id": "arch",
    },
    "debian": {
        "release": "debian.testing",
        "os_release_id": "debian",
    },
    "fedora": {
        "release": "fedora.rawhide",
        "os_release_id": "fedora",
    },
})
