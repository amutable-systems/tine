#!/usr/bin/python3 -SIB
"""Run tine from its importable module."""

import sys
from pathlib import Path


def main() -> None:
    """Load the module beside this command and pass its arguments through."""
    # Isolated mode omits source directories from sys.path; resolve the command so a symlink still
    # loads both modules from its own checkout.
    directory = Path(__file__).resolve().parent
    sys.path[:0] = [str(directory), str(directory.parent / "box")]
    import tine

    tine.main(sys.argv[1:])


if __name__ == "__main__":
    main()
