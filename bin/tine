#!/usr/bin/python3 -SI
"""Run the pinned Buck2 with the configuration Buck cannot compute for itself.

Every Buck command starts by running this, so it imports as little as it can: `-SI` in the shebang
skips `site` and the environment, and a module only some paths need is imported where it is needed.
A keypress in a completing shell reaches `os.execve` having imported nothing but what it read the
configuration with. Keep it that way.

Configuration derived from the state of the checkout goes into a block in `.buckconfig.local`
rather than onto the command line: `buck2 complete`, which serves shell completion, accepts no
configuration flags at all, so a wrapper that injected `-c` would complete against different
configuration than it builds with. That file is the highest-precedence one Buck reads without being
told to, which an external cell has to be overridden from and a project should not have to opt into.

Self-contained, and needs only git and a host python: a project consuming the tine cell vendors this
file, and at that point Buck has fetched no cell to read anything else out of. That host python is
whatever the machine has, and older than the one Buck fetches, which is why a union annotation is
quoted here and nowhere else in the tree: unquoted, it is evaluated where `X | None` is a TypeError.
"""

import os
import re
import signal
import sys
import time
from pathlib import Path

LOCAL = ".buckconfig.local"

# This cell, and where it keeps this command: a project that overrides it with a checkout runs that
# checkout's command as well as its rules.
CELL = "tine"
COMMAND = "bin/tine"

# The section every cell configured as a git one carries, which is what `tine cell` declares an
# override by writing into the block below and what it reads one back out of.
EXTERNAL = "external_cell_"

# Where the project pins the Buck2 this fetches. In `[tine]` rather than `[buck2]`, which is Buck2's
# own to define keys in, and not in a `[tine.buck2]` of its own, which `audit config` cannot address.
SECTION = "tine"
BUCK2 = "buck2-"

# What a project `tine init` writes pins itself to. The tine cell needs the Buck2 its rules were
# written against, which is this fork rather than upstream.
TINE_ORIGIN = "https://github.com/amutable-systems/tine"
BUCK2_REPOSITORY = "daandemeyer/buck2"
# Keyed as `uname` answers, so what a pin is named needs no second table to be derived from. Linux
# spells these machines and nothing else: `arm64` and `amd64` are other systems' names for two.
BUCK2_ARTIFACTS = {
    "Linux-aarch64": "buck2-aarch64-unknown-linux-musl.zst",
    "Linux-riscv64": "buck2-riscv64gc-unknown-linux-gnu.zst",
    "Linux-x86_64": "buck2-x86_64-unknown-linux-musl.zst",
}

# What must not invalidate Buck's file watcher, as the lines a continued value is written across:
# VCS state, dependency and build trees, and the caches tools keep. Only names that are always
# generated, which `build`, `dist` and `out` are not: those are ordinary package names, and ignoring
# one would hide the targets in it rather than only its churn.
IGNORED = (
    ".git, .jj, **/.git, **/.jj, **/.hg, **/.svn",
    "**/buck-out, **/target, **/node_modules, **/__pycache__, **/.venv, **/venv",
    "**/.cache, **/.direnv, **/.gradle, **/.tox, **/.nox",
    "**/.mypy_cache, **/.pytest_cache, **/.ruff_cache",
    "**/.next, **/.parcel-cache, **/.turbo, **/.idea, **/.vscode",
)

# The block this owns in that file. Everything else there is the developer's, and stays; theirs
# comes after this block, so a key they set for themselves still wins over the one written here.
BLOCK_BEGIN = "# @generated by `tine`; rewritten on every command."

# `tine cell` records an override in that block rather than in a file of its own, so what a build
# reads and what was declared cannot fall out of step. Its own line, so that the marker above stays
# the one every `.buckconfig.local` already written carries.
BLOCK_NOTE = "# `tine cell override` writes here; edit an override with that command, not by hand."
BLOCK_END = "# @end generated by `tine`; what follows is yours."

SHELLS = ("bash", "fish", "zsh")

# Universal options Buck2 takes before a subcommand which consume the argument after them; stepping
# over those is what finds the subcommand in `tine buck -v 0 complete --target=x`.
VALUE_FLAGS = (
    "--isolation-dir",
    "-v",
    "--verbose",
    "--oncall",
    "--client-metadata",
    "--agent-context",
)

# `git -C` sets the working directory and nothing else, so these still point wherever the caller's
# git was pointing: a tine run from a hook or `git rebase --exec` would describe that repository.
GIT_LOCATION_VARS = (
    "GIT_DIR",
    "GIT_WORK_TREE",
    "GIT_INDEX_FILE",
    "GIT_OBJECT_DIRECTORY",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_COMMON_DIR",
    "GIT_NAMESPACE",
)


def fail(message: str) -> SystemExit:
    return SystemExit(f"tine: {message}")


def is_version(value: str) -> bool:
    """Whether a tag spells something a version can be derived from.

    "^" is excluded because the rendering appends it as a separator, and a tag carrying one would
    make the result ambiguous.
    """
    return bool(value) and all(c.isascii() and (c.isalnum() or c in "._~-") for c in value)


def round_trips(value: str) -> bool:
    """Whether a value written into a buckconfig reads back as itself.

    A trailing backslash swallows the line written after it, a newline turns one entry into two, and
    space around a value is stripped on read.
    """
    return value == value.strip() and not value.endswith("\\") and "\n" not in value


def is_hex(value: str, *lengths: int) -> bool:
    return len(value) in lengths and all(c in "0123456789abcdef" for c in value)


def cwd() -> Path:
    """The directory the command was run from, which can be gone by the time it is asked for."""
    try:
        return Path.cwd()
    except OSError as error:
        raise fail(f"cannot read the working directory: {error}") from error


def project_root(start: Path) -> Path:
    """The furthest ancestor holding a .buckconfig, the same root Buck itself resolves to."""
    root = None
    home = Path.home()
    for directory in [start, *start.parents]:
        if (directory / ".buckconfig").is_file():
            # `~/.buckconfig` overrides configuration for every project, so Buck stops rather than
            # taking the home directory for one; a wrapper that did not would resolve a root Buck
            # never resolves.
            if directory == home:
                break
            root = directory
        if (directory / ".buckroot").is_file():
            break
    if root is None:
        raise fail(f"no .buckconfig in {start} or any parent directory")
    return root


def section_marker(line: str) -> "str | None":
    """The section a line opens, or None where it opens none.

    Buck2 accepts a trailing comment on a section marker, and oss-enable markers use it.
    """
    marker = line.strip().split(" #", 1)[0].rstrip()
    return marker[1:-1] if marker.startswith("[") and marker.endswith("]") else None


def read_lines(path: Path) -> list[str]:
    """A file's lines as Buck2 counts them, which is on "\n" and on nothing else.

    `str.splitlines` also breaks on a form feed and half a dozen other separators, and `read_text`
    translates a stray carriage return into a newline before anything here sees it. Rewriting a file
    through either turns one of those in the developer's own text into a line Buck cannot read.
    """
    try:
        # `open`, not `read_text`, which only takes a newline argument from python 3.13 on.
        with path.open(encoding="utf-8", newline="") as handle:
            text = handle.read()
    except (OSError, UnicodeDecodeError) as error:
        raise fail(f"cannot read {path}: {error}") from error
    lines = text.split("\n")
    return lines[:-1] if not lines[-1] else lines


def _split(path: Path) -> tuple[list[str], list[str]]:
    """What a file holds besides the block this writes into it, and what that block holds.

    Read apart because the block would otherwise feed on itself: the `[external_cells]` entries it
    writes would read back as what the project declares, and the next command would take its own
    output for configuration. What `tine cell` declared comes from the block alone, and everything
    a project configures from everything but the block.

    Half a block is corruption either way round, and reported as such: an end whose begin is gone
    would leave the old block after the new one, where it wins for good, since what a buckconfig
    says last is what Buck takes.
    """
    if not path.is_file():
        return [], []
    kept: list[str] = []
    generated: list[str] = []
    inside = False
    for line in read_lines(path):
        if line.strip() == BLOCK_BEGIN:
            if inside:
                raise fail(f"{path}: a generated block begins inside another; restore or delete it")
            inside = True
        elif line.strip() == BLOCK_END:
            if not inside:
                raise fail(f"{path}: a generated block ends without beginning; restore or delete it")
            inside = False
        else:
            (generated if inside else kept).append(line)
    if inside:
        raise fail(f"{path}: the generated block has no {BLOCK_END!r} line; restore or delete it")
    return kept, generated


def _logical(lines: list[str]) -> list[str]:
    """Buckconfig lines as entries: continuations joined, comments and blanks dropped."""
    logical: list[str] = []
    # Buck2 continues a comment too, and what follows one is the comment's rather than the entry
    # before it: `kept` is what says whether there is a line here to continue at all.
    kept = continued = False
    for raw in lines:
        line = raw.strip()
        if continued:
            continued = line.endswith("\\")
            if kept:
                logical[-1] = logical[-1][:-1] + line
            continue
        kept = bool(line) and not line.startswith(("#", ";"))
        if kept:
            logical.append(line)
        continued = line.endswith("\\")
    return logical


def parse_buckconfig(
    path: Path, config: "dict[str, dict[str, str]] | None" = None
) -> dict[str, dict[str, str]]:
    """A buckconfig file's sections, following the includes Buck2 would follow."""
    config = {} if config is None else config
    _parse(path, config, "")
    return config


def _parse(path: Path, config: dict[str, dict[str, str]], section: str) -> str:
    """An include continues in whatever section the included file ended in, so a file is read into
    the section it was reached from rather than starting afresh in none, and the section it ends in
    is what it reports back.
    """
    if not path.is_file():
        return section

    config.setdefault(section, {})
    return _fill(_logical(_split(path)[0]), config, section, path.parent)


def _fill(lines: list[str], config: dict[str, dict[str, str]], section: str, directory: Path) -> str:
    for line in lines:
        if line.startswith("["):
            if (marker := section_marker(line)) is not None:
                section = marker
                config.setdefault(section, {})
        elif line.startswith("<") and ">" in line:
            # `<file:path>`, or `<?file:path>` for one that need not exist. Buck2 reads the include
            # off the front of the line and ignores whatever follows the `>`.
            include = line[1 : line.index(">")].removeprefix("?")
            if include.startswith("file:"):
                section = _parse(directory / include.removeprefix("file:"), config, section)
        elif "=" in line:
            key, _, value = line.partition("=")
            if key.strip():
                config.setdefault(section, {})[key.strip()] = value.strip()
    return section


def generated(path: Path) -> dict[str, dict[str, str]]:
    """What the block this owns says, which is where `tine cell` records what it declared."""
    config: dict[str, dict[str, str]] = {}
    _fill(_logical(_split(path)[1]), config, "", path.parent)
    return config


def project_config(root: Path) -> dict[str, dict[str, str]]:
    """The root cell's configuration, in the order Buck2 layers it.

    `.buckconfig.d` is the lowest layer and is read whole, in name order; `.buckconfig.local` is the
    highest, which is why the block this command owns goes there.
    """
    config: dict[str, dict[str, str]] = {}
    # Buck2 lists that directory with `lstat` and keeps what is a file or a directory, so a symlink
    # in it is not configuration it reads, however the link resolves.
    listed = [path for path in sorted((root / ".buckconfig.d").rglob("*")) if not path.is_symlink()]
    for path in [*listed, root / ".buckconfig", root / LOCAL]:
        parse_buckconfig(path, config)
    return config


def is_repository(path: Path) -> bool:
    """Whether a directory is one git can fetch from, which a bare repository is too."""
    return (path / ".git").exists() or all((path / name).exists() for name in ("HEAD", "objects", "refs"))


def local_checkout(origin: str) -> "Path | None":
    """The repository a git origin names, when it names one on this machine rather than a remote.

    Buck2 hands the origin to `git fetch`, which reads `file://` and `~` the way git does; a
    relative path would resolve against the directory Buck fetches into, so only an absolute one
    names anything a build can rely on.
    """
    if origin.startswith("file://"):
        from urllib.parse import unquote

        # git decodes the whole URL before splitting off the authority, so decoding comes first: an
        # escape that decodes to `/` belongs to the path.
        decoded = unquote(origin.removeprefix("file://"))
        if (slash := decoded.find("/")) == -1:
            # An authority and nothing else, which names no path to fetch from.
            return None
        path = Path(decoded[slash:])
    else:
        try:
            path = Path(origin).expanduser()
        except RuntimeError:
            # `~someone-who-is-not-there`, which names no path at all.
            return None
    return path if path.is_absolute() and is_repository(path) else None


def checkout_at(argument: str) -> "Path | None":
    """The repository a command-line argument names, resolved against the caller's directory.

    Resolved rather than merely absolute: this ends up recorded in a file and fetched from by
    something with a working directory of its own, which `..` in the middle of it need not survive.
    """
    if not argument:
        return None
    try:
        return local_checkout(str(Path(argument).expanduser().resolve()))
    except RuntimeError:
        return None


def declared_cells(root: Path) -> "dict[str, tuple[str, str | None]]":
    """The checkout, and the commit of it, each overridden cell was declared with.

    Read back out of the block this generates, which is the declaration as much as the configuration
    Buck reads: one file, so nothing it says can fall out of step with what was declared. No commit
    is the declaration to follow that checkout's `HEAD`, resolved afresh on every command; one that
    names a commit stays there until it is declared again, and `cell-<name>-commit` is what says so,
    the `commit_hash` beside it being resolved either way.
    """
    config = generated(root / LOCAL)
    pinned = config.get(SECTION, {})
    declared = {}
    for section, entries in config.items():
        if section.startswith(EXTERNAL) and (origin := entries.get("git_origin")):
            cell = section.removeprefix(EXTERNAL)
            declared[cell] = (origin, pinned.get(f"cell-{cell}-commit"))
    return declared


def declarable(cell: str, origin: str) -> None:
    """Fail unless the override can be spelled in a buckconfig, which is where it ends up.

    Both halves are interpolated into one: the cell into the section marker of the entry that
    configures it, the origin into a value read back as something else if it does not round-trip.
    """
    section = f"{EXTERNAL}{cell}"
    if section_marker(f"[{section}]") != section:
        raise fail(f"cell {cell}: a cell of that name cannot be configured in a buckconfig")
    if not round_trips(origin):
        raise fail(f"cell {cell}: {origin!r} cannot be configured in a buckconfig as it stands")


def overridden_cells(
    config: dict[str, dict[str, str]], declared: "dict[str, tuple[str, str | None]]"
) -> dict[str, tuple[str, str]]:
    """Where each overridden cell is fetched from, and at which commit.

    What the build reads is a commit of that checkout, fetched from it like any other, so a commit
    is what a declaration resolves to. A declaration that cannot be honoured fails the command rather
    than being skipped: falling back to what `.buckconfig` pins would quietly build something other
    than what was asked for.
    """
    resolved: dict[str, tuple[str, str]] = {}
    cells = cells_of(config)
    for cell, (origin, commit) in sorted(declared.items()):
        if cell not in cells:
            # A branch switch drops one, and Buck2 answers with `is not a known cell alias`.
            raise fail(
                f"cell {cell} is overridden but this project has none; `tine cell revert {cell}` drops it"
            )
        # Hand-written declarations reach this too, and every one of them is about to be written
        # into a file Buck2 parses.
        declarable(cell, origin)
        checkout = local_checkout(origin)
        if checkout is None:
            raise fail(f"cell {cell}: {origin} is not a git repository; `tine cell revert {cell}` drops it")
        if commit is None:
            try:
                commit = commit_of(checkout)
            except SystemExit as error:
                raise fail(f"cell {cell}: {str(error).removeprefix('tine: ')}") from None
        elif not is_hex(commit, 40, 64):
            # Hand-written, and about to be a commit_hash Buck2 reads.
            raise fail(f"cell {cell}: {commit!r} in {LOCAL} is not a commit")
        resolved[cell] = (str(checkout), commit)
    return resolved


def _git(*args: str, directory: Path) -> str:
    import subprocess

    environment = {k: v for k, v in os.environ.items() if k not in GIT_LOCATION_VARS}
    command = ["git", "-C", str(directory), *args]
    try:
        proc = subprocess.run(command, capture_output=True, env=environment, text=True)
    except OSError:
        raise fail("required tool not found: git") from None
    if proc.returncode != 0:
        # One line: git answers a bad revision with three of them, and a reason ends up in a
        # generated buckconfig, where the lines after the first would be read as configuration.
        reason = " ".join(proc.stderr.split()) or f"exit {proc.returncode}"
        raise fail(f"git {' '.join(args)}: {reason}")
    return proc.stdout.strip()


def commit_of(checkout: Path, revision: "str | None" = None) -> str:
    """The commit a checkout is on, or the one a revision of it names.

    `^{commit}` so that a tag object resolves to what it tags, and `--end-of-options` so that a
    revision spelled like an option is refused rather than taken for one.
    """
    named = f"{revision}^{{commit}}" if revision else "HEAD"
    return _git("rev-parse", "--verify", "--end-of-options", named, directory=checkout)


def components(root: Path) -> "dict[str, object] | str":
    """What a version is derived from, keyed as the configuration spells it, or why there is none.

    `height` is the commits in HEAD's history, which a version whose base no tag named counts its
    distance in: a new tag resets `count` and would order that build below the one before it.
    `seconds` is only a dirty tree's, and its absence is what makes a build a release or a snapshot.

    A checkout git cannot answer for still has to run every command that needs no version, so the
    reason is reported through the generated file rather than by failing here.
    """
    if not (root / ".git").exists():
        return "not a git checkout"
    try:
        # Truncated history answers `describe` and `rev-list --count` as confidently as whole
        # history does, and every answer is wrong: the base is some older tag's or none, and the
        # counts stop telling one commit from the next.
        if _git("rev-parse", "--is-shallow-repository", directory=root) == "true":
            return "shallow git checkout"
        head = _git("rev-parse", "HEAD", directory=root)
        height = int(_git("rev-list", "--count", "HEAD", directory=root))
        # `v[0-9]*` rather than `v*`, which matches a tag like `vendor-2024` and would read it as
        # version `endor-2024`. --always falls back to the bare commit hash when no tag matches, and
        # the 0.0.0 base stands in then. This is the nearest tag and not the highest, so merging a
        # branch tagged below the current one moves the base back with it.
        described = _git(
            "describe", "--tags", "--match", "v[0-9]*", "--abbrev=0", "--always", directory=root
        )
        if described.startswith("v"):
            base = described.removeprefix("v")
            # Qualified, or a branch sharing the tag's name makes the revision ambiguous.
            count = int(_git("rev-list", "--count", f"refs/tags/{described}..HEAD", directory=root))
        else:
            base = "0.0.0"
            count = height
        if not is_version(base):
            return f"tag {described!r} is not a valid version"

        seconds = None
        # -unormal because `status.showUntrackedFiles=no` in the caller's git configuration would
        # otherwise present a tree carrying uncommitted work as a release.
        if _git("status", "--porcelain", "-unormal", directory=root):
            committed = int(_git("log", "-1", "--format=%ct", directory=root))
            # A clock behind the committer time must not order the build below the commit.
            seconds = max(0, int(time.time()) - committed)
    except SystemExit as error:
        return str(error).removeprefix("tine: ")
    return {"base": base, "count": count, "height": height, "commit": head, "seconds": seconds}


def generate(
    root: Path, config: dict[str, dict[str, str]], declared: "dict[str, tuple[str, str | None]]"
) -> list[str]:
    overridden = overridden_cells(config, declared)
    lines = [BLOCK_BEGIN, BLOCK_NOTE]
    if overridden:
        # The entry as well as the section: a cell the project pins differently, or does not make
        # external at all, is then overridden by this one declaration and nothing else.
        lines += ["", "[external_cells]"] + [f"{cell} = git" for cell in overridden]
    for cell, (origin, commit) in overridden.items():
        lines += ["", f"[{EXTERNAL}{cell}]", f"git_origin = {origin}", f"commit_hash = {commit}"]
    # An override that named a revision, which is what says the commit above is not to be resolved
    # again. Read back by the next command, so the declaration outlives the one that made it.
    settings = [f"cell-{cell}-commit = {commit}" for cell, (_, commit) in sorted(declared.items()) if commit]
    derived = components(root)
    if isinstance(derived, str):
        # Recorded rather than raised: whatever wanted a version reports its absence, pointing here.
        lines.append(f"# no version components: {derived}")
    else:
        # A clean checkout has no seconds, and an absent key is how a reader tells the two apart.
        settings += [f"version-{key} = {value}" for key, value in derived.items() if value is not None]
    if settings:
        lines += ["", f"[{SECTION}]", *settings]
    return lines + [BLOCK_END]


def merge(path: Path, block: list[str]) -> str:
    kept = _split(path)[0]
    while kept and not kept[0].strip():
        kept.pop(0)
    return "\n".join(block + ([""] + kept if kept else [])) + "\n"


def write_if_changed(path: Path, text: str) -> None:
    # A checked-in file shared through a symlink is a layout Buck reads; renaming over the link
    # would leave that file stale and turn the link into a copy of it.
    if path.is_symlink():
        path = path.resolve()
    # `newline=""`, or a file carrying a carriage return never compares equal and is rewritten by
    # every command.
    if path.is_file():
        with path.open(encoding="utf-8", newline="") as handle:
            if handle.read() == text:
                return
    # Rename into place so a concurrent Buck never parses a half-written config.
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(text, encoding="utf-8")
        tmp.replace(path)
    except OSError as error:
        tmp.unlink(missing_ok=True)
        raise fail(f"cannot write {path}: {error}") from error


def refresh(
    root: Path,
    config: dict[str, dict[str, str]],
    declared: "dict[str, tuple[str, str | None]] | None" = None,
) -> None:
    local = root / LOCAL
    declared = declared_cells(root) if declared is None else declared
    write_if_changed(local, merge(local, generate(root, config, declared)))


def _platform() -> str:
    system, _, _, _, machine = os.uname()
    if (platform := f"{system}-{machine}") not in BUCK2_ARTIFACTS:
        raise fail(f"unsupported platform: {platform}")
    return platform


def _decompress(archive: Path, binary: Path) -> None:
    """Unpack a zstd-compressed release artifact, without the `zstd` command where python has it."""
    try:
        from compression import zstd
    except ImportError:
        _unzstd(archive, binary)
        return
    try:
        with zstd.open(archive) as compressed, binary.open("wb") as out:
            while chunk := compressed.read(1 << 20):
                out.write(chunk)
    except (zstd.ZstdError, EOFError) as error:
        # Wrong magic, or a stream that ends early; the `zstd` command reports both the same way.
        raise fail(f"the pinned artifact is not a whole zstd stream: {error}") from error


def _unzstd(archive: Path, binary: Path) -> None:
    """The `zstd` command, for a python whose standard library cannot unpack one itself."""
    import subprocess

    command = ["zstd", "--decompress", "--force", "--quiet", str(archive), "-o", str(binary)]
    try:
        proc = subprocess.run(command)
    except OSError:
        raise fail("required tool not found: zstd, or a python 3.14 or newer to unpack with") from None
    if proc.returncode != 0:
        raise fail(f"zstd could not unpack {archive}")


def _download(url: str, sha256: str, into: Path) -> Path:
    import hashlib
    import tempfile
    import urllib.request

    binary = into / "buck2"
    print(f"tine: downloading {url}", file=sys.stderr)
    digest = hashlib.sha256()
    try:
        # Unpacked beside the cache entry rather than inside it, so that a download which does not
        # verify leaves nothing behind, and the rename below stays on one filesystem.
        into.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(dir=into.parent, prefix=".download.") as directory:
            archive = Path(directory) / "buck2.zst"
            with urllib.request.urlopen(url, timeout=120) as response, archive.open("wb") as out:
                while chunk := response.read(1 << 20):
                    digest.update(chunk)
                    out.write(chunk)
            if digest.hexdigest() != sha256:
                raise fail(f"{url} has SHA-256 {digest.hexdigest()}, not the pinned {sha256}")
            unpacked = Path(directory) / "buck2"
            _decompress(archive, unpacked)
            unpacked.chmod(0o755)
            into.mkdir(exist_ok=True)
            # Rename into place so that a concurrent tine sees a whole binary or none.
            unpacked.replace(binary)
    except OSError as error:
        raise fail(f"cannot fetch {url}: {error}") from error
    return binary


def buck2(config: dict[str, dict[str, str]], *, fetch: bool = True) -> "Path | None":
    """The pinned Buck2 binary, fetched and verified the first time it is asked for.

    Keyed by its own hash, so a bumped pin lands beside the old one rather than replacing it, and a
    checkout that goes back to the old pin finds it already there. Without `fetch` an uncached pin is
    None rather than a download.
    """
    pin = config.get(SECTION, {})
    platform = _platform()
    repository = pin.get(f"{BUCK2}repository")
    release = pin.get(f"{BUCK2}release")
    artifact = pin.get(f"{BUCK2}{platform}-artifact")
    sha256 = pin.get(f"{BUCK2}{platform}-sha256")
    if not (repository and release and artifact and sha256):
        raise fail(f"no Buck2 pinned for {platform} in [{SECTION}]; `tine init` writes one")
    if not is_hex(sha256, 64):
        raise fail(f"[{SECTION}] {BUCK2}{platform}-sha256 is not a SHA-256: {sha256!r}")

    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    into = cache / "tine" / "buck2" / sha256
    binary = into / "buck2"
    if binary.is_file():
        return binary
    if not fetch:
        return None
    return _download(f"https://github.com/{repository}/releases/download/{release}/{artifact}", sha256, into)


# What the usage message, and every shell's completion of the first word, are generated from.
VERBS = {
    "buck": "run the pinned Buck2, which every other command configures",
    "cell": "build a cell from a local checkout, or go back to the pinned one",
    "bump": "rewrite the pinned Buck2 release to the latest one published",
    "init": "write the configuration a project needs to build against the tine cell",
    "completion": "print the completion script for bash, fish or zsh",
}


def _patch(script: str, old: str, new: str) -> str:
    """Replace what Buck2's completion script says, failing where it no longer says it.

    A pin that moves the ground under one of these should say so rather than emit a script that
    silently completes nothing.
    """
    if old not in script:
        raise fail(f"buck2's completion script has no {old!r} to rewrite; the pin moved under it")
    return script.replace(old, new)


def _buck2_completion(binary: Path, shell: str) -> str:
    import subprocess

    try:
        proc = subprocess.run([binary, "completion", shell], stdout=subprocess.PIPE, text=True)
    except OSError as error:
        raise fail(f"cannot run {binary}: {error}") from error
    if proc.returncode != 0:
        raise SystemExit(proc.returncode)
    return proc.stdout


def completion(script: str, shell: str) -> str:
    """Buck2's own completion script, rewritten to complete `tine buck` instead.

    Buck2's arguments arrive one word further along than its own script expects, so the helper that
    finds the subcommand skips that word and everything else follows. The dynamic half is why this
    is rewritten at all rather than left to a shell's wrapping mechanism: it runs `buck2 complete`
    from inside the shell functions, which resolves to whatever `buck2` is on PATH and so completes
    against unwrapped configuration, or against nothing at all when the bootstrapped binary is the
    only one on the machine.
    """
    script = re.sub(
        r"^# @generated by .*$",
        f"# @generated by `tine completion {shell}`",
        script,
        count=1,
        flags=re.M,
    )
    if shell == "fish":
        return _fish(script)
    # bash and zsh spell buck2 into function names, into the subcommand state machine and into the
    # registration alike, so rename wholesale; the cost is a few help strings that now say tine
    # where they mean Buck2.
    script = script.replace("buck2", "tine")
    # All but its entry point, which takes the name a shell autoloads this file under: `_tine` has
    # to be the completer that knows this command's own verbs, and Buck2's is reached through it.
    script = re.sub(r"\b_tine\b", "_tine_buck2", script)
    # An array, because the command it names is now two words; the hook itself is Buck2's own.
    script = _patch(
        script,
        '_BUCK_COMPLETE_BIN="${_BUCK_COMPLETE_BIN:-tine}"',
        "[[ -n ${_BUCK_COMPLETE_BIN[*]} ]] || _BUCK_COMPLETE_BIN=(tine buck)",
    )
    if shell == "bash":
        # Buck2 registers its completers for the `buck` command too, which this one is not.
        script = re.sub(r"^[ \t]*complete -F .* buck\n", "", script, flags=re.M)
        own = _BASH
    else:
        # A shell reads the commands a file completes off its first line, and `buck` there would
        # bind a real buck2 installation's completion to this script.
        script = _patch(script, "#compdef tine buck", "#compdef tine")
        script = _patch(script, "\ncompdef __tine_fix buck tine\n", "\n")
        # Paired with that registration, and this file registers itself at the end instead.
        script = _patch(script, "\ncompdef -d tine\n", "\n")
        # Buck2's own entry point, which runs where it sits: too early, since the completer that
        # dispatches into it is defined at the end of the file. The same idiom goes there instead.
        script = _patch(
            script,
            '\nif [ "$funcstack[1]" = "_tine_buck2" ]; then\n    _tine_buck2 "$@"\n'
            "else\n    compdef _tine_buck2 tine\nfi\n",
            "\n",
        )
        own = _ZSH
    return script + own.replace(VERBS_MARKER, " ".join(VERBS))


def quoted(text: str) -> str:
    """What fish reads back as `text` inside the single quotes a description is written in."""
    return text.replace("\\", "\\\\").replace("'", "\\'")


def _fish(script: str) -> str:
    script = re.sub(r"^complete -c buck2 ", "complete -c tine ", script, flags=re.M)
    script = script.replace("__fish_buck2", "__fish_tine").replace("__buck2", "__tine")
    script = re.sub(r"^complete -c buck -w buck2\n", "", script, flags=re.M)

    # Everything clap generated hangs off this one helper, so shifting it past `buck` shifts the
    # lot, and leaves every other command completing nothing of Buck2's.
    script = _patch(
        script,
        """    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_tine_global_optspecs)""",
        """    set -l cmd (commandline -opc)
    set -e cmd[1]
    # Buck2's arguments start after `tine buck`, and belong to nothing else.
    test "$cmd[1]" = buck
    or return 1
    set -e cmd[1]
    argparse -s (__fish_tine_global_optspecs)""",
    )
    # The hand-written half tokenizes the line itself, so it needs the same word skipped.
    script = _patch(
        script,
        """    set -l subcommand (__tine_subcommand $cmd)""",
        """    test "$cmd[2]" = buck
    or return 1
    set -l subcommand (__tine_subcommand $cmd[2..])""",
    )
    script = _patch(script, '    buck2 complete --target="$cur"', '    tine buck complete --target="$cur"')
    verbs = "\n".join(
        f"complete -c tine -n __fish_use_subcommand -f -a {verb} -d '{quoted(description)}'"
        for verb, description in VERBS.items()
    )
    return script + _FISH.replace(VERBS_MARKER, verbs)


# Stands in for the verb list until the script that carries it is generated.
VERBS_MARKER = "__TINE_VERBS__"

_FISH = """
# `tine cell <verb> <cell> <path>`: a verb of its own, then a path where `override` takes one.
function __tine_cell_verb
    set -l cmd (commandline -opc)
    test (count $cmd) -eq 2; and test "$cmd[2]" = cell
end

function __tine_cell_path
    set -l cmd (commandline -opc)
    test (count $cmd) -ge 4; and test "$cmd[2]" = cell; and test "$cmd[3]" = override
end

# tine's own commands, which are what is being completed until `buck` is one of the words.
__TINE_VERBS__
complete -c tine -n '__fish_seen_subcommand_from completion' -f -a 'bash fish zsh'
complete -c tine -n '__fish_seen_subcommand_from init' -F
complete -c tine -n '__fish_seen_subcommand_from bump' -f
complete -c tine -n __tine_cell_verb -f -a 'override revert list'
complete -c tine -n __tine_cell_path -F
"""

_BASH = """
_tine() {
    # Buck2's completer adds to this rather than assigning it, and bash leaves what the last
    # completion in this shell put there.
    COMPREPLY=()
    if [[ ${COMP_WORDS[1]} == buck && $COMP_CWORD -gt 1 ]]; then
        # Hand Buck2's own completion the command line it expects, without the word that got here.
        # However this command was invoked is that word, `./bin/tine` included.
        local skip=$(( ${#COMP_WORDS[0]} + 1 ))
        local COMP_WORDS=("${COMP_WORDS[@]:1}")
        local COMP_CWORD=$((COMP_CWORD - 1))
        local COMP_LINE=${COMP_LINE:skip}
        local COMP_POINT=$((COMP_POINT - skip))
        # Target completion continues a word it emits in an order of its own; both are options
        # Buck2 registers with, and this command's registration cannot carry them for its verbs.
        compopt -o nospace 2>/dev/null
        compopt -o nosort 2>/dev/null
        # Buck2's state machine keys its first word off $1, which is now `buck` rather than `tine`.
        __tine_fix buck "$2" "$3"
        return
    fi
    # Nothing to offer is a path: `-o default` falls back to filenames where this leaves off.
    local words=
    case $COMP_CWORD in
        1) words="__TINE_VERBS__" ;;
        2) case ${COMP_WORDS[1]} in
               cell) words="override revert list" ;;
               completion) words="bash fish zsh" ;;
           esac ;;
    esac
    COMPREPLY=($(compgen -W "$words" -- "${COMP_WORDS[COMP_CWORD]}"))
}

complete -F _tine -o bashdefault -o default tine
"""

_ZSH = """
_tine() {
    local line
    _arguments -C '1: :(__TINE_VERBS__)' '*:: :->rest'
    case $line[1] in
        buck) __tine_fix ;;
        cell) _arguments '1: :(override revert list)' '*: :_files' ;;
        completion) _values shell bash fish zsh ;;
        init) _files ;;
    esac
}

# Autoloaded from a file named `_tine`, this file is the completer and runs it; sourced, it
# registers it. Buck2's own entry point, moved here so that both completers exist by now.
if [ "$funcstack[1]" = "_tine" ]; then
    _tine "$@"
else
    compdef _tine tine
fi
"""


def _release(repository: str) -> tuple[str, dict[str, str]]:
    """The repository's latest release as its tag and the SHA-256 of each asset it publishes.

    The full release, or the newest published one where the repository has none.
    """
    import json
    import urllib.error
    import urllib.request

    headers = {"Accept": "application/vnd.github+json", "User-Agent": "tine"}
    if token := os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN"):
        headers["Authorization"] = f"Bearer {token}"

    def get(url: str) -> object:
        request = urllib.request.Request(url, headers=headers)
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                return json.load(response)
        except urllib.error.HTTPError:
            # Answered, and the answer was no; the caller decides which of those it can live with.
            raise
        except (OSError, ValueError) as error:
            # ValueError: something answered, with something other than the JSON GitHub sends.
            raise fail(f"GitHub: {url}: {error}") from error

    api = f"https://api.github.com/repos/{repository}/releases"
    try:
        latest = get(f"{api}/latest")
    except urllib.error.HTTPError as error:
        # A repository publishing only prereleases has no "latest", and only that is recoverable.
        if error.code != 404:
            raise fail(f"GitHub: {api}/latest: {error}") from error
        latest = None
    if not isinstance(latest, dict):
        try:
            listed = get(f"{api}?per_page=100")
        except urllib.error.HTTPError as error:
            raise fail(f"GitHub: {api}: {error}") from error
        published = [
            release
            for release in (listed if isinstance(listed, list) else [])
            if isinstance(release, dict) and not release.get("draft") and release.get("published_at")
        ]
        if not published:
            raise fail(f"GitHub reports no published releases for {repository}")
        latest = max(published, key=lambda release: str(release["published_at"]))

    tag = str(latest.get("tag_name") or "")
    if not tag or not round_trips(tag):
        raise fail(f"{repository} reports {tag!r} as the tag of its latest release")
    assets = latest.get("assets")
    return tag, {
        str(asset.get("name")): str(asset.get("digest") or "").removeprefix("sha256:")
        for asset in (assets if isinstance(assets, list) else [])
        if isinstance(asset, dict)
    }


def _digest(assets: dict[str, str], artifact: str, repository: str, tag: str) -> str:
    """The SHA-256 a release publishes an artifact under, which a pin is no use without."""
    digest = assets.get(artifact, "")
    if not is_hex(digest, 64):
        raise fail(f"{repository} {tag} publishes no {artifact} with a SHA-256")
    return digest


def bump(buckconfig: Path) -> None:
    """Rewrite the Buck2 pin to the repository's latest release, in place.

    Read from the file it rewrites rather than from the project's merged configuration: a Buck2
    someone pins for themselves in `.buckconfig.local` is theirs, and is not the committed pin
    catching up with it. Only the values move, and the SHA-256 comes off the release asset's digest,
    so nothing is downloaded.
    """
    pin = parse_buckconfig(buckconfig).get(SECTION, {})
    repository = pin.get(f"{BUCK2}repository")
    if not repository:
        raise fail(f"no [{SECTION}] {BUCK2}repository in {buckconfig} to bump from")

    tag, assets = _release(repository)
    values = {f"{BUCK2}release": tag}
    for platform in sorted(BUCK2_ARTIFACTS):
        # The artifact names carry no version, so the one pinned is the one to look for.
        if (artifact := pin.get(f"{BUCK2}{platform}-artifact")) is not None:
            values[f"{BUCK2}{platform}-sha256"] = _digest(assets, artifact, repository, tag)

    if all(pin.get(key) == value for key, value in values.items()):
        print(f"tine: buck2 {tag} is already pinned", file=sys.stderr)
        return
    write_if_changed(buckconfig, _rewrite(buckconfig, values))
    print(f"tine: buck2 {pin.get(f'{BUCK2}release')} -> {tag}", file=sys.stderr)


def _rewrite(buckconfig: Path, values: dict[str, str]) -> str:
    """The file with each named key given its new value, and nothing else touched."""
    kept: list[str] = []
    section = None
    written = set()
    continued = False
    for line in read_lines(buckconfig):
        body, ending = (line[:-1], "\r") if line.endswith("\r") else (line, "")
        if continued:
            # What is left of a value written across several lines, and now written on one.
            continued = body.endswith("\\")
            continue
        if (marker := section_marker(body)) is not None:
            section = marker
        elif section == SECTION and (key := body.split("=", 1)[0].strip()) in values:
            continued = body.endswith("\\")
            written.add(key)
            indent = body[: len(body) - len(body.lstrip())]
            line = f"{indent}{key} = {values[key]}{ending}"
        kept.append(line)
    if missing := sorted(set(values) - written):
        raise fail(
            f"{buckconfig}: [{SECTION}] has no {', '.join(missing)} to rewrite; a pin reached"
            " through an include is not this command's to move"
        )
    return "\n".join(kept) + "\n"


TOOLCHAINS = '''"""The toolchains cell a Buck2 project needs, pointed at the interpreter tine pins."""

load("@prelude//toolchains:python.bzl", "python_bootstrap_toolchain")

# Repoint the cell, or override only `[tine] python_interpreter`.
python_bootstrap_toolchain(
    name = "python_bootstrap",
    interpreter = read_config("tine", "python_interpreter", "tine//tools:python3"),
    visibility = ["PUBLIC"],
)
'''

GITIGNORE = f"""/buck-out
**/buck-out
/{LOCAL}
/{LOCAL}.*.tmp
"""


def _skeleton(origin: str, commit: str, release: str, digests: dict[str, str]) -> dict[str, str]:
    """What a project needs before Buck can be run in it, as file contents.

    The tine cell is pinned by commit like any other external cell, an origin naming a checkout on
    this machine included: `tine cell override` is what makes one follow a checkout as it moves.
    """
    cell = [f"git_origin = {origin}", f"commit_hash = {commit}"]
    ignore = "ignore = " + ", \\\n    ".join(IGNORED)
    detector = (
        "target_platform_detector_spec = target:root//...->prelude//platforms:default"
        " target:tine//...->prelude//platforms:default"
    )
    pins = [f"buck2-repository = {BUCK2_REPOSITORY}", f"buck2-release = {release}"]
    for platform in sorted(BUCK2_ARTIFACTS):
        pins += [
            f"buck2-{platform}-artifact = {BUCK2_ARTIFACTS[platform]}",
            f"buck2-{platform}-sha256 = {digests[platform]}",
        ]
    buckconfig = f"""[cells]
root = .
tine = tine
toolchains = toolchains
prelude = prelude
none = none

[cell_aliases]
config = prelude
# The tine cell's own aliases are honoured even as an external cell, and it aliases fbsource to
# satisfy the bundled prelude, so `none` has to resolve here too.
fbsource = none

[external_cells]
prelude = bundled
tine = git

[external_cell_tine]
{chr(10).join(cell)}

[parser]
{detector}

[project]
{ignore}

[build]
execution_platforms = prelude//platforms:default

# The Buck2 `tine` fetches and verifies before running anything; `tine bump` rewrites these.
[tine]
{chr(10).join(pins)}
"""
    # `.buckconfig` last: it is what a second run refuses to overwrite, so nothing that can fail
    # should come after it.
    return {"toolchains/BUCK": TOOLCHAINS, ".gitignore": GITIGNORE, ".buckconfig": buckconfig}


def exclude(directory: Path, entries: str) -> None:
    """Keep what a build leaves behind out of git's way where `.gitignore` is not ours to write.

    `.git/info/exclude` is the checkout's own and is committed nowhere, so a project that already
    has a `.gitignore` gets what that one would have said without this command editing a file the
    project owns. A directory git cannot answer for has nothing to be excluded from.
    """
    header = "# @generated by `tine init`; what a build leaves behind."
    try:
        common = _git("rev-parse", "--git-common-dir", directory=directory)
    except SystemExit:
        return
    # `--git-common-dir` answers relative to the directory it was asked in, except where it does not;
    # a worktree and a submodule both answer with the one directory this belongs in either way.
    path = directory / common / "info" / "exclude"
    lines = read_lines(path) if path.is_file() else []
    if not (missing := [entry for entry in entries.split("\n") if entry and entry not in lines]):
        return
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise fail(f"cannot create {path.parent}: {error}") from error
    write_if_changed(path, "\n".join([*lines, *([] if header in lines else [header]), *missing]) + "\n")
    print(f"tine: excluded {', '.join(missing)} in {path}", file=sys.stderr)


def init(directory: Path, arguments: list[str]) -> None:
    """Write the configuration a project needs to build against this cell.

    Buck2 has an `init` of its own; this shadows it, because what a project needs here is the tine
    cell, a toolchains cell pointed at the interpreter it pins, and a Buck2 to fetch.
    """
    import argparse

    parser = argparse.ArgumentParser(prog="tine init", description="write the configuration a project needs")
    parser.add_argument(
        "origin",
        nargs="?",
        default=TINE_ORIGIN,
        metavar="<origin>",
        help=f"the tine cell to build against (default: {TINE_ORIGIN})",
    )
    parser.add_argument(
        "--local",
        action="store_true",
        help="follow the checkout that origin names, as `tine cell override` does, rather than the"
        " commit it is on now",
    )
    args = parser.parse_args(arguments)
    if (directory / ".buckconfig").exists():
        raise fail(f"{directory / '.buckconfig'} already exists")

    # `ls-remote` reads a path on this machine as readily as a URL, so both kinds of origin are
    # pinned to the commit they are on now; `tine cell override` is what follows one afterwards.
    checkout = checkout_at(args.origin)
    if args.local and checkout is None:
        raise fail(f"--local needs an origin that is a checkout on this machine, and {args.origin} is not")
    origin = str(checkout or args.origin)
    if not round_trips(origin):
        raise fail(f"{origin!r} cannot be written to .buckconfig as it stands")
    remote = _git("ls-remote", "--end-of-options", origin, "HEAD", directory=directory)
    commit = remote.split()[0] if remote else ""
    if not is_hex(commit, 40, 64):
        raise fail(f"{origin} reports no HEAD to pin the tine cell to")

    tag, assets = _release(BUCK2_REPOSITORY)
    digests = {
        platform: _digest(assets, artifact, BUCK2_REPOSITORY, tag)
        for platform, artifact in BUCK2_ARTIFACTS.items()
    }

    for name, content in _skeleton(origin, commit, tag, digests).items():
        path = directory / name
        if path.exists():
            print(f"tine: {name} exists, left alone", file=sys.stderr)
            if name == ".gitignore":
                exclude(directory, content)
            continue
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
        except OSError as error:
            raise fail(f"cannot create {path.parent}: {error}") from error
        write_if_changed(path, content)
        print(f"tine: wrote {name}", file=sys.stderr)

    if checkout is not None and args.local:
        # The whole verb, so that a declaration made here is the one every other command reads, and
        # is refused here for the same reasons.
        cell(directory, ["override", CELL, str(checkout)])


def cells_of(config: dict[str, dict[str, str]]) -> dict[str, str]:
    """The cells a project declares. Buck2 reads either spelling and keeps the older one working."""
    return config.get("cells") or config.get("repositories", {})


def _cell_name(config: dict[str, dict[str, str]], cell: str) -> str:
    """The cell an argument names, spelled the way the sections that configure it are.

    An alias is resolved here rather than written through: `[external_cells]` takes either, but
    `[external_cell_<cell>]` only ever names the cell itself.
    """
    cells = cells_of(config)
    aliases = config.get("cell_aliases") or config.get("repository_aliases", {})
    name = aliases.get(cell, cell)
    if name not in cells:
        raise fail(f"no cell named {cell}; this project has {', '.join(sorted(cells)) or 'none'}")
    if Path(cells[name]) == Path("."):
        raise fail(f"cell {name} is this project, and cannot be built from somewhere else")
    return name


def cell(root: Path, arguments: list[str]) -> None:
    """Declare which cells are built from a checkout on this machine, or stop building one from it.

    An override is per-checkout and never committed: it names a path only this machine has.
    """
    handover(root, ["cell", *arguments])

    import argparse

    parser = argparse.ArgumentParser(prog="tine cell", description="build a cell from a local checkout")
    verbs = parser.add_subparsers(dest="verb", metavar="<verb>", required=True)
    override = verbs.add_parser("override", help="build a cell from a checkout on this machine")
    override.add_argument("cell", help="the cell to override")
    override.add_argument("path", help="a git checkout of it")
    override.add_argument(
        "--commit",
        metavar="<rev>",
        help="a revision of that checkout to stay on; without it, the build follows its HEAD",
    )
    revert = verbs.add_parser("revert", help="build a cell from what the project pins again")
    revert.add_argument("cell", help="the cell to stop overriding")
    verbs.add_parser("list", help="print the overrides in effect")
    args = parser.parse_args(arguments)

    declared = declared_cells(root)
    if args.verb == "list":
        for name, (origin, commit) in sorted(declared.items()):
            print(f"{name} {origin} {commit or 'HEAD'}")
        if not declared:
            print("tine: no cell is overridden", file=sys.stderr)
        return

    config = project_config(root)
    if args.verb == "revert":
        # What is declared, before what the project declares: a cell dropped from `.buckconfig`
        # while it was overridden still has an override to take back.
        name = args.cell if args.cell in declared else _cell_name(config, args.cell)
        if declared.pop(name, None) is None:
            raise fail(f"cell {name} is not overridden")
        message = f"cell {name} is back to what the project pins"
    else:
        name = _cell_name(config, args.cell)
        checkout = checkout_at(args.path)
        if checkout is None:
            raise fail(f"{args.path} is not a git repository")
        # Resolved here, and not only where the block is generated, so that a checkout that cannot
        # answer stops the declaration rather than outliving it.
        try:
            resolved = commit_of(checkout, args.commit)
        except SystemExit as error:
            missing = f"revision {args.commit}" if args.commit else "commit to follow"
            reason = str(error).removeprefix("tine: ")
            raise fail(f"{checkout} has no {missing}: {reason}") from None
        commit = resolved if args.commit else None
        # Read again, rather than reusing what was read before the git call above: another command
        # writing that file in the window between would otherwise be undone by this one.
        declared = declared_cells(root) | {name: (str(checkout), commit)}
        message = f"cell {name} is {checkout} at {commit or 'HEAD'}"
    # The declaration is the block, so writing it is what records it, and a declaration that cannot
    # be honoured is reported by the command that made it rather than by the next one.
    refresh(root, config, declared)
    print(f"tine: {message}", file=sys.stderr)


def buck_subcommand(argv: list[str]) -> "str | None":
    rest = argv
    while rest:
        if rest[0] == "--":
            return None
        if rest[0] in VALUE_FLAGS:
            rest = rest[2:]
        elif rest[0].startswith("-"):
            rest = rest[1:]
        else:
            return rest[0]
    return None


def handover(root: Path, argv: list[str]) -> None:
    """Run the command of an overridden tine cell in place of this one, where there is one.

    A project vendors a copy of this file, and an overridden cell moves on without it: that would
    pair a command with rules it was never written against. The checkout's own command is where this
    stops, since it finds the same declaration and is already it.

    The working copy's file, not the revision an override pins: what runs the build is what the
    developer is editing, and a pinned revision is about what Buck fetches.
    """
    declared = declared_cells(root).get(CELL)
    if declared is None:
        return
    checkout = local_checkout(declared[0])
    if checkout is None:
        # Reported where the block is generated, which says how to take the declaration back.
        return
    command = checkout / COMMAND
    try:
        if not command.is_file() or command.samefile(__file__):
            return
    except OSError:
        return
    try:
        os.execv(str(command), [str(command), *argv])
    except OSError as error:
        raise fail(f"cannot run {command}: {error}") from error


def buck(argv: list[str]) -> None:
    root = project_root(cwd())
    handover(root, ["buck", *argv])
    config = project_config(root)

    # A keypress in a completing shell must not turn into a download; it completes nothing until
    # some other command has fetched the binary.
    name = buck_subcommand(argv)
    binary = buck2(config, fetch=name != "complete")
    if binary is None:
        return
    # That keypress runs `complete`, which reads the configuration and must not race a build that is
    # writing it.
    if name != "complete":
        refresh(root, config)
    # BUCK2_BINARY so that a tool Buck runs can nest a Buck2 command without going through this
    # command again: another refresh mid-build would invalidate the configuration under it.
    environment = {"BUCK2_ARG0": "tine buck", "BUCK2_BINARY": str(binary)}
    try:
        os.execve(binary, [str(binary), *argv], os.environ | environment)
    except OSError as error:
        raise fail(f"cannot run {binary}: {error}") from error


USAGE = "usage: tine <command> [arguments]\n\n" + "".join(
    f"    {verb:<12}{description}\n" for verb, description in VERBS.items()
)


def main(argv: list[str]) -> None:
    """Dispatch on the first word, which `tine buck` needs and argparse would get in the way of.

    Everything after `buck` is Buck2's, including words that look like this command's options. A verb
    with arguments of its own parses them with argparse, imported where it is used.
    """
    # Python turns a closed stdout into an exception; a command whose output is piped into `head`
    # should end the way every other one does.
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    name, rest = (argv[0], argv[1:]) if argv else (None, [])

    if name == "buck":
        buck(rest)
    elif name == "cell":
        cell(project_root(cwd()), rest)
    elif name == "init":
        # Before the project root is resolved, because writing one is what this is for.
        init(cwd(), rest)
    elif name == "bump":
        if rest:
            raise fail("bump takes no arguments")
        root = project_root(cwd())
        handover(root, argv)
        bump(root / ".buckconfig")
    elif name == "completion":
        # Passing an unknown shell through would print Buck2's own script, which names buck2
        # throughout and would complete against whatever buck2 the shell finds.
        if len(rest) != 1 or rest[0] not in SHELLS:
            raise fail(f"completion takes one of {', '.join(SHELLS)}")
        try:
            root = project_root(cwd())
        except SystemExit as error:
            reason = str(error).removeprefix("tine: ")
            raise fail(f"{reason}; the script comes out of the Buck2 a project pins") from None
        handover(root, argv)
        binary = buck2(project_config(root))
        assert binary is not None
        print(completion(_buck2_completion(binary, rest[0]), rest[0]), end="")
    elif name in ("-h", "--help", "help", None):
        print(USAGE, end="")
    else:
        raise fail(f"no such command: {name}\n{USAGE}")


if __name__ == "__main__":
    main(sys.argv[1:])
