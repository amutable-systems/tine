"""Go source builds: one online, go.sum-verified module fetch, then an offline compile."""

# Runs inside the engine with the network: go.mod and go.sum in, the verified module cache out.
python_bootstrap_binary(
    name = "fetch",
    main = "fetch.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs"],
)

# Runs inside the engine offline: the source tree and its module cache in, the declared binaries out.
python_bootstrap_binary(
    name = "build",
    main = "build.py",
    visibility = ["PUBLIC"],
    deps = [
        "//:specs",
        "//:util",
    ],
)

# Driver source for the unit-test tree (tine//tests:unit-test).
export_file(
    name = "build-src",
    src = "build.py",
    visibility = ["tine//tests:unit-test"],
)
