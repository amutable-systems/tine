"""Go source builds: one online, go.sum-verified module fetch, then an offline compile."""

load("//engine:test.bzl", "engine_unittest")

# The project's source artifacts in, the module root its go.mod marks out.
python_bootstrap_binary(
    name = "workspace",
    main = "workspace.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs"],
)

# Runs inside the engine with the network: go.mod and go.sum in, the verified module cache out.
python_bootstrap_binary(
    name = "fetch",
    main = "fetch.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs"],
)

# Runs inside the engine offline: the source tree and its module cache in, the declared binaries out.
python_bootstrap_binary(
    name = "build",
    main = "build.py",
    visibility = ["PUBLIC"],
    deps = [
        "//:specs",
        "//:util",
    ],
)

engine_unittest(
    name = "test",
    engine = "//box:dev.engine",
    srcs = [
        "build.py",
        "build_test.py",
        "workspace.py",
        "workspace_test.py",
    ],
    deps = [
        "//:specs",
        "//:util",
    ],
)
