"""Go source builds: one online, go.sum-verified module fetch, then an offline compile."""

load("//box:test.bzl", "box_python_test")
load("//python:defs.bzl", "tine_python_binary")

# The project's source artifacts in, the module root its go.mod marks out.
tine_python_binary(
    name = "workspace",
    main = "workspace.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs", "//:util"],
)

# Runs inside the box with the network: go.mod and go.sum in, the verified module cache out.
tine_python_binary(
    name = "fetch",
    main = "fetch.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs", "//:util"],
)

# Runs inside the box offline: the source tree and its module cache in, the declared binaries out.
tine_python_binary(
    name = "build",
    main = "build.py",
    visibility = ["PUBLIC"],
    deps = [
        "//:specs",
        "//:util",
        "//box:isolation",
    ],
)

box_python_test(
    name = "test",
    box = "//tools:dev.box",
    srcs = [
        "build.py",
        "build_test.py",
        "workspace.py",
        "workspace_test.py",
    ],
    deps = [
        "//:specs",
        "//:util",
        "//box:isolation",
    ],
)
