"""Go source builds: one online, go.sum-verified module fetch, then an offline compile."""

load("//box:test.bzl", "box_python_test")
load("//python:defs.bzl", "tine_python_binary")

# The project's source artifacts in; the module root, its pins and the go.mod files the fetch reads out.
tine_python_binary(
    name = "workspace",
    main = "workspace.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs", "//:util"],
)

# Runs inside the box with the network: go.mod and go.sum files in, the verified module cache out.
tine_python_binary(
    name = "fetch",
    main = "fetch.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs", "//:util"],
)

# Runs inside the box offline: the source tree and its module cache in, the declared binaries out.
tine_python_binary(
    name = "build",
    main = "build.py",
    visibility = ["PUBLIC"],
    deps = [
        "//:specs",
        "//:util",
        "//rootfs:rootfs",
    ],
)

# Runs inside the box offline. It runs each test binary that the build compiled in the binary's package directory.
tine_python_binary(
    name = "runner",
    main = "runner.py",
    visibility = ["PUBLIC"],
    deps = [
        "//:specs",
        "//rootfs:rootfs",
    ],
)

box_python_test(
    name = "test",
    box = "//tools:dev.box",
    srcs = [
        "build.py",
        "build_test.py",
        "fetch.py",
        "fetch_test.py",
        "runner.py",
        "runner_test.py",
        "workspace.py",
        "workspace_test.py",
    ],
    deps = [
        "//:specs",
        "//:util",
        "//rootfs:rootfs",
    ],
)
