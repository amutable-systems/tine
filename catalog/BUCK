"""Default repositories, OS releases, boxes, package managers, and build profiles."""

# Generated data lives under `snapshot/{repo,box}/`, without target-type suffixes in filenames. Boxes
# with a resolver can derive their transaction during the build; refresh the catalog to freeze one as a
# retained lock.
load("//box:defs.bzl", "box")
load("//distribution:arch.bzl", "arch_release")
load("//distribution:fedora.bzl", "fedora_release")

# Pinned rpmrepo compose snapshot: packages never vanish underneath committed pins.
# refresh-catalog enumerates the mirror and advances the snapshot pin to the newest compose.
fedora_release(
    name = "fedora.rawhide",
    version = "rawhide",
    box = ":fedora.rawhide.box",
    rpmrepo_mirror = "https://rpmrepo-gateway.amutable.workers.dev/v2/mirror/public/f46",
    rpmrepo_snapshot = "f46-x86_64-rawhide-20260907",
    visibility = ["PUBLIC"],
)

# Shared RPM box plus the image assembly and VM tools. These tools stay out of images.
box.new(
    name = "fedora.rawhide.box",
    packages = [
        "rpm",
        "python3",
        "python3-libdnf5",
        "python3-createrepo_c",
        "coreutils",
        "libseccomp",
        "ca-certificates",
        # the uki driver resolves module dependencies through libkmod
        "kmod-libs",
        "systemd-udev",
        "systemd-ukify",
        # ukify needs these to sign UKIs and parse PEs, but they are only weak dependencies
        "python3-cryptography",
        "python3-pefile",
        # remote signing with hardware keys
        "pkcs11-provider",
        "p11-kit-client",
        "e2fsprogs",
        "erofs-utils",
        "veritysetup",
        "dosfstools",
        "mtools",
        "systemd-container",
        "qemu-system-x86-core",
        "qemu-img",
        "zstd",
        "edk2-ovmf",
        "virtiofsd",
        # software TPM so systemd-vmspawn can offer the guest a vTPM for measured boot;
        # swtpm-tools provides swtpm_setup, which vmspawn runs to initialize the TPM state
        "swtpm",
        "swtpm-tools",
        "openssh",
    ],
    release = ":fedora.rawhide.release",
    root = True,
    visibility = ["PUBLIC"],
)

# Arch has no numbered releases, so the catalog pins a day in the Arch Linux Archive: its dated
# trees serve databases that never change under a committed pin, which a rolling mirror cannot.
# refresh-catalog advances every repository sharing this pin to the newest complete day.
arch_release(
    name = "arch.rolling",
    archive_snapshot = "2026/09/06",
    box = ":arch.rolling.box",
    visibility = ["PUBLIC"],
)

# The alpm box. It is a root box: extracting alpm packages needs no package tooling, so it
# bootstraps its own pacman rather than borrowing another box's. It carries the image assembly
# tools every rule resolves through an image's own manager, under Arch's names for them. The VM
# stack stays out: `image_vm` takes its box explicitly, so a second qemu/OVMF/swtpm userspace
# would be built for nothing.
box.new(
    name = "arch.rolling.box",
    packages = [
        "pacman",
        "python",
        "bash",
        "coreutils",
        "libseccomp",
        "ca-certificates",
        # the uki driver resolves module dependencies through libkmod
        "kmod",
        # udev, repart, tmpfiles, sysusers and bootctl all ship here
        "systemd",
        "systemd-ukify",
        # ukify needs these to sign UKIs and parse PEs, but they are only optional dependencies
        "python-cryptography",
        "python-pefile",
        "e2fsprogs",
        "erofs-utils",
        # veritysetup
        "cryptsetup",
        "dosfstools",
        "mtools",
        "zstd",
    ],
    release = ":arch.rolling.release",
    root = True,
    visibility = ["PUBLIC"],
)
