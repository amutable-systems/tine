"""Default repositories, OS releases, engines, package managers, and build profiles."""

# Generated data lives under `snapshot/{repo,engine}/`, without target-type suffixes in filenames. Engines
# with a resolver can derive their transaction during the build; refresh the catalog to freeze one as a
# retained lock.
load("//engine:build.bzl", "engine")
load("//package_system/rpm:catalog.bzl", "centos_stream_release", "fedora_release")

fedora_release(
    name = "fedora.44",
    version = "44",
    engine = ":fedora.rawhide.engine",
    visibility = ["PUBLIC"],
)

# Pinned rpmrepo compose snapshot: packages never vanish underneath committed pins.
# refresh-catalog enumerates the mirror and advances the snapshot pin to the newest compose.
fedora_release(
    name = "fedora.rawhide",
    version = "rawhide",
    engine = ":fedora.rawhide.engine",
    rpmrepo_mirror = "https://rpmrepo-gateway.amutable.workers.dev/v2/mirror/public/f45",
    rpmrepo_snapshot = "f45-x86_64-rawhide-20260721",
    visibility = ["PUBLIC"],
)

centos_stream_release(
    name = "centos.10-stream",
    version = "10-stream",
    engine = ":fedora.rawhide.engine",
    visibility = ["PUBLIC"],
)

# Shared RPM engine plus the image assembly and VM tools. These tools stay out of images.
engine(
    name = "fedora.rawhide.engine",
    packages = [
        "rpm",
        "python3",
        "python3-libdnf5",
        "python3-createrepo_c",
        "coreutils",
        "libseccomp",
        "ca-certificates",
        "systemd-udev",
        "systemd-ukify",
        "python3-pefile",
        "e2fsprogs",
        "erofs-utils",
        "veritysetup",
        "dosfstools",
        "mtools",
        "systemd-container",
        "qemu-system-x86-core",
        "qemu-img",
        "zstd",
        "edk2-ovmf",
        "virtiofsd",
        # software TPM so systemd-vmspawn can offer the guest a vTPM for measured boot;
        # swtpm-tools provides swtpm_setup, which vmspawn runs to initialize the TPM state
        "swtpm",
        "swtpm-tools",
        "openssh",
    ],
    release = ":fedora.rawhide.release",
    visibility = ["PUBLIC"],
)
