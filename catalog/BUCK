"""The active catalog: repositories, OS releases, engines, package managers, and build profiles."""

# Repoint the `catalog` cell to replace these declarations. Repository snapshots are generated
# as `<name>.json`; engine transaction files must start as `{}`. Refresh after adding either.
load("@tine//engine:rules.bzl", "engine")
load("@tine//package:buildroot.bzl", "buildroot")
load("@tine//package:manager.bzl", "package_manager")
load("@tine//package:release.bzl", "os_release")
load("@tine//package:repository.bzl", "repository_universe")
load("@tine//package_system/rpm:rules.bzl", "rpm_remote_repository")

_RPM = "@tine//package_system/rpm:package_system"

# Frozen GA tree; live updates can drop packages referenced by old pins.
rpm_remote_repository(
    name = "fedora.44.repository",
    baseurl = "https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/os/",
)

# Rolling tree whose pinned URLs require frequent refreshes.
rpm_remote_repository(
    name = "fedora.rawhide.repository",
    baseurl = "https://dl.fedoraproject.org/pub/fedora/linux/development/rawhide/Everything/x86_64/os/",
)

# CentOS Stream pins also drift on refresh.
rpm_remote_repository(
    name = "centos.10-stream.baseos.repository",
    baseurl = "https://mirror.stream.centos.org/10-stream/BaseOS/x86_64/os/",
)

rpm_remote_repository(
    name = "centos.10-stream.appstream.repository",
    baseurl = "https://mirror.stream.centos.org/10-stream/AppStream/x86_64/os/",
)

rpm_remote_repository(
    name = "centos.10-stream.crb.repository",
    baseurl = "https://mirror.stream.centos.org/10-stream/CRB/x86_64/os/",
)

repository_universe(
    name = "fedora.44.repositories",
    package_system = _RPM,
    required_repositories = [":fedora.44.repository"],
)

repository_universe(
    name = "fedora.rawhide.repositories",
    package_system = _RPM,
    required_repositories = [":fedora.rawhide.repository"],
)

repository_universe(
    name = "centos.10-stream.repositories",
    package_system = _RPM,
    required_repositories = [":centos.10-stream.baseos.repository"],
    optional_repository_groups = {
        "appstream": [":centos.10-stream.appstream.repository"],
        "crb": [":centos.10-stream.crb.repository"],
    },
    default_repository_groups = ["appstream"],
)

os_release(
    name = "fedora.44.release",
    family = "fedora",
    version = "44",
    repository_universe = ":fedora.44.repositories",
)

os_release(
    name = "fedora.rawhide.release",
    family = "fedora",
    version = "rawhide",
    repository_universe = ":fedora.rawhide.repositories",
)

os_release(
    name = "centos.10-stream.release",
    family = "centos",
    version = "10-stream",
    repository_universe = ":centos.10-stream.repositories",
)

# Shared RPM engine plus the image assembly and VM tools. These tools stay out of images.
engine(
    name = "fedora.44.engine",
    packages = [
        "rpm",
        "python3",
        "python3-libdnf5",
        "python3-createrepo_c",
        "coreutils",
        "libseccomp",
        "ca-certificates",
        "systemd-udev",
        "systemd-ukify",
        "python3-pefile",
        "e2fsprogs",
        "dosfstools",
        "mtools",
        "systemd-container",
        "qemu-system-x86-core",
        "edk2-ovmf",
        "openssh",
    ],
    release = ":fedora.44.release",
    visibility = ["PUBLIC"],
)

package_manager(
    name = "fedora.44.package-manager",
    release = ":fedora.44.release",
    engine = ":fedora.44.engine",
    visibility = ["PUBLIC"],
)

# Rawhide and CentOS packages use their own repositories with the shared Fedora engine.
package_manager(
    name = "fedora.rawhide.package-manager",
    release = ":fedora.rawhide.release",
    engine = ":fedora.44.engine",
    visibility = ["PUBLIC"],
)

package_manager(
    name = "centos.10-stream.package-manager",
    release = ":centos.10-stream.release",
    engine = ":fedora.44.engine",
    enable_repository_groups = ["crb"],
    visibility = ["PUBLIC"],
)

buildroot(
    name = "fedora.44.buildroot",
    package_manager = ":fedora.44.package-manager",
    packages = ["@buildsys-build"],
    visibility = ["PUBLIC"],
)

buildroot(
    name = "fedora.rawhide.buildroot",
    package_manager = ":fedora.rawhide.package-manager",
    packages = ["@buildsys-build"],
    visibility = ["PUBLIC"],
)

# CentOS has no @buildsys-build group; this matches mock's chroot_setup_cmd.
