# buck output / state
/buck-out
**/buck-out

# bin/tine's own state, including its home directory if the environment does not set one
/.buck

# Local (non-committed) config overrides, one block of which bin/tine writes
/.buckconfig.local
/.buckconfig.local.*.tmp
.claude/settings.local.json

# Build output of a cargo build run by hand inside a checked-out Rust project
target/

# Python tooling caches (ruff/ty pinned in tools/)
.ruff_cache/
.ty_cache/
__pycache__/
*.pyc

# Editor / OS noise
*.swp
.DS_Store
