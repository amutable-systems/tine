# buck output / state
/buck-out
**/buck-out

# bin/tine's own state, including its home directory if the environment does not set one
/.buck

# Local (non-committed) config overrides, one block of which bin/tine writes
/.buckconfig.local
/.buckconfig.local.*.tmp
/.buckconfig.*.tmp
/.buckconfig.d/tine-mounts
/tine.local.toml
.claude/settings.local.json

# Build output of a cargo build run by hand inside a checked-out Rust project
target/

# Python tooling caches (ruff/ty pinned in tools/)
.ruff_cache/
.ty_cache/
__pycache__/
*.pyc

# Package editor routing is generated by tools/ty; the root settings bootstrap it.
**/.zed/settings.json
!/.zed/settings.json

# Editor / OS noise
*.swp
.DS_Store
