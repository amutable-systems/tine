# buck output / state
/buck-out
**/buck-out

# The home directory bin/tine falls back to where the environment sets none (CI)
/.buck

# Local (non-committed) config overrides, one block of which bin/tine writes
/.buckconfig.local
/.buckconfig.local.*.tmp
/.buckconfig.local.lock
.claude/settings.local.json

# Build output of a cargo build run by hand inside a checked-out Rust project
target/

# Python tooling caches (ruff/ty pinned in tools/)
.ruff_cache/
.ty_cache/
__pycache__/
*.pyc

# Editor / OS noise
*.swp
.DS_Store
