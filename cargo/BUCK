"""Rust source builds against a vendored, hash-pinned crate tree."""

# The downloaded crates in, the directory cargo builds against out.
python_bootstrap_binary(
    name = "vendor",
    main = "vendor.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs"],
)

# Driver and lock-reader sources for the unit-test tree (tine//tests:unit-test).
export_file(
    name = "lock-src",
    src = "lock.bzl",
    visibility = ["tine//tests:unit-test"],
)

export_file(
    name = "vendor-src",
    src = "vendor.py",
    visibility = ["tine//tests:unit-test"],
)
