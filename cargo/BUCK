"""Rust source builds against a vendored, hash-pinned crate tree."""

load("//box:defs.bzl", "box")
load("//box:test.bzl", "box_python_test")
load("//distribution:defs.bzl", "distribution")
load("//python:defs.bzl", "tine_python_binary")

# The box that cargo.package() builds in unless a project names its own. A package that links against
# a C library adds the library's development package with cargo.package(buildroot_packages = ...).
box.new(
    name = "build.box",
    packages = distribution.select({
        # The rust package contains cargo.
        "arch": [
            "gcc",
            "pkgconf",
            "rust",
        ],
        "debian": [
            "cargo",
            "gcc",
            # gcc only recommends the C library headers, and the install skips recommended packages.
            "libc6-dev",
            "pkgconf",
            "rustc",
        ],
        "fedora": [
            "cargo",
            "gcc",
            "pkgconf",
            "rust",
        ],
    }),
    release = distribution.release_target("release"),
    visibility = ["PUBLIC"],
)

# The project's source artifacts in, its workspace root and resolved lock out.
tine_python_binary(
    name = "lock",
    main = "lock.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs", "//:util"],
)

# The downloaded crates in, the directory cargo builds against out.
tine_python_binary(
    name = "vendor",
    main = "vendor.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs"],
)

# Runs inside the box: the source tree and its vendored crates in, the declared binaries out.
tine_python_binary(
    name = "build",
    main = "build.py",
    visibility = ["PUBLIC"],
    deps = [
        "//:specs",
        "//:util",
        "//box:isolation",
        "//rootfs:rootfs",
    ],
)

box_python_test(
    name = "test",
    box = "//tools:dev.box",
    srcs = [
        "build.py",
        "build_test.py",
        "cargo_test.py",
        "lock.py",
        "vendor.py",
    ],
    deps = ["//:specs", "//:util", "//box:isolation", "//rootfs:rootfs"],
)
