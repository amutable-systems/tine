"""Rust source builds against a vendored, hash-pinned crate tree."""

load("//engine:test.bzl", "engine_python_test")

# The project's source artifacts in, its workspace root and resolved lock out.
python_bootstrap_binary(
    name = "lock",
    main = "lock.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs"],
)

# The downloaded crates in, the directory cargo builds against out.
python_bootstrap_binary(
    name = "vendor",
    main = "vendor.py",
    visibility = ["PUBLIC"],
    deps = ["//:specs"],
)

# Runs inside the engine: the source tree and its vendored crates in, the declared binaries out.
python_bootstrap_binary(
    name = "build",
    main = "build.py",
    visibility = ["PUBLIC"],
    deps = [
        "//:specs",
        "//:util",
    ],
)

engine_python_test(
    name = "test",
    engine = "//box:dev.engine",
    srcs = [
        "build.py",
        "cargo_test.py",
        "lock.bzl",
        "lock.py",
        "vendor.py",
    ],
    deps = [
        "//:specs",
        "//:util",
    ],
)
