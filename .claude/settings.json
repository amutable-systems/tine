{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$CLAUDE_PROJECT_DIR/tine/tools\"; [ -d \"$d\" ] || d=\"$CLAUDE_PROJECT_DIR/tools\"; printf 'export PATH=\"%s:$PATH\"\\n' \"$d\" > \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  }
}
